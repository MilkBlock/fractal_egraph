(datatype E (N i64) (Pair E E))
(function Cost (E) i64 :merge (min old new))
(relation Small (E)) (relation Seen (E))
(ruleset compute) (ruleset consume) (ruleset lower)
(rule ((= r (Pair x y)) (= a (Cost x)) (= b (Cost y)))
      ((set (Cost r) (+ 1 (+ a b)))) :ruleset compute)
(rule ((= r (Pair x y)) (= a (Cost x)) (= b (Cost y)) (< a b))
      ((Small r)) :ruleset consume)
(rule ((Small r)) ((Seen r)) :ruleset consume)
(rule ((= x (N 0))) ((set (Cost x) 1)) :ruleset lower)
(Pair (N 0) (N 1)) (Pair (N 1) (N 0))
(set (Cost (N 0)) 4) (set (Cost (N 1)) 3)
(run compute 1) (run consume 1) (run lower 1)
(run-schedule (saturate (run compute) (run consume)))
(check (Small (Pair (N 0) (N 1))))
