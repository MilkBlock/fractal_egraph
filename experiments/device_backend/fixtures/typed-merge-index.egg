(datatype Key (K i64))
(datatype Val (V i64) (Choose Val Val) (Wrap Val))
(function Best (Key) Val :merge (Choose old new))
(relation Join (Key Key))
(ruleset keys) (ruleset values) (ruleset later)
(rule ((Join x y)) ((union x y)) :ruleset keys)
(rule ((= x (V 1)) (= y (V 2))) ((union x y)) :ruleset values)
(rule ((= x (K 0))) ((set (Best x) (Wrap (V 2)))) :ruleset later)
(set (Best (K 0)) (V 0))
(set (Best (K 1)) (V 1))
(set (Best (K 2)) (V 2))
(set (Best (K 3)) (V 3))
(Join (K 0) (K 1)) (Join (K 1) (K 2)) (Join (K 2) (K 3))
(Wrap (V 1)) (Wrap (V 2))
(run keys 1) (run values 1) (run later 1)
(check (= (Wrap (V 1)) (Wrap (V 2))))
