; The generated SK program is the oracle. Literal order is structural, not numeric.
(datatype Expr (N i64) (Pair Expr Expr))
(function Expr-size (Expr) i64 :merge (max old new))
(function to-hoist (Expr Expr) Expr :merge new)
(relation Candidate (Expr))
(ruleset pick)
(ruleset ordinary)
(rule ((Candidate e)) ((set (to-hoist (N 0) (N 0)) e)) :ruleset pick)
(N 0) (N 2) (N 10)
(Candidate (N 2)) (Candidate (N 10))
(set (Expr-size (N 2)) 1) (set (Expr-size (N 10)) 1)
(run ordinary 1)
(run pick 1)
(check (= (to-hoist (N 0) (N 0)) (N 10)))
(Pair (N 2) (N 10)) (Pair (N 10) (N 2))
(Candidate (Pair (N 2) (N 10))) (Candidate (Pair (N 10) (N 2)))
(set (Expr-size (Pair (N 2) (N 10))) 3)
(set (Expr-size (Pair (N 10) (N 2))) 3)
(run pick 1)
(check (= (to-hoist (N 0) (N 0)) (Pair (N 10) (N 2))))
(union (N 2) (Pair (N 2) (N 2)))
(run pick 1)
