(datatype Expr (Num i64) (External i64) (Add Expr Expr) (Triple Expr Expr Expr))
(datatype Term (TermNum i64) (TermAdd Term Term) (TermTriple Term Term Term) (NoTerm))
(datatype TermAndCost (TCPair Term i64) (Smaller TermAndCost TermAndCost) (Hole i64))
(relation PotentialExtractedExpr (Expr TermAndCost))
(function ExtractedExpr (Expr) TermAndCost :merge (Smaller old new))
(ruleset terms) (ruleset terms-helpers) (ruleset terms-helpers-helpers)
(rule ((= e (Num n))) ((PotentialExtractedExpr e (TCPair (TermNum n) 1))) :ruleset terms)
(rule ((= e (Add x y)) (= (TCPair tx cx) (ExtractedExpr x)) (= (TCPair ty cy) (ExtractedExpr y))) ((PotentialExtractedExpr e (TCPair (TermAdd tx ty) (+ 1 (+ cx cy))))) :ruleset terms)
(rule ((= e (Triple x y z)) (= (TCPair tx cx) (ExtractedExpr x)) (= (TCPair ty cy) (ExtractedExpr y)) (= (TCPair tz cz) (ExtractedExpr z))) ((PotentialExtractedExpr e (TCPair (TermTriple tx ty tz) (+ (+ 1 cx) (+ cy cz))))) :ruleset terms)
(rule ((PotentialExtractedExpr e c)) ((set (ExtractedExpr e) (TCPair (NoTerm) 10000000000000000))) :ruleset terms-helpers)
(rule ((PotentialExtractedExpr e (TCPair t c)) (= (TCPair old oc) (ExtractedExpr e)) (< c oc)) ((set (ExtractedExpr e) (TCPair t c))) :ruleset terms-helpers)
(rule ((PotentialExtractedExpr e (TCPair t c)) (< c 0)) ((panic "negative")) :ruleset terms-helpers)
(rule ((= lhs (Smaller (TCPair t1 c1) (TCPair t2 c2))) (< c1 c2)) ((union lhs (TCPair t1 c1))) :ruleset terms-helpers-helpers)
(rule ((= lhs (Smaller (TCPair t1 c1) (TCPair t2 c2))) (> c1 c2)) ((union lhs (TCPair t2 c2))) :ruleset terms-helpers-helpers)
(rule ((= lhs (Smaller (TCPair t1 c) (TCPair t2 c)))) ((union lhs (TCPair t1 c))) :ruleset terms-helpers-helpers)
