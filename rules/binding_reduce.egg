; A pure, multi-output binding DAG. Effects are represented, never executed.
; Parameters are local to a DAG; environments substitute them without unioning them.
(datatype BindingValues (BNil) (BCons EndpointExpr BindingValues))
(constructor EParam (i64) EndpointExpr)
(constructor ERecur (String i64 BindingValues) EndpointExpr)
(constructor EApply (String BindingValues) EndpointExpr)
(datatype*
 (BindingExpr
 (BParam i64) (BInt i64) (BText String)
 (BAdd BindingExpr BindingExpr) (BSub BindingExpr BindingExpr)
 (BMul BindingExpr BindingExpr) (BDiv BindingExpr BindingExpr)
 (BPow BindingExpr BindingExpr)
 (BIAdd BindingExpr BindingExpr) (BISub BindingExpr BindingExpr) (BIMul BindingExpr BindingExpr)
 (BRow String BindingExprs) (BColumn i64 BindingExpr)
 (BApply String BindingExprs) (BRecur String i64 BindingExprs))
(BindingExprs (BXNil) (BXCons BindingExpr BindingExprs)))
(datatype BindingDag (BDag BindingExprs BindingExprs BindingExprs) (BLet BindingExpr BindingDag))
(sort BindingResult)
(constructor BResult (BindingValues BindingValues BindingValues) BindingResult :cost 1)
(constructor ReduceDag (BindingDag BindingValues) BindingResult :cost 100)
(constructor Substitute (BindingExpr BindingValues) EndpointExpr :cost 100)
(constructor SubstituteValues (BindingExprs BindingValues) BindingValues :cost 100)
(constructor ParameterAt (i64 BindingValues) EndpointExpr :cost 100)
(rewrite (ParameterAt 0 (BCons x xs)) x :ruleset endpoint-reduce)
(rewrite (ParameterAt i (BCons x xs)) (ParameterAt (- i 1) xs)
 :when ((> i 0)) :ruleset endpoint-reduce)
(rewrite (ReduceDag (BDag outputs requirements effects) env)
 (BResult (SubstituteValues outputs env) (SubstituteValues requirements env) (SubstituteValues effects env))
 :ruleset endpoint-reduce)
(rewrite (SubstituteValues (BXNil) env) (BNil) :ruleset endpoint-reduce)
(rewrite (SubstituteValues (BXCons x xs) env)
 (BCons (Substitute x env) (SubstituteValues xs env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BParam i) env) (ParameterAt i env) :ruleset endpoint-reduce)
(rewrite (Substitute (BInt n) env) (EInt n) :ruleset endpoint-reduce)
(rewrite (Substitute (BApply f xs) env) (EApply f (SubstituteValues xs env)) :ruleset endpoint-reduce)
; A recursion boundary stays symbolic. No unobserved recursive calls are minted.
(rewrite (Substitute (BRecur callee port xs) env) (ERecur callee port (SubstituteValues xs env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BAdd a b) env) (EAdd (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BSub a b) env) (ESub (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BMul a b) env) (EMul (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BDiv a b) env) (EDiv (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BPow a b) env) (EPow (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)

; Extend a persistent environment: repeated uses refer to one computed value.
(rewrite (ReduceDag (BLet value rest) env)
 (ReduceDag rest (BCons (Substitute value env) env)) :ruleset endpoint-reduce)

(constructor EText (String) EndpointExpr)
(constructor EIAdd (EndpointExpr EndpointExpr) EndpointExpr)
(constructor EISub (EndpointExpr EndpointExpr) EndpointExpr)
(constructor EIMul (EndpointExpr EndpointExpr) EndpointExpr)
(rewrite (Substitute (BText s) env) (EText s) :ruleset endpoint-reduce)
(rewrite (Substitute (BIAdd a b) env) (EIAdd (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BISub a b) env) (EISub (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BIMul a b) env) (EIMul (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
; Integer-safe neutral/absorbing laws, no unbounded integer polynomial assumption.
(rewrite (EIAdd x (EInt 0)) x :ruleset endpoint-reduce)
(rewrite (EIAdd (EInt 0) x) x :ruleset endpoint-reduce)
(rewrite (EISub x (EInt 0)) x :ruleset endpoint-reduce)
(rewrite (EIMul x (EInt 1)) x :ruleset endpoint-reduce)
(rewrite (EIMul (EInt 1) x) x :ruleset endpoint-reduce)
(rewrite (EIMul x (EInt 0)) (EInt 0) :ruleset endpoint-reduce)
(rewrite (EIMul (EInt 0) x) (EInt 0) :ruleset endpoint-reduce)
; Completion means a fully substituted representative exists, not merely a wrapper.
(relation CompleteExpr (EndpointExpr))
(relation CompleteValues (BindingValues))
(relation CompleteBinding (BindingResult))
(rule ((= v (BNil))) ((CompleteValues v)) :ruleset endpoint-reduce)
(rule ((= v (BCons x xs)) (CompleteExpr x) (CompleteValues xs)) ((CompleteValues v)) :ruleset endpoint-reduce)
(rule ((= r (BResult outs reqs effects)) (CompleteValues outs) (CompleteValues reqs) (CompleteValues effects)) ((CompleteBinding r)) :ruleset endpoint-reduce)
(rule ((= e (EParam i))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EInt i))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EText s))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ESymbol s))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ECount s))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EAdd a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ESub a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EMul a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EDiv a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EPow a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EIAdd a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EISub a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EIMul a b)) (CompleteExpr a) (CompleteExpr b)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EApply op args)) (CompleteValues args)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ERecur callee port args)) (CompleteValues args)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ECall op arg)) (CompleteExpr arg)) ((CompleteExpr e)) :ruleset endpoint-reduce)

(constructor ERow (String BindingValues) EndpointExpr)
(constructor EColumn (i64 EndpointExpr) EndpointExpr)
(rewrite (Substitute (BRow table xs) env) (ERow table (SubstituteValues xs env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BColumn i row) env) (EColumn i (Substitute row env)) :ruleset endpoint-reduce)
(rewrite (EColumn i (ERow table xs)) (ParameterAt i xs) :when ((>= i 0)) :ruleset endpoint-reduce)
(rule ((= e (ERow table xs)) (CompleteValues xs)) ((CompleteExpr e)) :ruleset endpoint-reduce)
; A projection from a symbolic boundary row is a valid symbolic value.
(rule ((= e (EColumn i (EParam p))) (>= i 0)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EColumn i (ERecur c p xs))) (>= i 0) (CompleteValues xs)) ((CompleteExpr e)) :ruleset endpoint-reduce)
