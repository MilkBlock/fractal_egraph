(datatype Term (Leaf String) (A Term) (AA Term) (B Term) (BB Term) (C Term) (CC Term) (Joined Term) (Final Term))
(ruleset demo)
(rewrite (A x) (AA x) :ruleset demo)
(rewrite (B x) (BB x) :ruleset demo)
(rewrite (C x) (CC x) :ruleset demo)
(rule ((AA x)
       (BB x))
      ((Joined x))
        :ruleset demo )
(rule ((Joined x)
       (CC x))
      ((Final x))
        :ruleset demo )
(constructor RipenInput (i64) Term)
(ruleset Spine-Run)
(ruleset Spine-Export)
(sort Spine-Term)
(constructor Spine-A (Spine-Term) Spine-Term)
(constructor Spine-AA (Spine-Term) Spine-Term)
(constructor Spine-B (Spine-Term) Spine-Term)
(constructor Spine-BB (Spine-Term) Spine-Term)
(constructor Spine-C (Spine-Term) Spine-Term)
(constructor Spine-CC (Spine-Term) Spine-Term)
(constructor Spine-Final (Spine-Term) Spine-Term)
(constructor Spine-Joined (Spine-Term) Spine-Term)
(constructor Spine-Leaf (String) Spine-Term)
(constructor Spine-RipenInput (i64) Spine-Term)
(function Spine-Reified-Term (Spine-Term) Term :merge old)
(rule ((= s (Spine-A x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (A y0))) :ruleset Spine-Export)
(rule ((= s (Spine-A x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (A y0))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (AA y0))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (AA y0))) :ruleset Spine-Export)
(rule ((= s (Spine-B x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (B y0))) :ruleset Spine-Export)
(rule ((= s (Spine-B x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (B y0))) :ruleset Spine-Export)
(rule ((= s (Spine-BB x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (BB y0))) :ruleset Spine-Export)
(rule ((= s (Spine-BB x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (BB y0))) :ruleset Spine-Export)
(rule ((= s (Spine-C x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (C y0))) :ruleset Spine-Export)
(rule ((= s (Spine-C x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (C y0))) :ruleset Spine-Export)
(rule ((= s (Spine-CC x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (CC y0))) :ruleset Spine-Export)
(rule ((= s (Spine-CC x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (CC y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Final x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (Final y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Final x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (Final y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Joined x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (Joined y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Joined x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (Joined y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0))) ((set (Spine-Reified-Term s) (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0)) (= previous (Spine-Reified-Term s))) ((union previous (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0))) ((set (Spine-Reified-Term s) (RipenInput x0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0)) (= previous (Spine-Reified-Term s))) ((union previous (RipenInput x0))) :ruleset Spine-Export)
(relation Spine-Summary-0 (Spine-Term Spine-Term))
(relation Spine-Summary-1 (Spine-Term Spine-Term))
(relation Spine-Summary-2 (Spine-Term Spine-Term))
(relation Spine-Summary-4 (Spine-Term Spine-Term Spine-Term))
(relation Spine-Summary-3 (Spine-Term Spine-Term Spine-Term Spine-Term))
; exact Cell 0: observed path 0 -> selected path 0
(rule ((= match_0 (Spine-A p0))) ((Spine-A p0) (Spine-Summary-0 (Spine-A p0) p0)) :ruleset Spine-Run :name "impl_0_0")
; exact Cell 1: observed path 1 -> selected path 1
(rule ((= match_0 (Spine-B p0))) ((Spine-B p0) (Spine-Summary-1 (Spine-B p0) p0)) :ruleset Spine-Run :name "impl_1_0")
; exact Cell 2: observed path 2 -> selected path 2
(rule ((= match_0 (Spine-C p0))) ((Spine-C p0) (Spine-Summary-2 (Spine-C p0) p0)) :ruleset Spine-Run :name "impl_2_0")
; exact Cell 4: observed path 3 -> selected path 3
(rule ((Spine-Summary-0 parent_0_root_0 p0) (Spine-Summary-1 parent_1_root_0 p0)) ((Spine-Summary-4 parent_0_root_0 parent_1_root_0 p0)) :ruleset Spine-Run :name "impl_3_0")
; exact Cell 3: observed path 4 -> selected path 4
(rule ((Spine-Summary-2 parent_0_root_0 p0) (Spine-Summary-4 parent_1_root_0 parent_1_root_1 p0)) ((Spine-Summary-3 parent_1_root_0 parent_1_root_1 parent_0_root_0 p0)) :ruleset Spine-Run :name "impl_4_0")
(rule ((Spine-Summary-0 export_root_0 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1)) :ruleset Spine-Export)
(rule ((Spine-Summary-1 export_root_0 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (B export_input_0)) (union export_class_1 (BB export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1)) :ruleset Spine-Export)
(rule ((Spine-Summary-2 export_root_0 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (C export_input_0)) (union export_class_1 (CC export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1)) :ruleset Spine-Export)
(rule ((Spine-Summary-4 export_root_0 export_root_1 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (let export_class_2 (B export_input_0)) (union export_class_2 (BB export_input_0)) (let export_class_3 (Joined export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1) (set (Spine-Reified-Term export_root_1) export_class_2)) :ruleset Spine-Export)
(rule ((Spine-Summary-3 export_root_0 export_root_1 export_root_2 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (let export_class_2 (B export_input_0)) (union export_class_2 (BB export_input_0)) (let export_class_3 (C export_input_0)) (union export_class_3 (CC export_input_0)) (let export_class_4 (Final export_input_0)) (let export_class_5 (Joined export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1) (set (Spine-Reified-Term export_root_1) export_class_2) (set (Spine-Reified-Term export_root_2) export_class_3)) :ruleset Spine-Export)

; Automatic constructor-level ingress; no scan of a materialized original graph.
(Spine-A (Spine-Leaf "x"))
(Spine-B (Spine-Leaf "x"))
(Spine-C (Spine-Leaf "x"))
(run-schedule (saturate Spine-Run))
(run-schedule (saturate Spine-Export))
(check (Final (Leaf "x")))
