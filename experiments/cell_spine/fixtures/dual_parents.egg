(datatype Term (Leaf String) (A Term) (AA Term) (B Term) (BB Term) (Joined Term))
(ruleset demo)
(rewrite (A x) (AA x) :ruleset demo)
(rewrite (B x) (BB x) :ruleset demo)
(rule ((= a (AA x)) (= b (BB x))) ((Joined x)) :ruleset demo)
(A (Leaf "x"))
(B (Leaf "x"))
(run-schedule (saturate demo))
(check (Joined (Leaf "x")))
