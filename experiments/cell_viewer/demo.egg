(datatype Expr (Num i64) (Add Expr Expr) (Mul Expr Expr))
(ruleset add-zero)
(ruleset mul-one)
(rule ((= a (Add x (Num 0)))) ((union a x)) :ruleset add-zero :name "add-zero")
(rule ((= m (Mul x (Num 1)))) ((union m x)) :ruleset mul-one :name "mul-one")
(let x (Num 7))
(let root (Add (Mul x (Num 1)) (Num 0)))
(run add-zero 1)
(run mul-one 1)
(check (= root x))
