(datatype E (V i64) (A E) (B E))
(relation Flag (E))
(relation Done (E))
(rewrite (A x) (B x) :name "a-to-b")
(rule ((= root (A x)) (= root (B x)) (Flag x))
      ((Done root)) :name "use-closed-fragment")
(A (V 1))
(A (V 2))
(Flag (V 1))
(Flag (V 2))
(run 2)
(union (V 1) (V 2))
(run 2)
(check (Done (A (V 1))))
(check (Done (A (V 2))))
