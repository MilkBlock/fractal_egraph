; Equality is scoped to a context. Never union tier-1 Values or Contexts here.
(datatype Val (V String String))
(datatype Args (ANil) (ACons Val Args))
(datatype Effect (HasFact String Args) (Equal Val Val))
(datatype Effects (ENil) (ECons Effect Effects))
(datatype Ctx (Entry i64) (Join Ctx Ctx) (Apply Ctx String String Effects Effects))
(relation Known (Ctx))
(relation ValueKnown (Val))
(relation Given (Ctx Effect))
(relation Grounded (Ctx))
(relation Ready (Ctx))
(relation Provides (Ctx Effect))
(relation EqAt (Ctx Val Val))
(relation ArgsEqual (Ctx Args Args))
(relation Satisfies (Ctx Effect))
(relation AllSatisfied (Ctx Effects))
(relation DominatesForUse (Ctx Ctx))
(relation Smooth (Ctx))
(relation AlternativeSupport (Ctx Ctx))
(relation ProposedRemoval (Ctx Ctx Ctx))
(relation Independent (Ctx Ctx))
(relation RedundantForUse (Ctx Ctx Ctx))
(ruleset tier1)
(rule ((= c (Entry id))) ((Known c) (Ready c)) :ruleset tier1)
(rule ((= c (Join a b))) ((Known c)) :ruleset tier1)
(rule ((= c (Apply p r binding req prod))) ((Known c)) :ruleset tier1)
(rule ((= c (Join a b)) (Ready a) (Ready b)) ((Ready c)) :ruleset tier1)
(rule ((Ready c) (Given c e)) ((Provides c e)) :ruleset tier1)
(rule ((= c (Join a b)) (Ready c) (Provides a e)) ((Provides c e)) :ruleset tier1)
(rule ((= c (Join a b)) (Ready c) (Provides b e)) ((Provides c e)) :ruleset tier1)
(rule ((Known c) (ValueKnown v)) ((EqAt c v v)) :ruleset tier1)
(rule ((Provides c (Equal (V sort a) (V sort b)))) ((EqAt c (V sort a) (V sort b))) :ruleset tier1)
(rule ((EqAt c a b)) ((EqAt c b a)) :ruleset tier1)
(rule ((EqAt c a b) (EqAt c b d)) ((EqAt c a d)) :ruleset tier1)
(rule ((Known c)) ((ArgsEqual c (ANil) (ANil))) :ruleset tier1)
(rule ((= xs (ACons x xt)) (= ys (ACons y yt)) (EqAt c x y) (ArgsEqual c xt yt)) ((ArgsEqual c xs ys)) :ruleset tier1)
(rule ((= e (HasFact name wanted)) (Provides c (HasFact name actual)) (ArgsEqual c actual wanted)) ((Satisfies c e)) :ruleset tier1)
(rule ((= e (Equal a b)) (EqAt c a b)) ((Satisfies c e)) :ruleset tier1)
(rule ((Known c)) ((AllSatisfied c (ENil))) :ruleset tier1)
(rule ((= es (ECons e tail)) (Satisfies c e) (AllSatisfied c tail)) ((AllSatisfied c es)) :ruleset tier1)
(rule ((= app (Apply p r binding req prod)) (Grounded app) (Ready p) (AllSatisfied p req)) ((Ready app) (Smooth app)) :ruleset tier1)
(rule ((= app (Apply p r binding req prod)) (Ready app) (Provides p e)) ((Provides app e)) :ruleset tier1)
; Produced effects are made visible only after the application is ready.
(relation Emit (Ctx Effects))
(rule ((= app (Apply p r binding req prod)) (Ready app)) ((Emit app prod)) :ruleset tier1)
(rule ((Emit c (ECons e tail))) ((Provides c e) (Emit c tail)) :ruleset tier1)
(rule ((= app (Apply p r binding req prod)) (Grounded app) (Ready c) (AllSatisfied c req)) ((DominatesForUse c app)) :ruleset tier1)
(rule ((= old (Apply p r binding req prod)) (= new (Apply q r binding req prod)) (Ready new)) ((AlternativeSupport old new)) :ruleset tier1)
(rule ((AlternativeSupport old new) (= new (Apply q r binding req prod)) (ProposedRemoval old new removed) (Independent q removed)) ((RedundantForUse old new removed)) :ruleset tier1)
