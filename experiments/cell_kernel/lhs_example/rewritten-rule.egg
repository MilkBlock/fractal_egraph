 (ContextOf if_e outer_ctx)
 (AutoTouch_cell_0 e1 o x ty t1 c1 true pred orig_ins)
 (AutoTouch_cell_0 e2 o y ty t2 c2 false pred orig_ins)
 (= t1 t2)
 (= orig_ins_len (TypeList-length tylist))) ((let new_term (TermSubst outer_ctx orig_ins t1)) (let new_ins (Concat orig_ins (Single new_term))) (let new_ins_ty (TupleT (TLConcat tylist (TCons ty (TNil ))))) (let if_tr (InIf true pred new_ins)) (let if_fa (InIf false pred new_ins)) (let st_tr (SubTuple (Arg new_ins_ty if_tr) 0 orig_ins_len)) (let st_fa (SubTuple (Arg new_ins_ty if_fa) 0 orig_ins_len)) (let new_thn (Subst if_tr st_tr thn)) (let new_els (Subst if_fa st_fa els)) (union (Get (Arg new_ins_ty if_tr) orig_ins_len) (Subst if_tr st_tr e1)) (union (Get (Arg new_ins_ty if_fa) orig_ins_len) (Subst if_fa st_fa e2)) (Uop o (Subst if_tr st_tr x)) (Uop o (Subst if_fa st_fa y)) (subsume (Uop o (Subst if_tr st_tr x))) (subsume (Uop o (Subst if_fa st_fa y))) (union if_e (If pred new_ins new_thn new_els))) :ruleset AutoApply)
