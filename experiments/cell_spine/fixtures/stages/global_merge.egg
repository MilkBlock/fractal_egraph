(datatype Node (V i64))
(let bias 2)
(let root (V 7))
(function score () i64 :merge (+ old bias))
(function pick () Node :merge root)
(relation Tick (i64))
(ruleset one)
(rule ((Tick x)) ((set (score) (+ x 1)) (set (pick) root)) :ruleset one)
(Tick 0)
(run one 1)
(Tick 1)
(run one 1)
(check (= (score) 3))
(check (= (pick) root))
