(datatype Expr (Float f64) (Wrapped Expr))
(relation Seen (Expr))
(ruleset main)
(let a (Float 10000000000000000.0))
(let b (Float -0.0))
(let c (Float NaN))
(rule ((= x (Float f))) ((Wrapped x) (Seen x)) :ruleset main)
(run main 2)
(check (Seen a))
(check (= b (Float 0.0)))
(check (= c (Float NaN)))
