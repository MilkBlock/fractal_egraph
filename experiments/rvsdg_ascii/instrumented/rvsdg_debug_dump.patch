+impl RvsdgProgram {
+    /// Local debugging helper: dump the real RVSDG IR as text.
+    pub fn debug_dump(&self) -> String {
+        use std::fmt::Write;
+        let mut out = String::new();
+        for f in &self.functions {
+            let _ = writeln!(out, "function {} args={:?}", f.name, f.args);
+            for (i, node) in f.nodes.iter().enumerate() {
+                let _ = writeln!(out, "  [{i}] {node:?}");
+            }
+            let _ = writeln!(out, "  results={:?}", f.results);
+        }
+        out
+    }
+}
