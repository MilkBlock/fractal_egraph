(datatype Expr (Root)) (datatype Term (Leaf i64))
(datatype Candidate (TCPair Term i64) (Smaller Candidate Candidate) (Seen Candidate))
(relation Offer (Expr Term i64))
(function Best (Expr) Candidate :merge (Smaller old new))
(ruleset offer) (ruleset observe) (ruleset choose)
(rule ((Offer root term cost)) ((set (Best root) (TCPair term cost))) :ruleset offer)
(rule ((= result (Best root))) ((Seen result)) :ruleset observe)
(rule ((= s (Smaller (TCPair a ca) (TCPair b cb))) (<= ca cb)) ((union s (TCPair a ca))) :ruleset choose)
(rule ((= s (Smaller (TCPair a ca) (TCPair b cb))) (> ca cb)) ((union s (TCPair b cb))) :ruleset choose)
(set (Best (Root)) (TCPair (Leaf 0) 10))
(Offer (Root) (Leaf 1) 7) (Offer (Root) (Leaf 2) 5)
(run-schedule (run offer) (run observe) (saturate (run choose)))
