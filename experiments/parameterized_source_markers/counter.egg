; A successor marker reuses the old Port row and the new numeric State row.
(datatype E (N i64) (State E i64) (Port E))
(relation Seen (E i64)) (relation Mirror (E i64))
(function limit (E) i64 :no-merge)
(ruleset s)
(rule ((= state (State x n)) (= port (Port x)) (= len (limit x)) (< n len))
      ((Seen x n) (State x (+ n 1))) :ruleset s :name "advance")
(rule ((= state (State x n)) (= port (Port x)) (= len (limit x)) (> n 0) (< n len))
      ((Mirror x n)) :ruleset s :name "observe")
(State (N 0) 0) (Port (N 0)) (set (limit (N 0)) 2)
(run s 1)
(check (State (N 0) 1))
(fail (check (State (N 0) 2)))
(run s 1)
(check (State (N 0) 2))
(fail (check (State (N 0) 3)))
(delete (limit (N 0))) (set (limit (N 0)) 4)
(run s 1)
(check (State (N 0) 3))
(fail (check (State (N 0) 4)))
(run s 1)
(check (State (N 0) 4))
(State (N 1) 8) (Port (N 2)) (set (limit (N 1)) 10)
(run s 1)
(fail (check (State (N 1) 9)))
(union (N 1) (N 2))
(run s 1)
(check (State (N 1) 9))
(fail (check (State (N 1) 10)))
