      ((HasArgType lhs ty))
        :ruleset type-analysis :name "(rule ((= lhs (Call @_8 e))
       (HasArgType e ty))
      ((HasArgType lhs ty))
        :ruleset type-analysis )")
(rule ((= lhs (Single e))
