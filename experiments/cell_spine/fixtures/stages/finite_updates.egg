(function score (i64) i64 :merge new)
(ruleset one)
(rule ((= n (score 0)) (< n 3)) ((set (score 0) (+ n 1))) :ruleset one)
(set (score 0) 0)
(run one 1)
(check (= (score 0) 1))
(set (score 0) 10)
(check (= (score 0) 10))
(delete (score 0))
(fail (check (= (score 0) 10)))
(set (score 0) 2)
(run one 1)
(check (= (score 0) 3))
