; Fixed-point anti-unification of an acyclic, single-enode input DAG.
; Node IDs are immutable syntax identities, not runtime e-class IDs after union.
(sort P)
(sort PS)
(sort Holes (Set i64))
(constructor Hole (i64 i64) P)
(constructor Branch (String PS) P)
(constructor PNil () PS)
(constructor PCons (P PS) PS)
(relation Node (i64 String i64))
(relation Cons (i64 i64 i64))
(relation Allowed (i64 i64 i64))
(relation Dead (i64 i64))
(relation Need (i64 i64))
(relation NeedList (i64 i64))
(relation DeadList (i64 i64))
(relation AU (i64 i64 P Holes))
(relation AL (i64 i64 PS Holes))
(relation Limit (i64))

(rule ((Need a b) (Allowed a b id) (Node a x xs) (Node b y ys) (!= x y))
      ((AU a b (Hole a b) (set-of id))))
(rule ((Need a b) (Allowed a b id) (Node a op xs) (Node b op ys))
      ((NeedList xs ys)))
(rule ((NeedList 0 0)) ((AL 0 0 (PNil) (set-of))))
(rule ((NeedList xs ys) (Cons xs a restx) (Cons ys b resty))
      ((Need a b) (NeedList restx resty)))
(rule ((NeedList xs ys) (Cons xs a restx) (Cons ys b resty)
       (AU a b p h) (AL restx resty ps hs))
      ((AL xs ys (PCons p ps) (set-union h hs))))
(rule ((NeedList xs ys) (Cons xs a restx) (Cons ys b resty) (Dead a b))
      ((DeadList xs ys)))
(rule ((NeedList xs ys) (Cons xs a restx) (Cons ys b resty) (DeadList restx resty))
      ((DeadList xs ys)))
(rule ((Need a b) (Allowed a b id) (Node a op xs) (Node b op ys)
       (AL xs ys ps hs) (Limit n) (<= (set-length hs) n))
      ((AU a b (Branch op ps) hs)))
(rule ((Need a b) (Allowed a b id) (Node a op xs) (Node b op ys)
       (AL xs ys ps hs) (Limit n) (> (set-length hs) n))
      ((AU a b (Hole a b) (set-of id))))
(rule ((Need a b) (Allowed a b id) (Node a op xs) (Node b op ys) (DeadList xs ys))
      ((AU a b (Hole a b) (set-of id))))
