(datatype Node (V i64) (Wrap Node))
(sort Nodes (Vec Node))
(sort NodeSet (Set Node))
(sort NodeMap (Map i64 Node))
(function vs () Nodes :no-merge)
(function ss () NodeSet :no-merge)
(function mm () NodeMap :no-merge)
(ruleset one)
(rewrite (Wrap x) x :ruleset one)
(let a (V 1))
(let b (V 2))
(set (vs) (vec-of a b))
(set (ss) (set-of a b))
(set (mm) (map-insert (map-empty) 0 b))
(Wrap a)
(run one 1)
(union a b)
(check (= (vec-get (vs) 0) (vec-get (vs) 1)))
(check (= (set-length (ss)) 1))
(check (= (map-get (mm) 0) a))
