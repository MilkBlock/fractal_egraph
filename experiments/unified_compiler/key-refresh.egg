; cell-choice/v1 {"function":"Winner","score":"Rank","order":"max","tie_break":"structural"}
(datatype E (N i64 String f64))
(function Rank (E) i64 :merge (max old new))
(function Winner () E :merge new)
(relation Candidate (E))
(ruleset choose) (ruleset improve) (ruleset alias)
(rule ((= x (N 2 "b" 1.5))) ((set (Rank x) 10000000000000001)) :ruleset improve)
(rule ((= a (N 10 "a\n中文" -0.0)) (= b (N 2 "b" 1.5))) ((union a b)) :ruleset alias)
(rule ((Candidate x) (= n (Rank x))) ((set (Winner) x)) :ruleset choose)
(let a (N 10 "a\n中文" -0.0))
(let b (N 2 "b" 1.5))
(set (Rank a) 10000000000000000)
(set (Rank b) 9999999999999999)
(Candidate b) (Candidate a)
(run choose 1)
(check (= (Winner) a))
(run improve 1) (run choose 1)
(check (= (Winner) b))
(run alias 1) (run choose 1)
(check (= (Winner) a))
