(datatype Node (V i64) (Wrap Node))
(sort PairNS (Pair Node String))
(sort Bag (MultiSet Node))
(sort Nodes (Vec Node))
(function pp () PairNS :no-merge)
(function bag () Bag :no-merge)
(function empty-nodes () Nodes :no-merge)
(ruleset one)
(rewrite (Wrap x) x :ruleset one)
(let a (V 1))
(set (pp) (pair a "hello"))
(set (bag) (multiset-of a a))
(set (empty-nodes) (vec-of))
(let empty (empty-nodes))
(Wrap a)
(run one 1)
(check (= (pp) (pair a "hello")))
(check (= (bag) (multiset-of a a)))
(check (= empty (vec-of)))
