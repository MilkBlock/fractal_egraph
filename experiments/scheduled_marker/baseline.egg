; Controlled synthetic workload: one P and one Q per join key.
; 90% of keys have a manually certified cell; no union or destructive updates.
(relation Seed (i64))
(relation P (i64 i64))
(relation Q (i64 i64))
(relation Cell (i64 i64 i64))
(relation External (i64 i64))
(relation Result (i64 i64))
(ruleset seed)
(rule ((Seed x) (< x 65536)) ((Seed (* x 2)) (Seed (+ (* x 2) 1))) :ruleset seed)
(Seed 1)
(run seed 17)
(ruleset produce)
(rule ((Seed x)) ((P x x) (Q x (+ x 1)) (External (+ x 1) (+ x 2))) :ruleset produce)
(rule ((Seed x) (< (% x 10) 9)) ((Cell x x (+ x 1))) :ruleset produce)
(run produce 1)
(ruleset consume)
(rule ((P x a) (Q a y) (External y z)) ((Result x z)) :ruleset consume)
(run consume 1)
(check (Result 1 3) (Result 9 11) (Result 131071 131073))
