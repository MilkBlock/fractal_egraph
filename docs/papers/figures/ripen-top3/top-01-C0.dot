digraph  {
  compound=true
  rank=same
  fontname=helvetica
  fontsize=9
  margin=3
  nodesep=0.05
  ranksep=0.6
  colorscheme=set312
  edge[arrowsize=0.5]
  node[shape=none margin=0 fontname=helvetica]
  outputorder=edgesfirst
  graph[style="dashed,rounded,filled"]
  fillcolor=2
  "function-0-RipenInput":0:s -> "primitive-i64-0" [lhead="cluster_i64-0"]
  subgraph "outer_cluster_Math-0" {
    subgraph "cluster_Math-0" {
      subgraph  {
        "function-0-RipenInput"[label=<<TABLE BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" style="rounded"><tr><td BALIGN="left" CELLPADDING="4" WIDTH="30" HEIGHT="30" colspan="1">RipenInput</td></tr><TR><TD PORT="0"></TD></TR></TABLE>> tooltip="Math-0: function-0-RipenInput"]
      }
    }
    style="invis"
    cluster=true
  }
  "function-1-RipenInput":0:s -> "primitive-i64-1" [lhead="cluster_i64-1"]
