(datatype Expr (Const i64) (Var String) (Add Expr Expr) (Mul Expr Expr))
(ruleset simplify)
(rewrite (Add (Const a) (Const b)) (Const (+ a b)) :ruleset simplify :name "add-fold")
(rewrite (Mul (Const a) (Const b)) (Const (* a b)) :ruleset simplify :name "mul-fold")
(rewrite (Add x (Const 0)) x :ruleset simplify :name "add-zero")
(rewrite (Mul x (Const 1)) x :ruleset simplify :name "mul-one")
(rewrite (Mul x (Const 0)) (Const 0) :ruleset simplify :name "mul-zero")
(let seed (Add (Mul (Const 2) (Const 3)) (Mul (Const 4) (Const 5))))
(run simplify 10)
(check (= seed (Const 26)))
