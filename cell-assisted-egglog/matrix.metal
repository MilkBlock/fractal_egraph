// Shared layouts and field constants are generated by compile.rs.
#include <metal_stdlib>
using namespace metal;
constant uint NO = 0xffffffffu;
#define CONTEXT device uint *h [[buffer(0)]], constant uint4 &cfg [[buffer(1)]]
#define U(name, r, c) h[name##_OFF + (r) * name##_COLS + (c)]
#define F(name, r, c)                                                          \
  ((device float *)(h + name##_OFF))[(r) * name##_COLS + (c)]
#define OP(n, f) U(FEATURE_OPS, n, FEATURE_OPS_##f)
#define C(i, f) U(CONDITION_OPS, i, CONDITION_OPS_##f)
#define CH(i, f) U(CHANNEL_OPS, i, CHANNEL_OPS_##f)
#define G(i, f) U(GROUPS, i, GROUPS_##f)
void inc(device uint *h, uint field, uint n = 1) {
  atomic_fetch_add_explicit((device atomic_uint *)(h + COUNTERS_OFF + field), n,
                            memory_order_relaxed);
}
void need(device uint *h, uint c, uint n) {
  atomic_store_explicit(
      (device atomic_uint *)(h + NEEDED_OFF + c * NEEDED_COLS + n), 1,
      memory_order_relaxed);
}
kernel void update_ports(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= cfg.y)
    return;
  uint u = cfg.x + i, c = U(UPDATES, u, UPDATES_CELL),
       s = U(UPDATES, u, UPDATES_SLOT), v = U(UPDATES, u, UPDATES_VALUE);
  if (U(BINDINGS, c, s) != v) {
    U(BINDINGS, c, s) = v;
    U(DIRTY_PORTS, c, s) = 1;
  }
}
kernel void invalidate_features(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= CELL_COUNT * NODE_COUNT)
    return;
  uint c = i / NODE_COUNT, n = i % NODE_COUNT;
  for (uint s = 0; s < BINDINGS_COLS; s++)
    if (U(SUPPORTS, n, s) && U(DIRTY_PORTS, c, s)) {
      U(VALID, c, n) = 0;
      break;
    }
}
kernel void invalidate_conditions(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= CONDITION_COUNT)
    return;
  if (!U(VALID, C(i, LC), C(i, LN)) || !U(VALID, C(i, RC), C(i, RN)))
    U(EVIDENCE, i, 0) = C(i, KNOWN);
}
kernel void clear_dirty(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i < CELL_COUNT * BINDINGS_COLS)
    h[DIRTY_PORTS_OFF + i] = 0;
}
kernel void admit(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= CELL_COUNT)
    return;
  if (!U(CELL_META, i, CELL_META_INITIAL)) {
    U(LIVE, i, 0) = 0;
    return;
  }
  uint arity = U(CELL_META, i, CELL_META_ARITY);
  uint live = 1;
  for (uint a = 0; a < arity; a++)
    for (uint b = 0; b < a; b++)
      if ((U(BINDINGS, i, a) == U(BINDINGS, i, b)) !=
          (U(PARTITIONS, i, a) == U(PARTITIONS, i, b)))
        live = 2;
  U(LIVE, i, 0) = live;
}
kernel void clear_requests(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i < CONDITION_COUNT)
    U(REQUESTED, i, 0) = 0;
}
kernel void reset_channels(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i < cfg.y)
    U(DECISIONS, U(STAGE_CHANNELS, cfg.x + i, 0), 0) = 0;
}
kernel void classify(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= cfg.y)
    return;
  uint ci = U(STAGE_CHANNELS, cfg.x + i, 0);
  if (U(DECISIONS, ci, 0) != 0)
    return;
  uint ss = CH(ci, SOURCE_START), sn = CH(ci, SOURCE_COUNT);
  bool pending = false;
  for (uint j = 0; j < sn; j++) {
    uint s = U(LIVE, U(SOURCES, ss + j, SOURCES_CELL), 0);
    if (s == 0) {
      U(DECISIONS, ci, 0) = 2;
      return;
    }
    pending |= s != 1;
  }
  if (pending)
    return;
  uint bs = CH(ci, BRANCH_START), bn = CH(ci, BRANCH_COUNT);
  bool any = false;
  for (uint b = bs; b < bs + bn; b++) {
    uint rs = U(BRANCHES, b, BRANCHES_START),
         rn = U(BRANCHES, b, BRANCHES_COUNT);
    bool failed = false, complete = true;
    for (uint j = rs; j < rs + rn; j++) {
      uint e = U(EVIDENCE, U(REQUIREMENTS, j, REQUIREMENTS_CONDITION), 0);
      failed |= e == 1;
      complete &= e == 2;
    }
    if (complete) {
      U(DECISIONS, ci, 0) = 1;
      return;
    }
    any |= !failed;
  }
  if (!any) {
    U(DECISIONS, ci, 0) = 2;
    return;
  }
  if (cfg.z == NO)
    return;
  for (uint b = bs; b < bs + bn; b++) {
    uint rs = U(BRANCHES, b, BRANCHES_START),
         rn = U(BRANCHES, b, BRANCHES_COUNT);
    bool failed = false;
    for (uint j = rs; j < rs + rn; j++)
      failed |= U(EVIDENCE, U(REQUIREMENTS, j, REQUIREMENTS_CONDITION), 0) == 1;
    if (failed)
      continue;
    for (uint j = rs; j < rs + rn; j++) {
      uint c = U(REQUIREMENTS, j, REQUIREMENTS_CONDITION);
      if (U(REQUIREMENTS, j, REQUIREMENTS_DEPTH) <= cfg.z &&
          U(EVIDENCE, c, 0) == 0)
        atomic_store_explicit((device atomic_uint *)(h + REQUESTED_OFF + c), 1,
                              memory_order_relaxed);
    }
  }
}
// Compact only the rows demanded by still-live binding branches. No identities
// or complete bindings are sent to the CPU; it reads one dimension for MPS.
kernel void prepare_group(CONTEXT, uint id [[thread_position_in_grid]]) {
  if (id)
    return;
  uint g = cfg.w, n = G(g, WIRE_COUNT), map = G(g, MAP),
       pairs = G(g, CONDITIONS), np = G(g, CONDITION_COUNT);
  for (uint i = 0; i < n; i++)
    h[map + i] = NO;
  uint requested = 0;
  for (uint i = 0; i < np; i++) {
    uint p = pairs + i * PAIR_COLS, c = h[p + PAIR_CONDITION];
    if (U(REQUESTED, c, 0) && U(EVIDENCE, c, 0) == 0) {
      h[map + h[p + PAIR_LEFT]] = 0;
      h[map + h[p + PAIR_RIGHT]] = 0;
      requested++;
    }
  }
  uint count = 0, wires = G(g, WIRES), packed = G(g, PACKED);
  for (uint i = 0; i < n; i++)
    if (h[map + i] != NO) {
      h[map + i] = count;
      h[packed + count++] = i;
      need(h, h[wires + i * WIRE_COLS + WIRE_CELL],
           h[wires + i * WIRE_COLS + WIRE_NODE]);
    }
  h[G(g, COUNT)] = count;
  if (count) {
    inc(h, COUNTERS_REQUESTED_CONDITIONS, requested);
  }
}
// Reuse the exact port/lift2/mean/concat/moments circuit from moment_compiler.
kernel void build_features(CONTEXT, uint c [[thread_position_in_grid]]) {
  if (c >= CELL_COUNT)
    return;
  for (int n = int(NODE_COUNT) - 1; n >= 0; n--)
    if (U(NEEDED, c, n) && !U(VALID, c, n)) {
      uint a = OP(n, A), b = OP(n, B);
      if (a != NO)
        U(NEEDED, c, a) = 1;
      if (b != NO)
        U(NEEDED, c, b) = 1;
    }
  for (uint n = 0; n < NODE_COUNT; n++) {
    if (!U(NEEDED, c, n))
      continue;
    U(NEEDED, c, n) = 0;
    if (U(VALID, c, n)) {
      inc(h, COUNTERS_REUSED_FEATURES);
      continue;
    }
    uint op = OP(n, OP), out = OP(n, OFFSET), w = OP(n, WIDTH), ai = OP(n, A),
         bi = OP(n, B);
    uint a = ai == NO ? 0 : OP(ai, OFFSET), b = bi == NO ? 0 : OP(bi, OFFSET),
         aw = ai == NO ? 0 : OP(ai, WIDTH);
    if (op == 0) {
      uint v = U(BINDINGS, c, OP(n, SLOT));
      for (uint j = 0; j < w; j++)
        F(FEATURES, c, out + j) = ((v >> j) & 1) ? 1.0f : -1.0f;
    } else if (op == 1) {
      uint k = 0;
      for (uint j = 0; j < aw; j++)
        F(FEATURES, c, out + k++) = F(FEATURES, c, a + j);
      for (uint j = 0; j < aw; j++)
        for (uint l = j + 1; l < aw; l++)
          F(FEATURES, c, out + k++) =
              F(FEATURES, c, a + j) * F(FEATURES, c, a + l);
    } else if (op == 2) {
      for (uint j = 0; j < w; j++)
        F(FEATURES, c, out + j) =
            (F(FEATURES, c, a + j) + F(FEATURES, c, b + j)) * 0.5f;
    } else if (op == 3) {
      for (uint j = 0; j < aw; j++)
        F(FEATURES, c, out + j) = F(FEATURES, c, a + j);
      for (uint j = aw; j < w; j++)
        F(FEATURES, c, out + j) = F(FEATURES, c, b + j - aw);
    } else {
      uint k = 0;
      for (uint j = 0; j < aw; j++)
        F(FEATURES, c, out + k++) =
            F(FEATURES, c, a + j) + F(FEATURES, c, b + j);
      for (uint j = 0; j < aw; j++)
        for (uint l = j; l < aw; l++)
          F(FEATURES, c, out + k++) =
              F(FEATURES, c, a + j) * F(FEATURES, c, a + l) +
              F(FEATURES, c, b + j) * F(FEATURES, c, b + l);
    }
    U(VALID, c, n) = 1;
    inc(h, COUNTERS_COMPUTED_FEATURES);
    inc(h, COUNTERS_FEATURE_COMPONENTS_WRITTEN, w);
    if (op == 1)
      inc(h, COUNTERS_FEATURE_MULTIPLIES, aw * (aw - 1) / 2);
    else if (op == 2) {
      inc(h, COUNTERS_FEATURE_ADDS, w);
      inc(h, COUNTERS_FEATURE_MULTIPLIES, w);
    } else if (op == 4) {
      inc(h, COUNTERS_FEATURE_ADDS, w);
      inc(h, COUNTERS_FEATURE_MULTIPLIES, aw * (aw + 1));
    }
  }
}
kernel void project(CONTEXT, uint i [[thread_position_in_grid]]) {
  uint g = cfg.w, n = h[G(g, COUNT)];
  if (i >= n)
    return;
  uint local = h[G(g, PACKED) + i], r = G(g, WIRES) + local * WIRE_COLS,
       c = h[r + WIRE_CELL], node = h[r + WIRE_NODE], off = OP(node, OFFSET),
       w = G(g, WIDTH);
  float norm = 0;
  device float *out = (device float *)(h + G(g, ROWS));
  for (uint j = 0; j < w; j++) {
    float v = F(FEATURES, c, off + j);
    out[i * G(g, ROW_COLS) + j] = v;
    norm += v * v;
  }
  ((device float *)(h + G(g, NORM)))[i] = norm;
}
kernel void collect(CONTEXT, uint i [[thread_position_in_grid]]) {
  uint g = cfg.w;
  if (i >= G(g, CONDITION_COUNT))
    return;
  uint pair = G(g, CONDITIONS) + PAIR_COLS * i, map = G(g, MAP),
       a = h[map + h[pair + PAIR_LEFT]], b = h[map + h[pair + PAIR_RIGHT]];
  if (a == NO || b == NO)
    return;
  device float *norm = (device float *)(h + G(g, NORM));
  device float *gram = (device float *)(h + G(g, GRAM));
  float d = norm[a] + norm[b] - 2 * gram[a * G(g, GRAM_COLS) + b];
  U(EVIDENCE, h[pair + PAIR_CONDITION], 0) = d == 0 ? 2 : 1;
}
kernel void targets(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= cfg.y)
    return;
  uint ci = U(STAGE_CHANNELS, cfg.x + i, 0), target = CH(ci, TARGET);
  U(TARGET_STATUS, ci, 0) = 0;
  if (target == NO)
    return;
  uint decision = U(DECISIONS, ci, 0);
  U(LIVE, target, 0) = decision == 0 ? 2 : 0;
  if (decision != 1)
    return;
  uint gs = CH(ci, GATHER_START), n = CH(ci, GATHER_COUNT), status = 1;
  for (uint j = 0; j < n; j++) {
    uint v = U(BINDINGS, U(GATHERS, gs + j, GATHERS_CELL),
               U(GATHERS, gs + j, GATHERS_SLOT));
    if (U(BINDINGS, target, j) != v)
      U(DIRTY_PORTS, target, j) = 1;
    U(BINDINGS, target, j) = v;
  }
  for (uint a = 0; a < n; a++)
    for (uint b = 0; b < a; b++)
      if ((U(BINDINGS, target, a) == U(BINDINGS, target, b)) !=
          (U(PARTITIONS, target, a) == U(PARTITIONS, target, b)))
        status = 2;
  U(LIVE, target, 0) = status;
  U(TARGET_STATUS, ci, 0) = status;
}

kernel void histogram(CONTEXT, uint i [[thread_position_in_grid]]) {
  if (i >= cfg.y)
    return;
  uint s = U(DECISIONS, U(STAGE_CHANNELS, cfg.x + i, 0), 0);
  atomic_fetch_add_explicit((device atomic_uint *)(h + HISTOGRAM_OFF + s), 1,
                            memory_order_relaxed);
}
