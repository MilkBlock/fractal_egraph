; cell-choice/v1 {"function":"winner","score":"rank","order":"max","tie_break":"structural"}
(datatype E (N i64) (Pair E E))
(datatype Unused (Ignored i64))
(function rank (E) i64 :merge (max old new))
(function winner (E) E :merge new)
(relation Offer (E E))
(ruleset pick)
(ruleset ordinary)
(rule ((Offer key v)) ((set (winner key) v)) :ruleset pick :name "select")
(Offer (N 0) (Pair (N 1) (N 2)))
(Offer (N 0) (Pair (N 2) (N 1)))
(set (rank (Pair (N 1) (N 2))) 7)
(set (rank (Pair (N 2) (N 1))) 7)
(N 999) (Ignored 123)
(run ordinary 1)
(run pick 1)
(check (= (winner (N 0)) (Pair (N 1) (N 2))))
(Offer (N 3) (N 8)) (set (rank (N 8)) 9)
(run pick 1)
(union (N 0) (N 3))
(check (= (winner (N 0)) (N 8)))
(Offer (N 0) (N 4)) (set (rank (N 4)) 10)
(run pick 1)
(check (= (winner (N 3)) (N 4)))
