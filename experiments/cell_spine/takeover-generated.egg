(datatype Term (Leaf String) (A Term) (AA Term) (P Term) (PP Term) (Q Term) (Large Term) (Other Term))
(ruleset demo)
(rewrite (A x) (AA x) :ruleset demo)
(rewrite (P x) (PP x) :ruleset demo)
(rule ((AA x)
       (PP x))
      ((Large x))
        :ruleset demo )
(rule ((AA x)
       (Q x))
      ((Other x))
        :ruleset demo )
(constructor RipenInput (i64) Term)
(ruleset Spine-Run)
(ruleset Spine-Export)
(sort Spine-Term)
(constructor Spine-A (Spine-Term) Spine-Term)
(constructor Spine-AA (Spine-Term) Spine-Term)
(constructor Spine-Large (Spine-Term) Spine-Term)
(constructor Spine-Leaf (String) Spine-Term)
(constructor Spine-Other (Spine-Term) Spine-Term)
(constructor Spine-P (Spine-Term) Spine-Term)
(constructor Spine-PP (Spine-Term) Spine-Term)
(constructor Spine-Q (Spine-Term) Spine-Term)
(constructor Spine-RipenInput (i64) Spine-Term)
(function Spine-Reified-Term (Spine-Term) Term :merge old)
(rule ((= s (Spine-A x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (A y0))) :ruleset Spine-Export)
(rule ((= s (Spine-A x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (A y0))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (AA y0))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (AA y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Large x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (Large y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Large x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (Large y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0))) ((set (Spine-Reified-Term s) (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0)) (= previous (Spine-Reified-Term s))) ((union previous (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-Other x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (Other y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Other x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (Other y0))) :ruleset Spine-Export)
(rule ((= s (Spine-P x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (P y0))) :ruleset Spine-Export)
(rule ((= s (Spine-P x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (P y0))) :ruleset Spine-Export)
(rule ((= s (Spine-PP x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (PP y0))) :ruleset Spine-Export)
(rule ((= s (Spine-PP x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (PP y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Q x0)) (= y0 (Spine-Reified-Term x0))) ((set (Spine-Reified-Term s) (Q y0))) :ruleset Spine-Export)
(rule ((= s (Spine-Q x0)) (= y0 (Spine-Reified-Term x0)) (= previous (Spine-Reified-Term s))) ((union previous (Q y0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0))) ((set (Spine-Reified-Term s) (RipenInput x0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0)) (= previous (Spine-Reified-Term s))) ((union previous (RipenInput x0))) :ruleset Spine-Export)
(sort Spine-Cell)
(constructor Spine-Summary-0 (Spine-Term Spine-Term) Spine-Cell)
(constructor Spine-Summary-1 (Spine-Term Spine-Term) Spine-Cell)
(constructor Spine-Summary-2 (Spine-Term Spine-Term Spine-Term) Spine-Cell)
(constructor Spine-Summary-3 (Spine-Term Spine-Term Spine-Term) Spine-Cell)
; selected Cell 0: observed path 0 -> path 0
; selected Cell 1: observed path 1 -> path 1
; selected Cell 2: observed path 2 -> path 2
; selected Cell 3: observed path 3 -> path 3
(rule ((= match_0 (Spine-A p0))) ((Spine-Summary-0 (Spine-A p0) p0)) :ruleset Spine-Run :name "impl_0_0")
(rule ((= match_0 (Spine-P p0))) ((Spine-Summary-1 (Spine-P p0) p0)) :ruleset Spine-Run :name "impl_1_0")
(rule ((Spine-Summary-0 parent_0_root_0 p0) (Spine-Summary-1 parent_1_root_0 p0)) ((Spine-Summary-2 parent_0_root_0 parent_1_root_0 p0) (subsume (Spine-Summary-0 parent_0_root_0 p0)) (subsume (Spine-Summary-1 parent_1_root_0 p0))) :ruleset Spine-Run :name "impl_2_0")
(rule ((Spine-Summary-3 cover_0_r0 cover_0_r1 cover_0_p0) (Spine-Summary-1 parent_1_root_0 cover_0_p0)) ((Spine-Summary-2 cover_0_r0 parent_1_root_0 cover_0_p0) (subsume (Spine-Summary-1 parent_1_root_0 cover_0_p0))) :ruleset Spine-Run :name "impl_2_0_cover_4")
(rule ((Spine-Summary-0 parent_0_root_0 p0) (= match_1 (Spine-Q p0))) ((Spine-Summary-3 parent_0_root_0 (Spine-Q p0) p0) (subsume (Spine-Summary-0 parent_0_root_0 p0))) :ruleset Spine-Run :name "impl_3_0")
(rule ((Spine-Summary-2 cover_0_r0 cover_0_r1 cover_0_p0) (= match_1 (Spine-Q cover_0_p0))) ((Spine-Summary-3 cover_0_r0 (Spine-Q cover_0_p0) cover_0_p0)) :ruleset Spine-Run :name "impl_3_0_cover_1")
(rule ((Spine-Summary-2 r0 r1 p0) (Spine-Summary-0 r0 p0)) ((subsume (Spine-Summary-0 r0 p0))) :ruleset Spine-Run :name "retire_0")
(rule ((Spine-Summary-2 r0 r1 p0) (Spine-Summary-1 r1 p0)) ((subsume (Spine-Summary-1 r1 p0))) :ruleset Spine-Run :name "retire_1")
(rule ((Spine-Summary-3 r0 r1 p0) (Spine-Summary-0 r0 p0)) ((subsume (Spine-Summary-0 r0 p0))) :ruleset Spine-Run :name "retire_2")
(rule ((Spine-Summary-0 export_root_0 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1)) :ruleset Spine-Export)
(rule ((Spine-Summary-1 export_root_0 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (P export_input_0)) (union export_class_1 (PP export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1)) :ruleset Spine-Export)
(rule ((Spine-Summary-2 export_root_0 export_root_1 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (let export_class_2 (Large export_input_0)) (let export_class_3 (P export_input_0)) (union export_class_3 (PP export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1) (set (Spine-Reified-Term export_root_1) export_class_3)) :ruleset Spine-Export)
(rule ((Spine-Summary-3 export_root_0 export_root_1 p0) (= export_input_0 (Spine-Reified-Term p0))) ((let export_class_1 (A export_input_0)) (union export_class_1 (AA export_input_0)) (let export_class_2 (Other export_input_0)) (let export_class_3 (Q export_input_0)) (set (Spine-Reified-Term export_root_0) export_class_1) (set (Spine-Reified-Term export_root_1) export_class_3)) :ruleset Spine-Export)

; Automatic constructor-level ingress; no scan of a materialized original graph.
(Spine-A (Spine-Leaf "x"))
(Spine-P (Spine-Leaf "x"))
(Spine-Q (Spine-Leaf "x"))
(run-schedule (saturate Spine-Run))
(run-schedule (saturate Spine-Export))
(check (Large (Leaf "x")) (Other (Leaf "x")))
