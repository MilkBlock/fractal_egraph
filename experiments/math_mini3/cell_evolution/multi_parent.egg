(datatype Math (V i64) (A Math) (B Math) (Pair Math Math) (Done Math Math))
(rewrite (A x) (B x))
(rewrite (Pair (B x) (B y)) (Done x y))
(A (V 0))
(A (V 1))
(A (V 2))
(A (V 3))
(A (V 4))
(A (V 5))
(A (V 6))
(A (V 7))
(A (V 8))
(A (V 9))
(A (V 10))
(A (V 11))
(run 2)
(Pair (B (V 0)) (B (V 1)))
(Pair (B (V 2)) (B (V 3)))
(Pair (B (V 4)) (B (V 5)))
(Pair (B (V 6)) (B (V 7)))
(Pair (B (V 8)) (B (V 9)))
(Pair (B (V 10)) (B (V 11)))
