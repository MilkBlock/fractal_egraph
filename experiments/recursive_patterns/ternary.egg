(datatype Math (Seed) (Left Math) (Right Math) (Third Math) (A Math) (B Math))
(A (Seed))
(ruleset a) (ruleset b)
(rule ((= node (A x))) ((B (Left node)) (B (Right node)) (B (Third node))) :ruleset a :name "fork")
(rule ((= node (B x))) ((A node)) :ruleset b :name "return")
(run-schedule (repeat 4 (seq (run a) (run b))))
