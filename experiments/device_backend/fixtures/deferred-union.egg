(datatype T (N i64) (Wrap T) (Combine T T))
(function F (T) T :merge (Combine old new))
(ruleset pure)
(ruleset mixed)
(let a (N 1))
(let b (N 2))
(let c (N 3))
(let d (N 4))
(let k (N 0))
(set (F k) c)
(rule ((= x (N 1)) (= y (N 2))) ((union x y) (Wrap x) (Wrap y)) :ruleset pure)
(rule ((= x (N 3)) (= y (N 4))) ((union x y) (set (F k) y)) :ruleset mixed)
(run pure 1)
(run mixed 1)
(check (= (Wrap a) (Wrap b)))
