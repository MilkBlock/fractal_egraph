; Small math workload: genuine eclasses, shared DAGs and staged equalities.
(datatype Math (Input i64) (Add Math Math) (Mul Math Math))
(ruleset comm) (ruleset distribute) (ruleset factor)
(rewrite (Add a b) (Add b a) :ruleset comm)
(rewrite (Mul a b) (Mul b a) :ruleset comm)
(rewrite (Mul a (Add b c)) (Add (Mul a b) (Mul a c)) :ruleset distribute)
(rewrite (Add (Mul a b) (Mul a c)) (Mul a (Add b c)) :ruleset factor)
(Add (Mul (Input 0) (Add (Input 1) (Input 2))) (Mul (Input 0) (Input 3)))
(Mul (Input 4) (Add (Input 1) (Input 2)))
(run-schedule (repeat 3 (run comm) (run distribute) (run factor)))
