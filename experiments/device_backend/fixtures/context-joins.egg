(datatype T (N i64) (W T))
(relation Edge (T T))
(relation Active (T))
(relation Tag (T i64))
(relation Answer (T T T i64))
(function Cost (T) i64 :merge (min old new))
(ruleset query) (ruleset extend) (ruleset merge) (ruleset hide)
(rule ((Edge x y) (Edge y z) (Tag z k) (Active z) (= n (Cost z)) (< n 10))
      ((Answer x y z n)) :ruleset query)
(rule ((= x (N 0))) ((Edge x (N 3)) (Edge (N 3) (N 2))
      (set (Cost (N 2)) 2)) :ruleset extend)
(rule ((= x (N 1)) (= y (N 3))) ((union x y)) :ruleset merge)
(rule ((= x (N 2))) ((subsume (N 2))) :ruleset hide)
(Edge (N 0) (N 1)) (Edge (N 1) (N 2)) (Edge (N 0) (N 3))
(Active (N 2)) (Tag (N 2) 1) (Tag (N 2) 2) (set (Cost (N 2)) 5)
(run query 1) (run extend 1) (run query 1) (run merge 1)
(run query 2)
(check (Answer (N 0) (N 1) (N 2) 5))
(check (Answer (N 0) (N 3) (N 2) 2))
(run hide 1) (run query 1)
