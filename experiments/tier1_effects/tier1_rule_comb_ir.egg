; Shared rule-combination templates: no concrete values, event IDs or Entry.
(sort Port)
(sort Ports)
(sort Comb)
(sort Parents)
(constructor ParentPort (i64 i64 String) Port)
(constructor External (i64 String) Port)
(constructor Make (String Ports String) Port)
(constructor PNil () Ports)
(constructor PCons (Port Ports) Ports)
(constructor Basic (String) Comb)
(constructor SmoothComb (Parents String Ports) Comb)
(constructor CoarseComb (Parents String Ports) Comb)
(constructor NoParents () Parents)
(constructor MoreParents (Comb Parents) Parents)
; Occurrences and their evidence are a separate layer, never children of Comb.
(datatype Val (V String String))
(datatype Args (ANil) (ACons Val Args))
(datatype Effect (HasFact String Args) (Equal Val Val))
(datatype Effects (ENil) (ECons Effect Effects))
(datatype Instance (Occurrence i64 Comb))
(relation ParentAt (Instance i64 Instance))
(relation OutputAt (Instance i64 Val))
(relation ExternalAt (Instance i64 Val))
(relation ExternalFact (Instance Effect))
(relation Produced (Instance Effect))
(relation Requires (Instance Effects))
(relation Materialized (Instance String Args Val))
(relation Routes (Comb Ports))
(relation ParentList (Comb i64 Parents))
(relation ParentTemplate (Comb i64 Comb))
(relation LinkedParent (Instance i64 Instance))
(relation Resolved (Instance Port Val))
(relation ResolvedArgs (Instance Ports Args))
(relation Binding (Instance Args))
(relation Provides (Instance Effect))
(relation EqAt (Instance Val Val))
(relation ArgsEqual (Instance Args Args))
(relation Satisfies (Instance Effect))
(relation AllSatisfied (Instance Effects))
(relation SupportsUse (Instance Instance))
; Instance-level proposals/certificates, not template equalities.
(relation ProposedRemoval (Instance Instance Instance))
(relation Independent (Instance Instance))
(relation RedundantForUse (Instance Instance Instance))
(ruleset tier1)
(rule ((= c (Basic r))) ((Routes c (PNil))) :ruleset tier1)
(rule ((= c (SmoothComb ps r ports))) ((Routes c ports) (ParentList c 0 ps)) :ruleset tier1)
(rule ((= c (CoarseComb ps r ports))) ((Routes c ports) (ParentList c 0 ps)) :ruleset tier1)
(rule ((ParentList c k (MoreParents p tail))) ((ParentTemplate c k p) (ParentList c (+ k 1) tail)) :ruleset tier1)
(rule ((= i (Occurrence id c)) (ParentAt i k p) (= p (Occurrence pid pc)) (ParentTemplate c k pc)) ((LinkedParent i k p)) :ruleset tier1)
(rule ((LinkedParent i k p) (OutputAt p j v) (= v (V sort key)) (= port (ParentPort k j sort))) ((Resolved i port v)) :ruleset tier1)
(rule ((ExternalAt i k v) (= v (V sort key)) (= port (External k sort))) ((Resolved i port v)) :ruleset tier1)
; Constructed bindings must already have a witness: Make does not create data.
(rule ((= port (Make op ports sort)) (ResolvedArgs i ports args) (Materialized i op args v) (= v (V sort key))) ((Resolved i port v)) :ruleset tier1)
(rule ((= i (Occurrence id c))) ((ResolvedArgs i (PNil) (ANil)) (ArgsEqual i (ANil) (ANil)) (AllSatisfied i (ENil))) :ruleset tier1)
(rule ((= ports (PCons p tail)) (Resolved i p v) (ResolvedArgs i tail args)) ((ResolvedArgs i ports (ACons v args))) :ruleset tier1)
(rule ((= i (Occurrence id c)) (Routes c ports) (ResolvedArgs i ports args)) ((Binding i args)) :ruleset tier1)
(rule ((ExternalFact i e)) ((Provides i e)) :ruleset tier1)
(rule ((Produced i e)) ((Provides i e)) :ruleset tier1)
(rule ((LinkedParent i k p) (Provides p e)) ((Provides i e)) :ruleset tier1)
(rule ((Provides i (Equal (V sort a) (V sort b)))) ((EqAt i (V sort a) (V sort b))) :ruleset tier1)
(rule ((EqAt i a b)) ((EqAt i b a)) :ruleset tier1)
(rule ((EqAt i a b) (EqAt i b c)) ((EqAt i a c)) :ruleset tier1)
(rule ((= xs (ACons x xt)) (= ys (ACons x yt)) (ArgsEqual i xt yt)) ((ArgsEqual i xs ys)) :ruleset tier1)
(rule ((= xs (ACons x xt)) (= ys (ACons y yt)) (EqAt i x y) (ArgsEqual i xt yt)) ((ArgsEqual i xs ys)) :ruleset tier1)
(rule ((= e (HasFact name wanted)) (Provides i (HasFact name actual)) (ArgsEqual i actual wanted)) ((Satisfies i e)) :ruleset tier1)
(rule ((= e (Equal a b)) (EqAt i a b)) ((Satisfies i e)) :ruleset tier1)
(rule ((= es (ECons (Equal a a) tail)) (AllSatisfied i tail)) ((AllSatisfied i es)) :ruleset tier1)
(rule ((= es (ECons e tail)) (Satisfies i e) (AllSatisfied i tail)) ((AllSatisfied i es)) :ruleset tier1)
(rule ((Requires target es) (AllSatisfied provider es)) ((SupportsUse provider target)) :ruleset tier1)
(rule ((SupportsUse replacement old) (ProposedRemoval old replacement removed) (Independent replacement removed)) ((RedundantForUse old replacement removed)) :ruleset tier1)
