; Original program plus visualization-only combined witness bundles.
; Metadata is JSON in line comments; combined ruleset is never scheduled.

; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"term","variants":{"Term":{"fields":["value"],"typst":"Term({value})","precedence":100}}}
(datatype term (Term String))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"nonterm","variants":{"NonTerm":{"fields":["label"],"typst":"NonTerm({label})","precedence":100}}}
(datatype nonterm (NonTerm String))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"tree","variants":{"NT":{"fields":["label","left","right"],"typst":"NT({label}, {left}, {right})","precedence":100},"T":{"fields":["label","value"],"typst":"T({label}, {value})","precedence":100},"B":{"fields":["i","j","nt"]}}}
(datatype tree (NT String tree tree) (T String String))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"getString","variants":{"getString":{"fields":["pos"],"typst":"getString({pos})"}}}
(function getString (i64) String :no-merge)
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"Prod","variants":{"Prod":{"fields":["lhs","mid","rhs"],"typst":"Prod({lhs}, {mid}, {rhs})","precedence":50}}}
(relation Prod (nonterm nonterm nonterm))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"End","variants":{"End":{"fields":["nt","word"],"typst":"End({nt})","precedence":50}}}
(relation End (nonterm String))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"P","variants":{"P":{"fields":["len","start","nt"],"typst":"P({nt})","precedence":50}}}
(relation P (i64 i64 nonterm))
; @egg-viz-json {"schema":"egg-viz/v1","kind":"dsl_type","id":"B","variants":{"B":{"fields":["i","j","nt"]}}}
(constructor B (i64 i64 nonterm) tree :cost 1000)
; @egg-viz-json {"id":"R0","kind":"original_rule","labels":{"bindings":{"a":"terminal category","pos":"word position","s":"input word"},"positions":{"body/0/expr/0":"terminal rule","body/1/expr/1":"input word at position"}},"schema":"egg-viz/v1","statistics":{"committed_unions":26,"complete_witnesses":26,"definition":"(rule ((End (NonTerm a) s)\n       (= s (getString pos)))\n      ((P 1 pos (NonTerm a))\n       (union (B 1 pos (NonTerm a)) (T a s)))\n         )","direct_inserted_rows":64,"matches":26,"survived":26}}
(rule ((End (NonTerm a) s)
       (= s (getString pos)))
      ((P 1 pos (NonTerm a))
       (union (B 1 pos (NonTerm a)) (T a s)))
         )

; @egg-viz-json {"id":"R1","kind":"original_rule","labels":{"bindings":{"a":"parent nonterminal","b":"left nonterminal","c":"right nonterminal","p1":"left span length","p2":"right span length","s":"span start"},"positions":{"body/1/expr/0":"left span fact","body/2/expr/0":"right span fact","head/0/expr/0":"combined span"}},"schema":"egg-viz/v1","statistics":{"committed_unions":0,"complete_witnesses":460,"definition":"(rule ((Prod (NonTerm a) (NonTerm b) (NonTerm c))\n       (P p1 s (NonTerm b))\n       (P p2 (+ s p1) (NonTerm c)))\n      ((P (+ p1 p2) s (NonTerm a)))\n         )","direct_inserted_rows":39,"matches":460,"survived":50}}
(rule ((Prod (NonTerm a) (NonTerm b) (NonTerm c))
       (P p1 s (NonTerm b))
       (P p2 (+ s p1) (NonTerm c)))
      ((P (+ p1 p2) s (NonTerm a)))
         )

; @egg-viz-json {"id":"R2","kind":"original_rule","labels":{"bindings":{"a":"parent nonterminal","b":"left nonterminal","c":"right nonterminal","p1":"left span length","p2":"right span length","s":"span start","f1":"left subtree","f2":"right subtree"},"positions":{"body/1/expr/1":"left subtree lookup","body/2/expr/1":"right subtree lookup","body/1/expr/1/args/2":"left subtree nonterminal","body/2/expr/1/args/2":"right subtree nonterminal"}},"schema":"egg-viz/v1","statistics":{"committed_unions":47,"complete_witnesses":460,"definition":"(rule ((Prod (NonTerm a) (NonTerm b) (NonTerm c))\n       (= f1 (B p1 s (NonTerm b)))\n       (= f2 (B p2 (+ s p1) (NonTerm c))))\n      ((union (B (+ p1 p2) s (NonTerm a)) (NT a f1 f2)))\n         )","direct_inserted_rows":74,"matches":460,"survived":50}}
(rule ((Prod (NonTerm a) (NonTerm b) (NonTerm c))
       (= f1 (B p1 s (NonTerm b)))
       (= f2 (B p2 (+ s p1) (NonTerm c))))
      ((union (B (+ p1 p2) s (NonTerm a)) (NT a f1 f2)))
         )

(push 1)
(set (getString 1) "she")
(set (getString 2) "eats")
(set (getString 3) "a")
(set (getString 4) "fish")
(set (getString 5) "with")
(set (getString 6) "a")
(set (getString 7) "fork")
(Prod (NonTerm "S") (NonTerm "NP") (NonTerm "VP"))
(Prod (NonTerm "VP") (NonTerm "VP") (NonTerm "PP"))
(Prod (NonTerm "VP") (NonTerm "V") (NonTerm "NP"))
(End (NonTerm "VP") "eats")
(Prod (NonTerm "PP") (NonTerm "P") (NonTerm "NP"))
(Prod (NonTerm "NP") (NonTerm "DET") (NonTerm "N"))
(End (NonTerm "NP") "she")
(End (NonTerm "V") "eats")
(End (NonTerm "P") "with")
(End (NonTerm "N") "fish")
(End (NonTerm "N") "fork")
(End (NonTerm "DET") "a")
(run-schedule (repeat 100 (run)))
(let $test1 (B 7 1 (NonTerm "S")))
(check (P 7 1 (NonTerm "S")))
(fail (check (P 7 1 (NonTerm "VP"))))
(fail (check (P 7 1 (NonTerm ""))))
(extract $test1 0)
(pop 1)
(push 1)
(Prod (NonTerm "S") (NonTerm "A") (NonTerm "B"))
(Prod (NonTerm "S") (NonTerm "B") (NonTerm "C"))
(Prod (NonTerm "A") (NonTerm "B") (NonTerm "A"))
(End (NonTerm "A") "a")
(Prod (NonTerm "B") (NonTerm "C") (NonTerm "C"))
(End (NonTerm "B") "b")
(Prod (NonTerm "C") (NonTerm "A") (NonTerm "B"))
(End (NonTerm "C") "a")
(push 1)
(set (getString 1) "a")
(set (getString 2) "b")
(set (getString 3) "a")
(set (getString 4) "a")
(set (getString 5) "b")
(run-schedule (repeat 100 (run)))
(check (P 5 1 (NonTerm "S")))
(fail (check (P 5 1 (NonTerm "B"))))
(let $test2 (B 5 1 (NonTerm "S")))
(extract $test2 10)
(pop 1)
(push 1)
(set (getString 1) "a")
(set (getString 2) "a")
(set (getString 3) "a")
(set (getString 4) "a")
(set (getString 5) "a")
(run-schedule (repeat 100 (run)))
(check (P 5 1 (NonTerm "S")))
(check (P 5 1 (NonTerm "A")))
(fail (check (P 5 1 (NonTerm "B"))))
(fail (check (P 5 1 (NonTerm ""))))
(fail (check (P 5 1 (NonTerm "unrelated"))))
(let $test3 (B 5 1 (NonTerm "S")))
(extract $test3 10)
(pop 1)
