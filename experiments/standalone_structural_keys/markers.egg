(datatype Expr (Leaf i64) (Single Expr) (Get Expr i64))
(function Cost (Expr) i64 :merge new)
(relation Seen0 (Expr Expr)) (relation Seen1 (Expr Expr)) (relation Seen2 (Expr Expr))
(ruleset make) (ruleset use)
(rule ((= s (Single x))) ((union (Get s 0) x)) :ruleset make :name "publisher")
(rule ((= s (Single x)) (= y (Get s 0)) (= c (Cost x)) (< c 10))
 ((Seen0 x y)) :ruleset use :name "consumer0")
(rule ((= s (Single x)) (= y (Get s 0)) (= c (Cost x)) (< c 10))
 ((Seen1 x y)) :ruleset use :name "consumer1")
(rule ((= s (Single x)) (= y (Get s 0)) (= c (Cost x)) (< c 10))
 ((Seen2 x y)) :ruleset use :name "consumer2")

(function Expr-size (Expr) i64 :merge (min old new))
(function to-hoist (Expr Expr) Expr :merge new)
(Single (Leaf 1)) (set (Cost (Leaf 1)) 5)
(run-schedule (saturate (seq (run make) (run use))))
(check (Seen0 (Leaf 1) (Leaf 1)) (Seen1 (Leaf 1) (Leaf 1)) (Seen2 (Leaf 1) (Leaf 1)))
