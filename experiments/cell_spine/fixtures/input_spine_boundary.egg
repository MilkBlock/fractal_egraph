(datatype Term (Leaf String) (Add Term Term) (Use Term) (Seen Term Term))
(ruleset algebra)
(rewrite (Add a b) (Add b a) :ruleset algebra)
(rewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset algebra)
(rewrite (Add a (Add b c)) (Add (Add a b) c) :ruleset algebra)
(rule ((Use (Add a b))) ((Seen a b)) :ruleset algebra)
(let inner (Add (Leaf "a") (Leaf "b")))
(let root (Add inner (Leaf "c")))
(Use inner)
(let held_inner (Add (Leaf "d") (Leaf "e")))
(let held_root (Add held_inner (Leaf "f")))
(run-schedule (saturate algebra))
(check (Seen (Leaf "a") (Leaf "b")))
