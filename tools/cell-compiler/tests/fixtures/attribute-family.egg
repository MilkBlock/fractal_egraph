(datatype E (Leaf i64) (Wrap E) (Pair E E))
(function weight (E) i64 :merge (min old new))
(function height (E) i64 :merge (max old new))
(ruleset propagate) (ruleset wake) (ruleset retire) (ruleset restore)
(rule ((= p (Wrap a)) (= x (weight a))) ((set (weight p) x)) :ruleset propagate :name "wrap-weight")
(rule ((= p (Pair a b)) (= x (weight a)) (= y (weight b)))
      ((set (weight p) (+ x y))) :ruleset propagate :name "pair-weight")
(rule ((= p (Wrap a)) (= x (height a))) ((set (height p) (+ x 1))) :ruleset propagate :name "wrap-height")
(rule ((= p (Pair a b)) (= x (weight b)))
      ((set (weight p) x) (set (height p) 42)) :ruleset propagate :name "two-writes")
(rule ((= a (Leaf 0))) ((set (weight a) -8)) :ruleset wake)
(rule ((= b (Leaf 1))) ((delete (weight b))) :ruleset retire)
(rule ((= b (Leaf 1))) ((set (weight b) -9)) :ruleset restore)
(Leaf 0) (Leaf 1) (Wrap (Leaf 0)) (Wrap (Leaf 1))
(union (Wrap (Leaf 0)) (Wrap (Leaf 1)))
(Pair (Leaf 0) (Leaf 1)) (Pair (Leaf 1) (Leaf 1))
(set (weight (Leaf 0)) 7) (set (weight (Leaf 1)) -3) (set (height (Leaf 1)) -2)
(run-schedule (seq (run propagate) (run retire) (run wake) (run propagate) (run restore) (run propagate)))
(check (= (weight (Wrap (Leaf 0))) -9) (= (weight (Pair (Leaf 0) (Leaf 1))) -17))
