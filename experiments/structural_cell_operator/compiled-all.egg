; Extracted symbolic interface. Boundary constructors are opaque, not recovered original terms.
(datatype Math (Diff Math Math) (Integral Math Math) (Add Math Math) (Sub Math Math) (Mul Math Math) (Div Math Math) (Pow Math Math) (Ln Math) (Sqrt Math) (Sin Math) (Cos Math) (Const i64) (Var String) (RipenInput i64))
(rule ((= __viz_root (Add a b)))
      ((union __viz_root (Add b a)))
         :name "R0")
(rule ((= __viz_root (Mul a b)))
      ((union __viz_root (Mul b a)))
         :name "R1")
(rule ((= __viz_root (Add a (Add b c))))
      ((union __viz_root (Add (Add a b) c)))
         :name "R2")
(rule ((= __viz_root (Mul a (Mul b c))))
      ((union __viz_root (Mul (Mul a b) c)))
         :name "R3")
(rule ((= __viz_root (Sub a b)))
      ((union __viz_root (Add a (Mul (Const -1) b))))
         :name "R4")
(rule ((= __viz_root (Add a (Const 0))))
      ((union __viz_root a))
         :name "R5")
(rule ((= __viz_root (Mul a (Const 0))))
      ((union __viz_root (Const 0)))
         :name "R6")
(rule ((= __viz_root (Mul a (Const 1))))
      ((union __viz_root a))
         :name "R7")
(rule ((= __viz_root (Sub a a)))
      ((union __viz_root (Const 0)))
         :name "R8")
(rule ((= __viz_root (Mul a (Add b c))))
      ((union __viz_root (Add (Mul a b) (Mul a c))))
         :name "R9")
(rule ((= __viz_root (Add (Mul a b) (Mul a c))))
      ((union __viz_root (Mul a (Add b c))))
         :name "R10")
(rule ((= __viz_root (Mul (Pow a b) (Pow a c))))
      ((union __viz_root (Pow a (Add b c))))
         :name "R11")
(rule ((= __viz_root (Pow x (Const 1))))
      ((union __viz_root x))
         :name "R12")
(rule ((= __viz_root (Pow x (Const 2))))
      ((union __viz_root (Mul x x)))
         :name "R13")
(rule ((= __viz_root (Diff x (Add a b))))
      ((union __viz_root (Add (Diff x a) (Diff x b))))
         :name "R14")
(rule ((= __viz_root (Diff x (Mul a b))))
      ((union __viz_root (Add (Mul a (Diff x b)) (Mul b (Diff x a)))))
         :name "R15")
(rule ((= __viz_root (Diff x (Sin x))))
      ((union __viz_root (Cos x)))
         :name "R16")
(rule ((= __viz_root (Diff x (Cos x))))
      ((union __viz_root (Mul (Const -1) (Sin x))))
         :name "R17")
(rule ((= __viz_root (Integral (Const 1) x)))
      ((union __viz_root x))
         :name "R18")
(rule ((= __viz_root (Integral (Cos x) x)))
      ((union __viz_root (Sin x)))
         :name "R19")
(rule ((= __viz_root (Integral (Sin x) x)))
      ((union __viz_root (Mul (Const -1) (Cos x))))
         :name "R20")
(rule ((= __viz_root (Integral (Add f g) x)))
      ((union __viz_root (Add (Integral f x) (Integral g x))))
         :name "R21")
(rule ((= __viz_root (Integral (Sub f g) x)))
      ((union __viz_root (Sub (Integral f x) (Integral g x))))
         :name "R22")
(rule ((= __viz_root (Integral (Mul a b) x)))
      ((union __viz_root (Sub (Mul a (Integral b x)) (Integral (Mul (Diff x a) (Integral b x)) x))))
         :name "R23")

; Matrix-selected structural effect. No rule schedule.
(let structural_class_0 (RipenInput 3))
(let structural_class_1 (RipenInput 0))
(let structural_class_6 (Const 2))
(let structural_class_2 (RipenInput 1))
(union structural_class_2 (Pow structural_class_0 structural_class_6))
(union structural_class_2 (Mul structural_class_0 structural_class_0))
(let structural_class_3 (RipenInput 2))
(let structural_class_9 (Mul structural_class_0 structural_class_1))
(union structural_class_9 (Mul structural_class_1 structural_class_0))
(let structural_class_4 (Mul structural_class_0 structural_class_9))
(union structural_class_4 (Mul structural_class_1 structural_class_2))
(union structural_class_4 (Mul structural_class_2 structural_class_1))
(union structural_class_4 (Mul structural_class_9 structural_class_0))
(let structural_class_7 (Const -1))
(let structural_class_10 (Mul structural_class_1 structural_class_7))
(union structural_class_10 (Mul structural_class_7 structural_class_1))
(let structural_class_13 (Mul structural_class_0 structural_class_7))
(union structural_class_13 (Mul structural_class_7 structural_class_0))
(let structural_class_11 (Mul structural_class_0 structural_class_13))
(union structural_class_11 (Mul structural_class_13 structural_class_0))
(union structural_class_11 (Mul structural_class_2 structural_class_7))
(union structural_class_11 (Mul structural_class_7 structural_class_2))
(let structural_class_12 (Mul structural_class_0 structural_class_10))
(union structural_class_12 (Mul structural_class_1 structural_class_13))
(union structural_class_12 (Mul structural_class_10 structural_class_0))
(union structural_class_12 (Mul structural_class_13 structural_class_1))
(union structural_class_12 (Mul structural_class_7 structural_class_9))
(union structural_class_12 (Mul structural_class_9 structural_class_7))
(let structural_class_8 (Mul structural_class_0 structural_class_12))
(union structural_class_8 (Mul structural_class_1 structural_class_11))
(union structural_class_8 (Mul structural_class_10 structural_class_2))
(union structural_class_8 (Mul structural_class_11 structural_class_1))
(union structural_class_8 (Mul structural_class_12 structural_class_0))
(union structural_class_8 (Mul structural_class_13 structural_class_9))
(union structural_class_8 (Mul structural_class_2 structural_class_10))
(union structural_class_8 (Mul structural_class_4 structural_class_7))
(union structural_class_8 (Mul structural_class_7 structural_class_4))
(union structural_class_8 (Mul structural_class_9 structural_class_13))
(let structural_class_5 (Sub structural_class_3 structural_class_4))
(union structural_class_5 (Add structural_class_3 structural_class_8))
(union structural_class_5 (Add structural_class_8 structural_class_3))
