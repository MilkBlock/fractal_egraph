digraph G {
graph [rankdir=LR,bgcolor="#fafaf7",pad=0.3,nodesep=0.45,ranksep=0.8];
node [fontname="Arial",fontsize=12,shape=box,style="rounded,filled",color="#62706f"];
edge [fontname="Arial",fontsize=10,color="#637577"];
label="局部支撑补充前 · Rule-comb 上下文 / effect 视图";labelloc=t;fontsize=20;
c0 [label="C0 · Entry",fillcolor="#edf0fa"];
e0_given_0 [label="P(0)",shape=note,fillcolor="#edf0fa"];
c0 -> e0_given_0 [style=dotted,label="given"];
c1 [label="C1 · Entry",fillcolor="#edf0fa"];
e1_given_0 [label="Q(1)",shape=note,fillcolor="#edf0fa"];
c1 -> e1_given_0 [style=dotted,label="given"];
c2 [label="C2 · Join",fillcolor="#edf0fa"];
c0 -> c2 [label="ctx 0"];
c1 -> c2 [label="ctx 1"];
c3 [label="C3 · R\nv0=0, v1=1",fillcolor="#dcefe5"];
c2 -> c3 [label="ctx 0"];
e3_requires_0 [label="P(0)",shape=note,fillcolor="#edf0fa"];
e3_requires_0 -> c3 [style=dashed,label="requires"];
e3_requires_1 [label="Q(1)",shape=note,fillcolor="#edf0fa"];
e3_requires_1 -> c3 [style=dashed,label="requires"];
e3_produces_0 [label="T(1)",shape=note,fillcolor="#edf0fa"];
c3 -> e3_produces_0 [style=dotted,label="produces"];
}
