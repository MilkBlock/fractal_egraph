(datatype Term (N i64) (Wrap Term) (Done Term))
(relation Ready (Term))
(relation Seen (Term))
(function Cost (Term) i64 :merge (min old new))
(ruleset make)
(rule ((= x (N 1))) ((Ready x) (Wrap x) (set (Cost x) 9)) :ruleset make)
(ruleset lower)
(rule ((Ready x) (= n (Cost x)) (> n 3)) ((set (Cost x) 3)) :ruleset lower)
(ruleset alias)
(rule ((= x (N 1)) (= y (N 2))) ((union x y)) :ruleset alias)
(ruleset finish)
(rule ((= (Wrap x) w) (= x (N 2)) (= n (Cost x)) (<= n 3)) ((Done w) (Seen w)) :ruleset finish)
(ruleset hide)
(rule ((Seen w) (= w (Wrap x))) ((subsume (Wrap x))) :ruleset hide)
(N 1)
(N 2)
(Wrap (N 2))
(set (Cost (N 2)) 7)
(run make 1)
(run lower 1)
(run alias 1)
(run finish 1)
(run hide 1)
(run finish 1)
