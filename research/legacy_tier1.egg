; Historical standalone Tier1 interpreter; not loaded by native analysis.
; Shared rule-combination templates: no concrete values, event IDs or Entry.
(datatype RuleId (Rule String))
(sort LocalPort)
(sort RelativeBinding)
(sort PartialPort)
(sort PartialRelativeBinding)
(sort Comb)
(sort ParentCombs)
(constructor ParentPort (i64 i64 String) LocalPort)
(constructor Make (String RelativeBinding String) LocalPort)
(constructor RNil () RelativeBinding)
(constructor RCons (LocalPort RelativeBinding) RelativeBinding)
(constructor Local (LocalPort) PartialPort)
(constructor External (i64 String) PartialPort)
(constructor MakePartial (String PartialRelativeBinding String) PartialPort)
(constructor PNil () PartialRelativeBinding)
(constructor PCons (PartialPort PartialRelativeBinding) PartialRelativeBinding)
(constructor Empty () Comb)
(constructor SmoothRuleComposition (ParentCombs RuleId RelativeBinding) Comb)
(constructor CoarseRuleComposition (ParentCombs RuleId PartialRelativeBinding) Comb)
(constructor NoParents () ParentCombs)
(constructor MoreParents (Comb ParentCombs) ParentCombs)
; Occurrences and their evidence are a separate layer, never children of Comb.
(datatype Val (V String String))
(datatype Args (ANil) (ACons Val Args))
; RowFact identifies one committed row version (or one exact boundary row).
; Its opaque token is not an expression subject to EqAt rewriting.
(datatype Effect (HasFact String Args) (Equal Val Val) (RowFact Val))
(datatype Effects (ENil) (ECons Effect Effects))
(datatype Instance (Occurrence i64 Comb))
(relation ParentAt (Instance i64 Instance))
(relation OutputAt (Instance i64 Val))
(relation ExternalAt (Instance i64 Val))
(relation ExternalFact (Instance Effect))
(relation Produced (Instance Effect))
(relation Requires (Instance Effects))
(relation Materialized (Instance String Args Val))
(relation LocalRoutes (Comb RelativeBinding))
(relation PartialRoutes (Comb PartialRelativeBinding))
(relation ParentList (Comb i64 ParentCombs))
(relation ParentTemplate (Comb i64 Comb))
(relation LinkedParent (Instance i64 Instance))
(relation LocalResolved (Instance LocalPort Val))
(relation LocalArgs (Instance RelativeBinding Args))
(relation PartialResolved (Instance PartialPort Val))
(relation PartialArgs (Instance PartialRelativeBinding Args))
(relation Binding (Instance Args))
(relation Provides (Instance Effect))
(relation EqAt (Instance Val Val))
(relation ArgsEqual (Instance Args Args))
(relation Satisfies (Instance Effect))
(relation AllSatisfied (Instance Effects))
(relation QueryUse (Instance Instance))
(relation NeedList (Instance Effects))
(relation NeedEffect (Instance Effect))
(relation NeedArgs (Instance Args Args))
(relation SupportsUse (Instance Instance))
; Instance-level proposals/certificates, not template equalities.
(relation ProposedRemoval (Instance Instance Instance))
(relation Independent (Instance Instance))
(relation RedundantForUse (Instance Instance Instance))
(ruleset tier1)
(rule ((= c (Empty))) ((LocalRoutes c (RNil))) :ruleset tier1)
(rule ((= c (SmoothRuleComposition ps r ports))) ((LocalRoutes c ports) (ParentList c 0 ps)) :ruleset tier1)
(rule ((= c (CoarseRuleComposition ps r ports))) ((PartialRoutes c ports) (ParentList c 0 ps)) :ruleset tier1)
(rule ((ParentList c k (MoreParents p tail))) ((ParentTemplate c k p) (ParentList c (+ k 1) tail)) :ruleset tier1)
(rule ((= i (Occurrence id c)) (ParentAt i k p) (= p (Occurrence pid pc)) (ParentTemplate c k pc)) ((LinkedParent i k p)) :ruleset tier1)
; Resolve only the binding DAG actually referenced by this occurrence.
(relation NeedLocalRoute (Instance RelativeBinding))
(relation NeedPartialRoute (Instance PartialRelativeBinding))
(relation NeedLocalPort (Instance LocalPort))
(relation NeedPartialPort (Instance PartialPort))
(rule ((= i (Occurrence id c)) (LocalRoutes c ports)) ((NeedLocalRoute i ports)) :ruleset tier1)
(rule ((= i (Occurrence id c)) (PartialRoutes c ports)) ((NeedPartialRoute i ports)) :ruleset tier1)
(rule ((NeedLocalRoute i (RCons p tail))) ((NeedLocalPort i p) (NeedLocalRoute i tail)) :ruleset tier1)
(rule ((NeedPartialRoute i (PCons p tail))) ((NeedPartialPort i p) (NeedPartialRoute i tail)) :ruleset tier1)
(rule ((NeedLocalPort i (Make op ports sort))) ((NeedLocalRoute i ports)) :ruleset tier1)
(rule ((NeedPartialPort i (Local p))) ((NeedLocalPort i p)) :ruleset tier1)
(rule ((NeedPartialPort i (MakePartial op ports sort))) ((NeedPartialRoute i ports)) :ruleset tier1)
; Materialize selective keys once, rather than repeatedly joining V by sort.
(relation NeededParentPort (Instance i64 i64 String LocalPort))
(relation TypedOutputAt (Instance i64 String Val))
(rule ((NeedLocalPort i port) (= port (ParentPort k j sort))) ((NeededParentPort i k j sort port)) :ruleset tier1)
(rule ((OutputAt p j v) (= v (V sort key))) ((TypedOutputAt p j sort v)) :ruleset tier1)
(rule ((NeededParentPort i k j sort port) (LinkedParent i k p) (TypedOutputAt p j sort v)) ((LocalResolved i port v)) :ruleset tier1)
(rule ((NeedLocalPort i port) (= port (Make op ports sort)) (LocalArgs i ports args) (Materialized i op args v) (= v (V sort key))) ((LocalResolved i port v)) :ruleset tier1)
(rule ((NeedPartialPort i port) (= port (Local local)) (LocalResolved i local v)) ((PartialResolved i port v)) :ruleset tier1)
(rule ((NeedPartialPort i port) (= port (External k sort)) (ExternalAt i k v) (= v (V sort key))) ((PartialResolved i port v)) :ruleset tier1)
(rule ((NeedPartialPort i port) (= port (MakePartial op ports sort)) (PartialArgs i ports args) (Materialized i op args v) (= v (V sort key))) ((PartialResolved i port v)) :ruleset tier1)
(rule ((NeedLocalRoute i (RNil))) ((LocalArgs i (RNil) (ANil))) :ruleset tier1)
(rule ((NeedPartialRoute i (PNil))) ((PartialArgs i (PNil) (ANil))) :ruleset tier1)
(rule ((NeedLocalRoute i ports) (= ports (RCons p tail)) (LocalResolved i p v) (LocalArgs i tail args)) ((LocalArgs i ports (ACons v args))) :ruleset tier1)
(rule ((NeedPartialRoute i ports) (= ports (PCons p tail)) (PartialResolved i p v) (PartialArgs i tail args)) ((PartialArgs i ports (ACons v args))) :ruleset tier1)
(rule ((= i (Occurrence id c)) (LocalRoutes c ports) (LocalArgs i ports args)) ((Binding i args)) :ruleset tier1)
(rule ((= i (Occurrence id c)) (PartialRoutes c ports) (PartialArgs i ports args)) ((Binding i args)) :ruleset tier1)
(rule ((ExternalFact i e)) ((Provides i e)) :ruleset tier1)
(rule ((Produced i e)) ((Provides i e)) :ruleset tier1)
(rule ((LinkedParent i k p) (Provides p e)) ((Provides i e)) :ruleset tier1)
(rule ((Provides i (Equal (V sort a) (V sort b)))) ((EqAt i (V sort a) (V sort b))) :ruleset tier1)
(rule ((EqAt i a b)) ((EqAt i b a)) :ruleset tier1)
(rule ((EqAt i a b) (EqAt i b c)) ((EqAt i a c)) :ruleset tier1)
(rule ((NeedArgs i xs ys) (= xs (ACons x xt)) (= ys (ACons x yt)) (ArgsEqual i xt yt)) ((ArgsEqual i xs ys)) :ruleset tier1)
(rule ((NeedArgs i xs ys) (= xs (ACons x xt)) (= ys (ACons y yt)) (EqAt i x y) (ArgsEqual i xt yt)) ((ArgsEqual i xs ys)) :ruleset tier1)
(rule ((NeedEffect i e) (= e (HasFact name wanted)) (Provides i (HasFact name actual)) (ArgsEqual i actual wanted)) ((Satisfies i e)) :ruleset tier1)
(rule ((NeedEffect i e) (= e (Equal a b)) (EqAt i a b)) ((Satisfies i e)) :ruleset tier1)
(rule ((NeedList i es) (= es (ECons (Equal a a) tail)) (AllSatisfied i tail)) ((AllSatisfied i es)) :ruleset tier1)
(rule ((NeedList i es) (= es (ECons e tail)) (Satisfies i e) (AllSatisfied i tail)) ((AllSatisfied i es)) :ruleset tier1)
(rule ((Requires target es) (AllSatisfied provider es)) ((SupportsUse provider target)) :ruleset tier1)
(rule ((SupportsUse replacement old) (ProposedRemoval old replacement removed) (Independent replacement removed)) ((RedundantForUse old replacement removed)) :ruleset tier1)

; Representation equivalence INSIDE partial bindings, preserving the Coarse tag.
; Local ports alone do not certify absence of external effect requirements.
; Only a partial binding made entirely of local structure can be converted.
(relation LocalPart (PartialPort LocalPort))
(relation ToLocal (PartialRelativeBinding RelativeBinding))
(relation LocalBindingView (Comb RelativeBinding))
(ruleset tier1_equivalences)
(rule ((= p (PNil))) ((ToLocal p (RNil))) :ruleset tier1_equivalences)
(rule ((= p (Local l))) ((LocalPart p l)) :ruleset tier1_equivalences)
(rule ((= p (MakePartial op args sort)) (ToLocal args local)) ((LocalPart p (Make op local sort)) (union p (Local (Make op local sort)))) :ruleset tier1_equivalences)
(rule ((= p (PCons h tail)) (LocalPart h local) (ToLocal tail rest)) ((ToLocal p (RCons local rest))) :ruleset tier1_equivalences)
(rule ((= c (CoarseRuleComposition parents rule binding)) (ToLocal binding local)) ((LocalBindingView c local)) :ruleset tier1_equivalences)

; Demand-driven support queries avoid Instance x all-Args Cartesian products.
(rule ((Requires i es)) ((QueryUse i i)) :ruleset tier1)
(rule ((ProposedRemoval old replacement removed)) ((QueryUse replacement old)) :ruleset tier1)
(rule ((QueryUse provider target) (Requires target es)) ((NeedList provider es)) :ruleset tier1)
(rule ((NeedList i (ENil))) ((AllSatisfied i (ENil))) :ruleset tier1)
(rule ((NeedList i (ECons e tail))) ((NeedEffect i e) (NeedList i tail)) :ruleset tier1)
(rule ((NeedEffect i (HasFact name wanted)) (Provides i (HasFact name actual))) ((NeedArgs i actual wanted)) :ruleset tier1)
(rule ((NeedArgs i (ANil) (ANil))) ((ArgsEqual i (ANil) (ANil))) :ruleset tier1)
(rule ((NeedArgs i (ACons x xt) (ACons x yt))) ((NeedArgs i xt yt)) :ruleset tier1)
(rule ((NeedArgs i (ACons x xt) (ACons y yt)) (EqAt i x y)) ((NeedArgs i xt yt)) :ruleset tier1)

; Exact row identities join directly, without generic argument-pair enumeration.
(rule ((NeedEffect i e) (= e (RowFact row)) (Provides i e)) ((Satisfies i e)) :ruleset tier1)
