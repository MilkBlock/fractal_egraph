(datatype T (N i64) (W T) (P T) (Q T))
(function Cost (T) i64 :merge (min old new))
(relation Witness (T i64))
(ruleset seed)
(ruleset effect)
(Witness (N 0) 0)
(rule ((Witness x n) (< n 63)) ((Witness x (+ n 1))) :ruleset seed)
; n distinguishes real LHS bindings but does not affect any RHS operation.
(rule ((Witness x n))
      ((W x) (set (Cost x) 7) (union (P x) (Q x)) (subsume (W x)))
      :ruleset effect :naive)
(run-schedule (saturate seed))
(run effect 1)
(run effect 1)
(run effect 1)
(check (= (P (N 0)) (Q (N 0))))
(check (= (Cost (N 0)) 7))
