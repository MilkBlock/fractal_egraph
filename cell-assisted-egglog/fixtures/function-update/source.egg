(datatype Expr (Leaf i64) (Single Expr) (Get Expr i64))
(function Best (Expr) i64 :merge (min old new))
(relation Proposal (Expr Expr i64))
(rule ((Single expr))
      ((union (Get (Single expr) 0) expr)) :name "single-get")
(rule ((Proposal dst (Single x) cost) (= old (Best dst)))
      ((set (Best dst) cost) (union (Get dst 0) x)) :name "improve")
(Single (Leaf 1))
(set (Best (Leaf 10)) 10)
(Proposal (Leaf 10) (Single (Leaf 1)) 3)
(run 3)
(check (= (Best (Leaf 10)) 3))
