; Real terms Bop / helper semantics; V and TermLeaf are external input ports.
(datatype Op (Add) (Mul))
(datatype Expr (V i64) (Bop Op Expr Expr))
(datatype Term (TermLeaf i64) (TermBop Op Term Term) (NoTerm))
(datatype TermAndCost (TCPair Term i64) (Smaller TermAndCost TermAndCost))
(function ExtractedExpr (Expr) TermAndCost :merge (Smaller old new) :unextractable)
(sort ___PotentialExtractedExprSort)
(constructor PotentialExtractedExpr (Expr TermAndCost) ___PotentialExtractedExprSort)
(ruleset terms)
(ruleset terms-helpers)
(ruleset terms-helpers-helpers)
(rule ((= lhs (Bop o e1 e2))
       (= (TCPair t1 c1) (ExtractedExpr e1))
       (= (TCPair t2 c2) (ExtractedExpr e2)))
      ((PotentialExtractedExpr lhs (TCPair (TermBop o t1 t2) (+ 1 (+ c1 c2)))))
      :ruleset terms :name "bop")
(rule ((PotentialExtractedExpr expr termandcost))
      ((set (ExtractedExpr expr) (TCPair (NoTerm) 10000000000000000)))
      :ruleset terms-helpers :name "init")
(rule ((PotentialExtractedExpr expr (TCPair term cost))
       (= (ExtractedExpr expr) (TCPair oldterm oldcost)) (< cost oldcost))
      ((set (ExtractedExpr expr) (TCPair term cost)))
      :ruleset terms-helpers :name "improve")
(rule ((PotentialExtractedExpr expr (TCPair term cost)) (< cost 0))
      ((panic "Negative cost")) :ruleset terms-helpers :name "negative")
(rule ((= lhs (Smaller (TCPair t1 cost1) (TCPair t2 cost2))) (< cost1 cost2))
      ((union lhs (TCPair t1 cost1))) :ruleset terms-helpers-helpers :name "less")
(rule ((= lhs (Smaller (TCPair t1 cost1) (TCPair t2 cost2))) (> cost1 cost2))
      ((union lhs (TCPair t2 cost2))) :ruleset terms-helpers-helpers :name "greater")
(rule ((= lhs (Smaller (TCPair t1 cost1) (TCPair t2 cost2))) (= cost1 cost2))
      ((union lhs (TCPair t1 cost1))) :ruleset terms-helpers-helpers :name "tie")


      (set (ExtractedExpr (V 0)) (TCPair (TermLeaf 10) 100))
      (set (ExtractedExpr (V 1)) (TCPair (TermLeaf 11) 9))
      (set (ExtractedExpr (V 2)) (TCPair (TermLeaf 12) 4))
      (Bop (Add) (V 0) (V 1))
      (Bop (Mul) (Bop (Add) (V 0) (V 1)) (V 2))
      (Bop (Add) (V 3) (V 2))

(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
