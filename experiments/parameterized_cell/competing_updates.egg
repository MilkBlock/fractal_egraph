; Append to terms.egg. The example exports a standalone program.egg.
; p has two producer shapes: Add(x,y) and Mul(u,v).
; q depends on p. The independent Mul(V7,V8) should remain untouched.
(set (ExtractedExpr (V 0)) (TCPair (TermLeaf 0) 7))
(set (ExtractedExpr (V 1)) (TCPair (TermLeaf 1) 4))
(set (ExtractedExpr (V 2)) (TCPair (TermLeaf 2) 4))
(set (ExtractedExpr (V 3)) (TCPair (TermLeaf 3) 5))
(set (ExtractedExpr (V 7)) (TCPair (TermLeaf 7) 1))
(set (ExtractedExpr (V 8)) (TCPair (TermLeaf 8) 1))
(union (Bop (Add) (V 0) (V 1)) (Bop (Mul) (V 2) (V 3)))
(Bop (Add) (Bop (Add) (V 0) (V 1)) (V 1))
(Bop (Mul) (V 7) (V 8))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (= (ExtractedExpr (Bop (Add) (V 0) (V 1)))
          (TCPair (TermBop (Mul) (TermLeaf 2) (TermLeaf 3)) 10)))

; An external candidate improves x, then p and q.
(PotentialExtractedExpr (V 0) (TCPair (TermLeaf 20) 2))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (= (ExtractedExpr (Bop (Add) (V 0) (V 1)))
          (TCPair (TermBop (Add) (TermLeaf 20) (TermLeaf 1)) 7)))
(check (= (ExtractedExpr (Bop (Add) (Bop (Add) (V 0) (V 1)) (V 1)))
          (TCPair (TermBop (Add) (TermBop (Add) (TermLeaf 20) (TermLeaf 1)) (TermLeaf 1)) 12)))
; The old candidate remains a fact.
(check (PotentialExtractedExpr (Bop (Add) (V 0) (V 1))
         (TCPair (TermBop (Add) (TermLeaf 0) (TermLeaf 1)) 12)))

; Worse candidates do not improve the selected result.
(PotentialExtractedExpr (V 0) (TCPair (TermLeaf 21) 9))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (= (ExtractedExpr (V 0)) (TCPair (TermLeaf 20) 2)))

; Reuse the same wiring for a second improvement.
(PotentialExtractedExpr (V 0) (TCPair (TermLeaf 30) 1))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (= (ExtractedExpr (Bop (Add) (V 0) (V 1)))
          (TCPair (TermBop (Add) (TermLeaf 30) (TermLeaf 1)) 6)))

; Rebuild changes keys and makes both input ports aliases.
(union (V 0) (V 1))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (= (ExtractedExpr (Bop (Add) (V 0) (V 1)))
          (TCPair (TermBop (Add) (TermLeaf 30) (TermLeaf 30)) 3)))

; A previously unique output now has two alternatives. Keep both cross terms.
(union (TCPair (TermLeaf 30) 1) (TCPair (TermLeaf 31) 1))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(check (PotentialExtractedExpr (Bop (Add) (V 0) (V 1))
         (TCPair (TermBop (Add) (TermLeaf 30) (TermLeaf 31)) 3)))
(check (PotentialExtractedExpr (Bop (Add) (V 0) (V 1))
         (TCPair (TermBop (Add) (TermLeaf 31) (TermLeaf 30)) 3)))
(check (= (ExtractedExpr (Bop (Mul) (V 7) (V 8)))
          (TCPair (TermBop (Mul) (TermLeaf 7) (TermLeaf 8)) 3)))

; No changes: no new matching work or effect replay.
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
