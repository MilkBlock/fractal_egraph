(include "rules/tier2.egg")
(let n (ECount "N"))
(let domain (FiniteDomain n))
(let x (InputArray "x" domain))
(let expfn (ScalarLambda (BExp (BParam 0)) (BNil)))
(let sum-ramp (ReduceArray (SumReduction) (RampArray domain (EInt 1) (EInt 1))))
(let sum-exp-zero (ReduceArray (SumReduction) (MapArray expfn (FillArray domain (EInt 0)))))
(let fused (ReduceArray (SumReduction) (MapArray expfn x)))
(let maximum (ReduceArray (MaxReduction) x))
(TryBlock x 16)
(ArrayExample "sum-1-to-N" sum-ramp)
(ArrayExample "sum-exp-zero" sum-exp-zero)
(ArrayExample "fused-exp-sum" fused)
(ArrayExample "block-max" maximum)
(run-schedule (saturate (seq (run endpoint-reduce) (run array-shape) (run array-laws) (run array-eval))))
(check (= sum-exp-zero n))
(check (= fused (FoldMap (SumReduction) expfn x)))
(check (= maximum (ReduceBlocks (MaxReduction) (Blocks x 16))))
(check (BlockDomain (Blocks x 16) (FiniteDomain (ECeilDiv n 16))))
