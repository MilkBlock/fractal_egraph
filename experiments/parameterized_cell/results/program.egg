(set (ExtractedExpr (V 0)) (TCPair (TermLeaf 22) 80))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(set (ExtractedExpr (V 3)) (TCPair (TermLeaf 13) 7))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(union (V 0) (V 1))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(Bop (Mul) (V 0) (V 3))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
(union (TCPair (TermLeaf 11) 9) (TCPair (TermLeaf 99) 9))
(run-schedule (saturate (seq terms (saturate (seq terms-helpers (saturate terms-helpers-helpers))))))
