; Tier-2 extension descriptions. Concrete occurrence IDs are outside hashcons keys.
(sort Route)
(sort Routes)
(constructor ParentRole (i64 String String) Route)
(constructor Outside (i64 String) Route)
(constructor Construct (String Routes String) Route)
(constructor End () Routes)
(constructor Next (Route Routes) Routes)
(datatype RuleSchema (Schema String))
(datatype Extension (Extend String Routes RuleSchema))
(relation At (i64 Extension))
(relation Before (i64 i64 i64))
; Repeat is a witnessed homogeneous path, not an equivalence or infinite closure.
(relation Repeat (i64 i64 Extension i64 i64))
(ruleset tier2)
(rule ((At a f) (At b f) (Before a b slot) (< a b))
      ((Repeat a b f slot 2)) :ruleset tier2 :name "repeat-seed")
(rule ((Repeat a b f slot n) (Before b c slot) (< b c) (At c f))
      ((Repeat a c f slot (+ n 1))) :ruleset tier2 :name "repeat-extend")

; These equalities concern coordinate maps only, never complete execution effects.
(datatype Translation (Translate i64 i64) (Compose Translation Translation) (Power Translation i64))
(rewrite (Compose (Translate x y) (Translate u v)) (Translate (+ x u) (+ y v))
 :ruleset tier2 :name "compose-translations")
(rewrite (Power (Translate x y) k) (Translate (* x k) (* y k))
 :when ((>= k 0)) :ruleset tier2 :name "iterate-translation")
(relation PreservesLinear (Translation i64 i64))
(relation CheckLinear (Translation i64 i64))
(rule ((CheckLinear (Translate x y) a b) (= 0 (+ (* a x) (* b y))))
 ((PreservesLinear (Translate x y) a b)) :ruleset tier2 :name "linear-invariant")
(relation Proposed (String Translation))
(relation Sample (String i64 i64 i64 i64))
(relation Fits (String i64 i64 i64 i64))
(relation Counterexample (String i64 i64 i64 i64))
(rule ((Proposed s (Translate dm da)) (Sample s m a m2 a2)
       (= m2 (+ m dm)) (= a2 (+ a da)))
      ((Fits s m a m2 a2)) :ruleset tier2 :name "translation-fit")
(rule ((Proposed s (Translate dm da)) (Sample s m a m2 a2)
       (!= m2 (+ m dm)))
      ((Counterexample s m a m2 a2)) :ruleset tier2 :name "translation-counterexample-m")
(rule ((Proposed s (Translate dm da)) (Sample s m a m2 a2)
       (!= a2 (+ a da)))
      ((Counterexample s m a m2 a2)) :ruleset tier2 :name "translation-counterexample-a")

; A change of extension is observational; it is not proof that an operator exhausted.
(relation NeedsBoundary (Extension))
(relation InjectionEdge (i64 i64 i64))
(rule ((Before a b slot) (At b f) (NeedsBoundary f))
      ((InjectionEdge a b slot)) :ruleset tier2 :name "boundary-edge")
