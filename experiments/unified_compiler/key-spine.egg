; cell-choice/v1 {"function":"Winner","score":"Rank","order":"max","tie_break":"structural"}
(datatype E (N i64) (A E) (B E) (C E) (D E) (Wrap E))
(relation Seed (E))
(function Cost (E) i64 :merge (min old new))
(function Rank (E) i64 :merge (max old new))
(function Winner () E :merge new)
(ruleset build)
(ruleset consumers)
(rule ((Seed (N n))) ((B (A (N n))) (set (Cost (N n)) 7) (set (Rank (B (A (N n)))) 7)) :ruleset build :name "build-spine")
(rule ((= r (B (A (N n)))) (< n 10)) ((C r) (set (Winner) r)) :ruleset consumers :name "consumer-one")
(rule ((= r (B (A (N n)))) (= c (Cost (N n))) (> c 2)) ((D r) (set (Winner) r)) :ruleset consumers :name "consumer-two")
(Seed (N 3)) (Seed (N 4))
(run build 1)
(run-schedule (repeat 2 (run consumers)))
(check (C (B (A (N 3)))))
(check (D (B (A (N 3)))))
(check (= (Winner) (B (A (N 3)))))
