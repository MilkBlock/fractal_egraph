(datatype E (N i64) (A E) (B E) (C E) (D E))
(ruleset consumers) (ruleset merge)
(rule ((= r (B (A (N n)))) (< n 4)) ((C r)) :ruleset consumers :name "low")
(rule ((= r (B (A (N n)))) (>= n 4)) ((D r)) :ruleset consumers :name "high")
(rule ((= x (N 3)) (= y (N 4))) ((union x y)) :ruleset merge)
(B (A (N 3))) (N 4)
(run consumers 1)
(run merge 1)
(run consumers 1)
(check (C (B (A (N 3)))))
(check (D (B (A (N 3)))))
