; Positive constructor-only arithmetic-shaped integration fixture.
(datatype Expr (Const i64) (Add Expr Expr) (Mul Expr Expr) (Factor Expr) (Offset Expr))
(ruleset seed-add) (ruleset graft-mul) (ruleset graft-add)
(rule ((= x (Const n))) ((Add x x)) :ruleset seed-add)
(rule ((= s (Add x x)) (Factor x)) ((Mul s x)) :ruleset graft-mul)
(rule ((= m (Mul s x)) (Offset x)) ((Add m x)) :ruleset graft-add)
(Const 0) (Factor (Const 0)) (Offset (Const 0))
(Const 1) (Factor (Const 1)) (Offset (Const 1))
(Const 2) (Factor (Const 2)) (Offset (Const 2))
(Const 3) (Factor (Const 3)) (Offset (Const 3))
(Const 4) (Factor (Const 4)) (Offset (Const 4))
(Const 5) (Factor (Const 5)) (Offset (Const 5))
(Const 6) (Factor (Const 6)) (Offset (Const 6))
(Const 7) (Factor (Const 7)) (Offset (Const 7))
(Const 8) (Factor (Const 8)) (Offset (Const 8))
(Const 9) (Factor (Const 9)) (Offset (Const 9))
(Const 10) (Factor (Const 10)) (Offset (Const 10))
(Const 11) (Factor (Const 11)) (Offset (Const 11))
(run-schedule seed-add graft-mul graft-add)
