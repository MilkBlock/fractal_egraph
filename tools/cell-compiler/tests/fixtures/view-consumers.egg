(datatype E (Item i64) (Cost i64 i64) (Choice E E))
(function Ticket (E E E i64) Unit :merge old)
(function Ledger (i64) i64 :merge (+ old new))
(ruleset publish) (ruleset consume) (ruleset late) (ruleset retire) (ruleset wake)
(rule ((= v (Choice a b)) (= b (Cost token bound)))
      ((set (Ticket v a b bound) ())) :ruleset publish)
(rule ((Ticket v a b bound) (= a (Cost token cost)) (< cost bound))
      ((union v a) (set (Ticket a a b bound) ()) (set (Ledger 0) 1)) :ruleset consume)
(rule ((Ticket v a b bound) (= a (Cost token cost)) (> cost bound))
      ((union v b) (set (Ticket b a b bound) ()) (set (Ledger 1) 1)) :ruleset consume)
(rule ((Ticket v a b cost) (= a (Cost token cost)))
      ((union v a) (set (Ticket a a b cost) ()) (set (Ledger 2) 1)) :ruleset consume)
(rule ((= a (Item 8))) ((union a (Cost 33 -5))) :ruleset late)
(rule ((= v (Choice a b))) ((delete (Ticket v a b 6))) :ruleset retire)
(rule ((= b (Cost 2 6))) ((union b (Cost 2000 6))) :ruleset wake)
(Choice (Cost 1 3) (Cost 2 6))
(Choice (Cost 1 9) (Cost 2 6))
(Choice (Cost 1 6) (Cost 2 6))
(Choice (Item 8) (Cost 2 6))
(run-schedule (seq (run publish) (run consume) (run late) (run consume) (run retire) (run consume) (run wake) (run publish) (run consume)))
(check (= observed (Ledger 1)))
