; Pure one-dimensional scalar arrays. Logical values, not mutable memory buffers.
; Requires reduce.egg (including binding_reduce.egg). No arbitrary stream sum.
(datatype IndexDomain (FiniteDomain EndpointExpr) (StreamDomain))
(datatype ScalarFunction
 (ScalarLambda BindingExpr BindingValues)
 (ComposeScalar ScalarFunction ScalarFunction))
(datatype FoldFunction
 (FoldLambda BindingExpr BindingValues)
 (MappedFold FoldFunction ScalarFunction))
(datatype ScalarBinary (BinaryLambda BindingExpr BindingValues))
(datatype Reduction (SumReduction) (MaxReduction))
(sort Array)
(constructor InputArray (String IndexDomain) Array)
(constructor FillArray (IndexDomain EndpointExpr) Array)
(constructor RampArray (IndexDomain EndpointExpr EndpointExpr) Array)
; Tabulate binds index to slot 0; captured environment starts at slot 1.
(constructor Tabulate (IndexDomain BindingExpr BindingValues) Array)
(constructor MapArray (ScalarFunction Array) Array :cost 4)
(constructor ZipArray (ScalarBinary Array Array) Array)
(constructor SliceArray (Array i64 i64) Array)
(constructor ConcatArray (Array Array) Array)
(datatype BlockArray (Blocks Array i64))
(constructor BlockAt (BlockArray i64) Array)
(constructor FlattenBlocks (BlockArray) Array)
(constructor ArrayAt (Array i64) EndpointExpr :cost 100)
(constructor InputElement (String i64) EndpointExpr)
(constructor ApplyScalar (ScalarFunction EndpointExpr) EndpointExpr :cost 100)
(constructor ApplyBinary (ScalarBinary EndpointExpr EndpointExpr) EndpointExpr :cost 100)
; FoldLambda binds accumulator at slot 0 and element at slot 1.
(constructor ApplyFold (FoldFunction EndpointExpr EndpointExpr) EndpointExpr :cost 100)
(constructor FoldArray (FoldFunction EndpointExpr Array) EndpointExpr :cost 10)
(constructor ReduceArray (Reduction Array) EndpointExpr :cost 20)
(constructor ReduceBlocks (Reduction BlockArray) EndpointExpr :cost 20)
; FoldMap fuses consumption with mapping; it does not create a mapped array value.
(constructor FoldMap (Reduction ScalarFunction Array) EndpointExpr :cost 5)
(constructor EExp (EndpointExpr) EndpointExpr)
(constructor EMax (EndpointExpr EndpointExpr) EndpointExpr)
(constructor ENegInf () EndpointExpr)
(constructor BExp (BindingExpr) BindingExpr)
(constructor BMax (BindingExpr BindingExpr) BindingExpr)
(constructor FoldPrefix (FoldFunction EndpointExpr Array i64) EndpointExpr :cost 100)
(constructor ReducePrefix (Reduction Array i64) EndpointExpr :cost 100)
(relation ValidDomain (IndexDomain))
(relation ArrayDomain (Array IndexDomain))
(relation ArrayLength (Array i64))
(relation BlockCount (BlockArray i64))
; These are explicit requests, never automatically generated for every element.
(relation EvaluateFold (Array i64))
(relation TryBlock (Array i64))
(relation ArrayExample (String EndpointExpr))
(ruleset array-shape)
(ruleset array-laws)
(ruleset array-eval)
(rule ((NaturalCount n)) ((ValidDomain (FiniteDomain n))) :ruleset array-shape)
(rule ((= d (StreamDomain))) ((ValidDomain d)) :ruleset array-shape)
(rule ((NaturalCount a) (NaturalCount b) (= n (EAdd a b))) ((NaturalCount n)) :ruleset array-shape)
(rule ((= a (InputArray name d)) (ValidDomain d)) ((ArrayDomain a d)) :ruleset array-shape)
(rule ((= a (FillArray d x)) (ValidDomain d)) ((ArrayDomain a d)) :ruleset array-shape)
(rule ((= a (RampArray d first step)) (ValidDomain d)) ((ArrayDomain a d)) :ruleset array-shape)
(rule ((= a (Tabulate d body env)) (ValidDomain d)) ((ArrayDomain a d)) :ruleset array-shape)
(rule ((= out (MapArray f a)) (ArrayDomain a d)) ((ArrayDomain out d)) :ruleset array-shape)
(rule ((= out (ZipArray f a b)) (ArrayDomain a d) (ArrayDomain b d)) ((ArrayDomain out d)) :ruleset array-shape)
(rule ((ArrayDomain a (FiniteDomain (EInt n))) (>= n 0)) ((ArrayLength a n)) :ruleset array-shape)
(rule ((= out (SliceArray a start len)) (ArrayLength a n)
       (>= start 0) (>= len 0) (<= start n) (<= len (- n start)))
 ((ArrayDomain out (FiniteDomain (EInt len)))) :ruleset array-shape)
(rule ((= out (SliceArray a start len)) (ArrayDomain a (StreamDomain)) (>= start 0) (>= len 0))
 ((ArrayDomain out (FiniteDomain (EInt len)))) :ruleset array-shape)
(rule ((= out (ConcatArray a b)) (ArrayDomain a (FiniteDomain n)) (ArrayDomain b (FiniteDomain m)))
 ((ArrayDomain out (FiniteDomain (EAdd n m)))) :ruleset array-shape)
; Concrete count arithmetic uses egglog's checked i64 primitives.
(rewrite (EAdd (EInt n) (EInt m)) (EInt sum) :when ((= sum (+ n m))) :ruleset array-shape)
(rule ((= bs (Blocks a size)) (ArrayLength a n) (> size 0) (= (% n size) 0))
 ((BlockCount bs (/ n size))) :ruleset array-shape)
(rule ((= bs (Blocks a size)) (ArrayLength a n) (> size 0) (> (% n size) 0))
 ((BlockCount bs (+ (/ n size) 1))) :ruleset array-shape)
(rule ((= out (BlockAt (Blocks a size) block)) (BlockCount (Blocks a size) count)
       (ArrayLength a n) (>= block 0) (< block count))
 ((union out (SliceArray a (* block size) (min size (- n (* block size)))))) :ruleset array-shape)

; Map and fold functions use immutable binding syntax, avoiding capture and
; substitution observing its own algebraic results (cf. eggcc utility/subst.egg).
(rewrite (ApplyScalar (ScalarLambda body env) x) (Substitute body (BCons x env)) :ruleset array-laws)
(rewrite (ApplyScalar (ComposeScalar f g) x) (ApplyScalar f (ApplyScalar g x)) :ruleset array-laws)
(rewrite (ApplyBinary (BinaryLambda body env) x y) (Substitute body (BCons x (BCons y env))) :ruleset array-laws)
(rewrite (ApplyFold (FoldLambda body env) acc x) (Substitute body (BCons acc (BCons x env))) :ruleset array-laws)
(rewrite (ApplyFold (MappedFold f g) acc x) (ApplyFold f acc (ApplyScalar g x)) :ruleset array-laws)
(rewrite (Substitute (BExp x) env) (EExp (Substitute x env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BMax x y) env) (EMax (Substitute x env) (Substitute y env)) :ruleset endpoint-reduce)
(rewrite (EExp (EInt 0)) (EInt 1) :ruleset endpoint-reduce)
(rewrite (EMax (ENegInf) x) x :ruleset endpoint-reduce)
(rewrite (EMax x (ENegInf)) x :ruleset endpoint-reduce)
(rewrite (EMax x x) x :ruleset endpoint-reduce)
(rule ((= e (EExp x)) (CompleteExpr x)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (EMax x y)) (CompleteExpr x) (CompleteExpr y)) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (ENegInf))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rule ((= e (InputElement name i))) ((CompleteExpr e)) :ruleset endpoint-reduce)
(rewrite (MapArray f (MapArray g a)) (MapArray (ComposeScalar f g) a) :ruleset array-laws)
(rule ((= lhs (FoldArray f init (MapArray g a))) (ArrayDomain a (FiniteDomain n)))
 ((union lhs (FoldArray (MappedFold f g) init a))) :ruleset array-laws)
(rule ((= lhs (ReduceArray r (MapArray f a))) (ArrayDomain a (FiniteDomain n)))
 ((union lhs (FoldMap r f a))) :ruleset array-laws)
(rule ((= lhs (SliceArray (SliceArray a start len) offset count))
       (ArrayDomain lhs d) (= shifted (+ start offset)))
 ((union lhs (SliceArray a shifted count))) :ruleset array-laws)
(rule ((= lhs (FlattenBlocks (Blocks a size))) (> size 0) (ArrayDomain a (FiniteDomain n)))
 ((union lhs a)) :ruleset array-laws)
; Sum and max have associative merge laws in this exact scalar theory. Arbitrary
; FoldFunction is deliberately NOT block-reduced with independent initial states.
(rule ((= lhs (ReduceArray r (ConcatArray a b)))
       (= r (SumReduction)) (ArrayDomain a (FiniteDomain n)) (ArrayDomain b (FiniteDomain m)))
 ((union lhs (EAdd (ReduceArray r a) (ReduceArray r b)))) :ruleset array-laws)
(rule ((= lhs (ReduceArray r (ConcatArray a b)))
       (= r (MaxReduction)) (ArrayDomain a (FiniteDomain n)) (ArrayDomain b (FiniteDomain m)))
 ((union lhs (EMax (ReduceArray r a) (ReduceArray r b)))) :ruleset array-laws)
(rule ((TryBlock a size) (> size 0) (ArrayDomain a (FiniteDomain n)) (= x (ReduceArray r a)))
 ((union x (ReduceBlocks r (Blocks a size)))) :ruleset array-laws)
(rule ((= x (ReduceArray (SumReduction) (FillArray (FiniteDomain n) v))) (NaturalCount n))
 ((union x (Reduce (AddConstant v) n (EInt 0)))) :ruleset array-laws)
(rule ((= x (ReduceArray (SumReduction) (RampArray (FiniteDomain n) first step))) (NaturalCount n))
 ((union x (Reduce (AddArithmetic first step) n (EInt 0)))) :ruleset array-laws)

; Demand-driven element access. No out-of-range value is fabricated.
(relation ArrayIndex (Array i64))
(rule ((ArrayAt a i) (ArrayLength a n) (>= i 0) (< i n)) ((ArrayIndex a i)) :ruleset array-eval)
(rule ((ArrayAt a i) (ArrayDomain a (StreamDomain)) (>= i 0)) ((ArrayIndex a i)) :ruleset array-eval)
(rule ((= x (ArrayAt (InputArray name d) i)) (ArrayIndex (InputArray name d) i))
 ((union x (InputElement name i))) :ruleset array-eval)
(rule ((= x (ArrayAt (FillArray d v) i)) (ArrayIndex (FillArray d v) i)) ((union x v)) :ruleset array-eval)
(rule ((= x (ArrayAt (RampArray d first step) i)) (ArrayIndex (RampArray d first step) i))
 ((union x (EAdd first (EMul (EInt i) step)))) :ruleset array-eval)
(rule ((= x (ArrayAt (Tabulate d body env) i)) (ArrayIndex (Tabulate d body env) i))
 ((union x (Substitute body (BCons (EInt i) env)))) :ruleset array-eval)
(rule ((= x (ArrayAt (MapArray f a) i)) (ArrayIndex (MapArray f a) i))
 ((union x (ApplyScalar f (ArrayAt a i)))) :ruleset array-eval)
(rule ((= x (ArrayAt (ZipArray f a b) i)) (ArrayIndex (ZipArray f a b) i))
 ((union x (ApplyBinary f (ArrayAt a i) (ArrayAt b i)))) :ruleset array-eval)
(rule ((= x (ArrayAt (SliceArray a start len) i)) (ArrayIndex (SliceArray a start len) i) (= shifted (+ start i)))
 ((union x (ArrayAt a shifted))) :ruleset array-eval)
(rule ((= x (ArrayAt (ConcatArray a b) i)) (ArrayIndex (ConcatArray a b) i) (ArrayLength a n) (< i n))
 ((union x (ArrayAt a i))) :ruleset array-eval)
(rule ((= x (ArrayAt (ConcatArray a b) i)) (ArrayIndex (ConcatArray a b) i) (ArrayLength a n) (>= i n))
 ((union x (ArrayAt b (- i n)))) :ruleset array-eval)
; Explicit finite evaluation for testing, independent of the default symbolic laws.
(rule ((EvaluateFold a budget) (ArrayLength a n) (<= n budget) (>= budget 0) (= x (FoldArray f init a)))
 ((union x (FoldPrefix f init a n))) :ruleset array-eval)
(rewrite (FoldPrefix f init a 0) init :ruleset array-eval)
(rewrite (FoldPrefix f init a n) (ApplyFold f (FoldPrefix f init a (- n 1)) (ArrayAt a (- n 1)))
 :when ((> n 0)) :ruleset array-eval)
(rule ((EvaluateFold a budget) (ArrayLength a n) (<= n budget) (>= budget 0) (= x (ReduceArray r a)))
 ((union x (ReducePrefix r a n))) :ruleset array-eval)
(rewrite (ReducePrefix (SumReduction) a 0) (EInt 0) :ruleset array-eval)
(rewrite (ReducePrefix (MaxReduction) a 0) (ENegInf) :ruleset array-eval)
(rewrite (ReducePrefix (SumReduction) a n) (EAdd (ReducePrefix (SumReduction) a (- n 1)) (ArrayAt a (- n 1)))
 :when ((> n 0)) :ruleset array-eval)
(rewrite (ReducePrefix (MaxReduction) a n) (EMax (ReducePrefix (MaxReduction) a (- n 1)) (ArrayAt a (- n 1)))
 :when ((> n 0)) :ruleset array-eval)
; Small exact examples only; checked arithmetic leaves unsupported results symbolic.
(rewrite (EMul (EInt a) (EInt b)) (EInt product) :when ((= product (* a b))) :ruleset array-eval)
(rewrite (ESub (EInt a) (EInt b)) (EInt difference) :when ((= difference (- a b))) :ruleset array-eval)
(rewrite (EMax (EInt a) (EInt b)) (EInt (max a b)) :ruleset array-eval)
(rewrite (EDiv (EInt a) (EInt b)) (EInt quotient) :when ((!= b 0) (= (% a b) 0) (= quotient (/ a b))) :ruleset array-eval)
; Parametric block domains stay compact even when the number of blocks is unknown.
(constructor ECeilDiv (EndpointExpr i64) EndpointExpr)
(relation BlockDomain (BlockArray IndexDomain))
(rule ((= bs (Blocks a size)) (ArrayDomain a (FiniteDomain n)) (> size 0))
 ((BlockDomain bs (FiniteDomain (ECeilDiv n size)))) :ruleset array-shape)
(rule ((= c (ECeilDiv n size)) (NaturalCount n) (> size 0)) ((NaturalCount c)) :ruleset array-shape)
(rule ((BlockCount bs count)) ((BlockDomain bs (FiniteDomain (EInt count)))) :ruleset array-shape)
(rewrite (ECeilDiv (EInt n) size) (EInt (/ n size))
 :when ((>= n 0) (> size 0) (= (% n size) 0)) :ruleset array-shape)
(rewrite (ECeilDiv (EInt n) size) (EInt (+ (/ n size) 1))
 :when ((>= n 0) (> size 0) (> (% n size) 0)) :ruleset array-shape)
(rule ((= x (ReduceBlocks r (Blocks a size))) (ArrayDomain a (FiniteDomain n)) (> size 0))
 ((union x (ReduceArray r a))) :ruleset array-laws)
(rule ((= x (SliceArray (MapArray f a) start len)) (ArrayDomain x d))
 ((union x (MapArray f (SliceArray a start len)))) :ruleset array-laws)
(rule ((= out (MapArray f (FillArray d value))) (ValidDomain d))
 ((union out (FillArray d (ApplyScalar f value)))) :ruleset array-laws)
(constructor FoldZip (Reduction ScalarBinary Array Array) EndpointExpr :cost 5)
(rule ((= x (ReduceArray r (ZipArray f a b))) (ArrayDomain a (FiniteDomain n)) (ArrayDomain b (FiniteDomain n)))
 ((union x (FoldZip r f a b))) :ruleset array-laws)
(rule ((= x (FoldArray step initial a)) (ArrayLength a 0)) ((union x initial)) :ruleset array-laws)
(rule ((= x (ReduceArray (SumReduction) a)) (ArrayLength a 0)) ((union x (EInt 0))) :ruleset array-laws)
(rule ((= x (ReduceArray (MaxReduction) a)) (ArrayLength a 0)) ((union x (ENegInf))) :ruleset array-laws)
; Reified symbolic indexing, including array capture in a tabulate body.
; ArrayIndexProof is an explicit in-bounds obligation, not inferred for arbitrary
; symbolic indices. Concrete accesses discharge it through ArrayIndex.
(constructor ArrayGet (Array EndpointExpr) EndpointExpr)
(constructor SymbolicInputElement (String EndpointExpr) EndpointExpr)
(constructor BArrayGet (Array BindingExpr) BindingExpr)
(relation ArrayIndexProof (Array EndpointExpr))
(rewrite (Substitute (BArrayGet a i) env) (ArrayGet a (Substitute i env)) :ruleset endpoint-reduce)
(rewrite (ArrayGet a (EInt i)) (ArrayAt a i) :ruleset array-eval)
(rule ((ArrayIndex a i)) ((ArrayIndexProof a (EInt i))) :ruleset array-eval)
(rule ((ArrayIndexProof (MapArray f a) i)) ((ArrayIndexProof a i)) :ruleset array-laws)
(rule ((ArrayIndexProof (ZipArray f a b) i)) ((ArrayIndexProof a i) (ArrayIndexProof b i)) :ruleset array-laws)
(rule ((= x (ArrayGet (InputArray name d) i)) (ArrayIndexProof (InputArray name d) i))
 ((union x (SymbolicInputElement name i))) :ruleset array-laws)
(rule ((= x (ArrayGet (FillArray d value) i)) (ArrayIndexProof (FillArray d value) i))
 ((union x value)) :ruleset array-laws)
(rule ((= x (ArrayGet (Tabulate d body env) i)) (ArrayIndexProof (Tabulate d body env) i))
 ((union x (Substitute body (BCons i env)))) :ruleset array-laws)
(rule ((= x (ArrayGet (RampArray d first step) i)) (ArrayIndexProof (RampArray d first step) i))
 ((union x (EAdd first (EMul i step)))) :ruleset array-laws)
(rule ((= x (ArrayGet (MapArray f a) i)) (ArrayIndexProof (MapArray f a) i))
 ((union x (ApplyScalar f (ArrayGet a i)))) :ruleset array-laws)
(rule ((= x (ArrayGet (ZipArray f a b) i)) (ArrayIndexProof (ZipArray f a b) i))
 ((union x (ApplyBinary f (ArrayGet a i) (ArrayGet b i)))) :ruleset array-laws)
(rule ((= x (SymbolicInputElement name i)) (CompleteExpr i)) ((CompleteExpr x)) :ruleset endpoint-reduce)
(rule ((= bs (Blocks a size)) (ArrayDomain a (StreamDomain)) (> size 0))
 ((BlockDomain bs (StreamDomain))) :ruleset array-shape)
(rule ((= x (BlockAt (Blocks a size) i)) (ArrayDomain a (StreamDomain)) (> size 0) (>= i 0) (= start (* i size)))
 ((union x (SliceArray a start size))) :ruleset array-shape)
(rule ((= x (FlattenBlocks (Blocks a size))) (ArrayDomain a (StreamDomain)) (> size 0))
 ((union x a)) :ruleset array-laws)
; Arrays can also travel through the existing uniform binding argument carrier.
(constructor EArrayValue (Array) EndpointExpr)
(constructor BArrayGetValue (BindingExpr BindingExpr) BindingExpr)
(constructor ReadArrayValue (EndpointExpr EndpointExpr) EndpointExpr)
(rewrite (Substitute (BArrayGetValue a i) env)
 (ReadArrayValue (Substitute a env) (Substitute i env)) :ruleset endpoint-reduce)
(rewrite (ReadArrayValue (EArrayValue a) i) (ArrayGet a i) :ruleset array-laws)

; Integer powers of natural counts remain valid finite shape expressions.
(rule ((= n (EPow base exponent)) (NaturalCount base) (NaturalCount exponent))
 ((NaturalCount n)) :ruleset array-shape)
