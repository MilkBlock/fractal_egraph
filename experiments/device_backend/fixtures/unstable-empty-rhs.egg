(datatype T (N i64) (Combine T T))
(function Current (T) i64 :merge new)
(function Best (T) T :merge (Combine old new))
(ruleset r)
(let x (N 1))
(set (Current x) 1)
(set (Best x) x)
; Each RHS is empty on this snapshot. None is an allowed persistent no-op:
; merge-new and a custom merge respectively.
(rule ((= y (N 1))) ((set (Current y) 1)) :ruleset r :naive)
(rule ((= y (N 1))) ((set (Best y) y)) :ruleset r :naive)
(run r 1)
(run r 1)
