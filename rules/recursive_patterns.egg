; Finite DAG templates share the Extension/FractalComb vocabulary with linear runs.
(sort RecursivePorts)
(constructor NoRecursivePorts () RecursivePorts)
(constructor RecursivePort (i64 Extension RecursivePorts) RecursivePorts)
(constructor RefinedExtension (Extension String) Extension)
(constructor RecursivePattern (Extension RecursivePorts) Extension)
(relation PatternEntry (Extension Extension))
(relation PatternPorts (Extension RecursivePorts))
(relation PatternPort (Extension i64 Extension))
(relation StepExtension (Instance Extension))
(relation RecursiveUnit (Instance Extension))
(relation VerifiedUnit (Instance Extension))
(relation UnitMember (Instance Extension i64 Instance))
(relation UnitReturn (Instance Extension i64 Instance))
(relation VerifiedMember (Instance Extension i64 Instance))
(relation VerifiedReturn (Instance Extension i64 Instance))
(relation ObservedExtent (Instance Extension ExpansionExtent))
(relation RecursiveView (Instance Comb))
(relation VerifiedRecursiveView (Instance Comb))
(relation UnitAddress (Instance Extension i64 Instance))
(relation RecursiveMember (Instance Extension i64 i64 Instance))
(relation RecursiveOutput (Instance Extension i64 i64 i64 Val))
(relation RecursiveEffect (Instance Extension i64 i64 Effect))
(ruleset recursive-patterns)
(rule ((= p (RecursivePattern (RefinedExtension ae signature) ports)))
 ((PatternEntry p ae) (PatternPorts p ports)) :ruleset recursive-patterns)
(rule ((PatternPorts p (RecursivePort slot (RefinedExtension be signature) tail)))
 ((PatternPort p slot be) (PatternPorts p tail)) :ruleset recursive-patterns)
(rule ((RecursiveUnit a pattern) (PatternEntry pattern ae) (StepExtension a ae)
       (= a (Occurrence id (SmoothComb ps rule binding))) (SupportsUse a a))
 ((VerifiedUnit a pattern)) :ruleset recursive-patterns)
(rule ((VerifiedUnit a pattern) (UnitMember a pattern slot b)
       (PatternPort pattern slot be) (StepExtension b be)
       (= b (Occurrence bid (SmoothComb bps br bb))) (LinkedParent b 0 a) (SupportsUse b b))
 ((VerifiedMember a pattern slot b)) :ruleset recursive-patterns)
(rule ((VerifiedMember a pattern slot b) (UnitReturn a pattern slot next)
       (LinkedParent next 0 b) (VerifiedUnit next pattern))
 ((VerifiedReturn a pattern slot next)) :ruleset recursive-patterns)
; Extents describe checked finite observations, never a promise of future applies.
(rule ((RecursiveView a f) (VerifiedUnit a pattern) (ObservedExtent a pattern extent)
       (= a (Occurrence id (SmoothComb (MoreParents ctx (NoParents)) rule binding)))
       (= f (FractalComb extent pattern ctx binding)))
 ((VerifiedRecursiveView a f)) :ruleset recursive-patterns)
(rule ((UnitAddress root pattern position a) (VerifiedUnit a pattern))
 ((RecursiveMember root pattern position 0 a)) :ruleset recursive-patterns)
(rule ((UnitAddress root pattern position a) (VerifiedMember a pattern slot b))
 ((RecursiveMember root pattern position (+ slot 1) b)) :ruleset recursive-patterns)
(rule ((RecursiveMember root pattern position role member) (OutputAt member port value))
 ((RecursiveOutput root pattern position role port value)) :ruleset recursive-patterns)
(rule ((RecursiveMember root pattern position role member) (Produced member effect))
 ((RecursiveEffect root pattern position role effect)) :ruleset recursive-patterns)
