(datatype Term (Leaf String) (A Term) (AA Term) (P Term) (PP Term) (R Term) (RR Term) (Q Term) (Large Term) (Largest Term) (Other Term))
(ruleset demo)
(rewrite (A x) (AA x) :ruleset demo)
(rewrite (P x) (PP x) :ruleset demo)
(rewrite (R x) (RR x) :ruleset demo)
(rule ((AA x) (PP x)) ((Large x)) :ruleset demo)
(rule ((Large x) (RR x)) ((Largest x)) :ruleset demo)
(rule ((AA x) (Q x)) ((Other x)) :ruleset demo)
(A (Leaf "x")) (P (Leaf "x")) (R (Leaf "x")) (Q (Leaf "x"))
(run-schedule (saturate demo))
(check (Largest (Leaf "x")) (Other (Leaf "x")))
