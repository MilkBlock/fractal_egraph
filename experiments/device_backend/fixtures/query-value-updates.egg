(datatype T (N i64))
(function Value (T) i64 :merge (max old new))
(relation Gate (i64 i64))
(relation Seen (i64 T i64))
(ruleset seed)
(ruleset initialize)
(ruleset consume)
(ruleset change)
(ruleset publish)
(ruleset merge)
(N 0)
(Gate 0 0) (Gate 0 10) (Gate 0 20) (Gate 0 30) (Gate 0 40)
(rule ((N n) (< n 64)) ((N (+ n 1))) :ruleset seed)
(rule ((= x (N n))) ((set (Value x) (* 10 (% n 5)))) :ruleset initialize)
(rule ((Gate phase v) (= v (Value x))) ((Seen phase x v)) :ruleset consume)
; Multiple updates to the same indexed row in one phase. Several destination
; buckets already contain other rows, requiring stable middle insertion.
(rule ((= n (Value x)) (< n 30))
      ((set (Value x) (+ n 10)) (set (Value x) (+ n 20))) :ruleset change)
(rule () ((Gate 1 0) (Gate 1 10) (Gate 1 20) (Gate 1 30) (Gate 1 40)) :ruleset publish)
; A logged point update followed by union must use full rebuild and clear logs.
(rule ((= x (N 0)) (= y (N 1)))
      ((set (Value (N 2)) 50) (union x y)) :ruleset merge)
(run-schedule (saturate seed))
(run initialize 1)
(run consume 1)
(run change 1)
(run publish 1)
(run consume 1)
(check (Seen 1 (N 0) 20))
(check (Seen 1 (N 1) 30))
(check (Seen 1 (N 2) 40))
(run merge 1)
(run consume 1)
(check (= (Value (N 0)) 30))
(check (= (Value (N 2)) 50))
