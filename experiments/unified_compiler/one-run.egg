(datatype E (N i64) (A E) (B E) (C E) (D E))
(relation Seed (E))
(ruleset all)
(rule ((Seed (N n))) ((B (A (N n)))) :ruleset all :name "producer")
(rule ((= r (B (A (N n))))) ((C r)) :ruleset all :name "consumer-one")
(rule ((= r (B (A (N n))))) ((D r)) :ruleset all :name "consumer-two")
(Seed (N 3))
(run all 1)
(check (B (A (N 3))))
