(datatype Assumption (InFunc String) (Ctx i64))
(datatype BaseType (StateT))
(datatype Type (Base BaseType))
(datatype Expr (V i64) (Arg Type Assumption) (Get Expr i64) (If Expr Expr Expr Expr) (TupleRemoveAt Expr i64) (DropAt Assumption i64 Expr))
(sort ___HasTypeSort)
