; Extracted symbolic interface. Boundary constructors are opaque, not recovered original terms.
(datatype T (V String) (Seed T T) (Add T T) (GateL T) (GateR T) (Left T) (Right T))
(constructor RipenInput (i64) T)
(ruleset all)
(rule ((Seed a b))
      ((Add a b))
        :ruleset all :name "base")
(rule ((Add a b)
       (GateL a))
      ((Left a))
        :ruleset all :name "left")
(rule ((Add a b)
       (GateR b))
      ((Right b))
        :ruleset all :name "right")
(RipenInput 0)
(RipenInput 1)
(fail (fail (check (= (RipenInput 0) (RipenInput 0)))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(Seed (RipenInput 0) (RipenInput 1))
(fail (fail (check (Seed (RipenInput 0) (RipenInput 1)))))
(Add (RipenInput 0) (RipenInput 1))
(fail (fail (check (= (RipenInput 0) (RipenInput 0)))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(fail (fail (check (= (RipenInput 0) (RipenInput 0)))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(fail (fail (check (= (Add (RipenInput 0) (RipenInput 1)) (Add (RipenInput 0) (RipenInput 1))))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(GateR (RipenInput 1))
(fail (fail (check (Add (RipenInput 0) (RipenInput 1)))))
(fail (fail (check (GateR (RipenInput 1)))))
(Right (RipenInput 1))
(fail (fail (check (= (RipenInput 0) (RipenInput 0)))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(fail (fail (check (= (RipenInput 1) (RipenInput 1)))))
(check (= (Add (RipenInput 0) (RipenInput 1)) (Add (RipenInput 0) (RipenInput 1))))
(check (= (Right (RipenInput 1)) (Right (RipenInput 1))))
