(datatype E (N i64) (P E) (Q E) (R E))
(ruleset a) (ruleset b) (ruleset c)
(rule ((= x (N n))) ((P x)) :ruleset a :name "make-p")
(rule ((= p (P x))) ((Q p)) :ruleset b :name "make-q")
(rule ((= q (Q p))) ((R q)) :ruleset c :name "make-r")
(N 0) (N 1)
(run-schedule (saturate (run a) (run b) (run c)))
(check (R (Q (P (N 0)))) (R (Q (P (N 1)))))
