(datatype T (N i64) (Smaller T T))
(function Best (T) T :merge (Smaller old new))
(function Cost (T) i64 :merge (max 1 (min old new)))
(function Latest (T) i64 :merge new)
(ruleset first)
(ruleset second)
(let k (N 0))
(set (Best k) (N 9))
(set (Cost k) 7)
(set (Latest k) 1)
(rule ((= x (N 0))) ((set (Best x) (N 4)) (set (Cost x) -2) (set (Latest x) 2)) :ruleset first)
(rule ((= (Best k) (Smaller a b))) ((union a b)) :ruleset second)
(run first 1)
(check (= (Best k) (Smaller (N 9) (N 4))))
(check (= (Cost k) 1))
(check (= (Latest k) 2))
(run second 1)
