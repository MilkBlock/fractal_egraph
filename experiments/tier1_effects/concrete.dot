digraph G {
graph [rankdir=LR,bgcolor="#fafaf7",pad=0.3,nodesep=0.45,ranksep=0.8];
node [fontname="Arial",fontsize=12,shape=box,style="rounded,filled",color="#62706f"];
edge [fontname="Arial",fontsize=10,color="#637577"];
label="R10 提公因子 → R15 乘积求导 · Rule-comb 上下文 / effect 视图";labelloc=t;fontsize=20;
c0 [label="C0 · Entry",fillcolor="#edf0fa"];
e0_given_0 [label="Mul(x, 2, u)\nMul(x, 3, v)\nAdd(u, v, p)\nDiff(x, p, d)",shape=note,fillcolor="#edf0fa"];
c0 -> e0_given_0 [style=dotted,label="given"];
c1 [label="C1 · R10: factor\na=x, b=2, c=3",fillcolor="#dcefe5"];
c0 -> c1 [label="ctx 0"];
e1_requires_0 [label="Mul(x, 2, u)\nMul(x, 3, v)\nAdd(u, v, p)",shape=note,fillcolor="#edf0fa"];
e1_requires_0 -> c1 [style=dashed,label="requires"];
e1_produces_0 [label="Add(2, 3, s)\nMul(x, s, q)\np = q",shape=note,fillcolor="#edf0fa"];
c1 -> e1_produces_0 [style=dotted,label="produces"];
c2 [label="C2 · R15: product derivative\na=x, b=s=2+3",fillcolor="#dcefe5"];
c1 -> c2 [label="ctx 0"];
e2_requires_0 [label="Mul(x, s, q)\nDiff(x, q, d)",shape=note,fillcolor="#edf0fa"];
e2_requires_0 -> c2 [style=dashed,label="requires"];
e2_produces_0 [label="Diff(x, s, dxs)\nDiff(x, x, dxx)\nMul(x, dxs, left)\nMul(s, dxx, right)\nAdd(left, right, z)\nd = z",shape=note,fillcolor="#edf0fa"];
c2 -> e2_produces_0 [style=dotted,label="produces"];
}
