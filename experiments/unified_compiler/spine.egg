(datatype E (N i64) (A E) (B E) (C E) (D E) (Wrap E))
(relation Seed (E))
(function Cost (E) i64 :merge (min old new))
(ruleset build)
(ruleset consumers)
(rule ((Seed (N n))) ((B (A (N n))) (set (Cost (N n)) 7)) :ruleset build :name "build-spine")
(rule ((= r (B (A (N n)))) (< n 10)) ((C r)) :ruleset consumers :name "consumer-one")
(rule ((= r (B (A (N n)))) (= c (Cost (N n))) (> c 2)) ((D r)) :ruleset consumers :name "consumer-two")
(Seed (N 3))
(run build 1)
(run-schedule (repeat 2 (run consumers)))
(check (C (B (A (N 3)))))
(check (D (B (A (N 3)))))
