(datatype Node (Leaf i64) (Blocked i64) (Forward Node) (Pair Node Node))
(relation Ready (Node))
(ruleset closure)
(rule ((= x (Leaf n))) ((Ready x)) :ruleset closure)
(rule ((= x (Forward a)) (Ready a)) ((Ready x)) :ruleset closure)
(rule ((= x (Pair a b)) (Ready a) (Ready b)) ((Ready x)) :ruleset closure)
(let a (Leaf 1))
(let b (Forward (Forward a)))
(let cycle (Blocked 0))
(union cycle (Forward cycle))
(Pair b b)
(Pair a cycle)
(let alternative (Pair a cycle))
(union alternative (Forward a))
(Pair alternative b)
(run-schedule (saturate closure))
