(datatype E (Seed i64) (Inside E) (Wrap E))
(ruleset reconcile)
(rule ((= x (Seed n))) ((union (Wrap (Inside x)) x)) :ruleset reconcile)
(Wrap (Inside (Seed 1)))
(Inside (Seed 2))
(Seed 3)
(run-schedule (run reconcile))
(check (= (Wrap (Inside (Seed 1))) (Seed 1)))
(check (= (Wrap (Inside (Seed 2))) (Seed 2)))
(check (= (Wrap (Inside (Seed 3))) (Seed 3)))
