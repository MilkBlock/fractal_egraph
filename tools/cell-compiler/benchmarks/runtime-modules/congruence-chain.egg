(datatype E (N i64) (Seed E E) (F E) (Seen E))
(ruleset make) (ruleset alias) (ruleset read)
(rule ((Seed a b)) (
  (let left0 (F a))
  (let right0 (F b))
  (let left1 (F left0))
  (let right1 (F right0))
  (let left2 (F left1))
  (let right2 (F right1))
  (let left3 (F left2))
  (let right3 (F right2))
) :ruleset make)
(rule ((Seed a b)) ((union a b)) :ruleset alias)
(rule ((= x (F y))) ((Seen x)) :ruleset read)
(Seed (N 0) (N 1))
(Seed (N 2) (N 3))
(Seed (N 4) (N 5))
(Seed (N 6) (N 7))
(Seed (N 8) (N 9))
(Seed (N 10) (N 11))
(Seed (N 12) (N 13))
(Seed (N 14) (N 15))
(run-schedule (seq (run make) (run alias) (run read)))
