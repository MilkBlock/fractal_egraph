(datatype E (Leaf i64) (Wrap E))
(relation A (E E))
(relation B (E E))
(relation Need (E))
(relation Hit (E E))
(function Best (E) i64 :merge (min old new))
(ruleset s)
(function SharedAB (E E) Unit :merge old)
(ruleset publish)
(rule ((A x y) (B y z)) ((set (SharedAB x z) ())) :ruleset publish)
(rule ((SharedAB x z) (Need x))
      ((Hit x z) (set (Best x) 7)) :ruleset s :name "consume")
(A (Leaf 1) (Leaf 2))
(B (Leaf 2) (Leaf 3))
(Need (Leaf 1))
(run-schedule (seq (saturate publish) (run s) (run s)))
(check (Hit (Leaf 1) (Leaf 3)))
(check (= (Best (Leaf 1)) 7))
