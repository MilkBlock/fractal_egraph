digraph G {
graph [rankdir=LR,bgcolor="#fafaf7",pad=0.3,nodesep=0.45,ranksep=0.8];
node [fontname="Arial",fontsize=12,shape=box,style="rounded,filled",color="#62706f"];
edge [fontname="Arial",fontsize=10,color="#637577"];
label="局部依赖冗余 · Rule-comb 上下文 / effect 视图";labelloc=t;fontsize=20;
c0 [label="C0 · Entry",fillcolor="#edf0fa"];
e0_given_0 [label="P(0)",shape=note,fillcolor="#edf0fa"];
c0 -> e0_given_0 [style=dotted,label="given"];
c1 [label="C1 · produce-Q\nv0=0, v1=1",fillcolor="#dcefe5"];
c0 -> c1 [label="ctx 0"];
e1_requires_0 [label="P(0)",shape=note,fillcolor="#edf0fa"];
e1_requires_0 -> c1 [style=dashed,label="requires"];
e1_produces_0 [label="Q(0)",shape=note,fillcolor="#edf0fa"];
c1 -> e1_produces_0 [style=dotted,label="produces"];
c2 [label="C2 · Join",fillcolor="#edf0fa"];
c0 -> c2 [label="ctx 0"];
c1 -> c2 [label="ctx 1"];
c3 [label="C3 · use-P\nv0=0, v1=1",fillcolor="#dcefe5"];
c2 -> c3 [label="ctx 0"];
e3_requires_0 [label="P(0)",shape=note,fillcolor="#edf0fa"];
e3_requires_0 -> c3 [style=dashed,label="requires"];
c4 [label="C4 · forward-Q\nv0=0, v1=1",fillcolor="#dcefe5"];
c1 -> c4 [label="ctx 0"];
e4_requires_0 [label="Q(0)",shape=note,fillcolor="#edf0fa"];
e4_requires_0 -> c4 [style=dashed,label="requires"];
c5 [label="C5 · Join",fillcolor="#edf0fa"];
c1 -> c5 [label="ctx 0"];
c4 -> c5 [label="ctx 1"];
c6 [label="C6 · use-Q\nv0=0, v1=1",fillcolor="#dcefe5"];
c5 -> c6 [label="ctx 0"];
e6_requires_0 [label="Q(0)",shape=note,fillcolor="#edf0fa"];
e6_requires_0 -> c6 [style=dashed,label="requires"];
c3 -> c0 [constraint=false,color="#168454",penwidth=2,style=dashed,label="omit C1: certified for this use"];
c6 -> c4 [constraint=false,color="#bd3939",penwidth=2,style=dashed,label="omit C1: rejected: indirect dependency"];
}
