(datatype E (N i64) (Pair E E) (Box E i64))
(function Cost (E) i64 :merge (min old new))
(function Best (E) i64 :merge (min old new))
(relation Middle (E i64)) (relation Next (E i64)) (relation Done (E i64))
(ruleset build) (ruleset advance) (ruleset finish)
(rule ((= r (Pair x y)) (= a (Cost x)) (= b (Cost y)))
      ((Middle r (+ 1 (+ a b)))) :ruleset build)
(rule ((Middle r n) (< n 20000000))
      ((Next r (+ n 2)) (Box r n)) :ruleset advance)
(rule ((Next r n)) ((Done r n) (set (Best r) n)) :ruleset finish)
(Pair (N 0) (N 1)) (Pair (N 1) (N 0))
(set (Cost (N 0)) 3) (set (Cost (N 1)) 4)
(run-schedule (saturate (run build) (run advance) (run finish)))
(check (Done (Pair (N 0) (N 1)) 10))
