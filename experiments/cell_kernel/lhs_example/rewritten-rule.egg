(ruleset AutoTouch_produce)
(relation AutoTouch_cell_0 (Expr UnaryOp Expr BaseType Term i64 bool Expr Expr))
(rule ((= __lhs_v0 (Uop __lhs_v1 __lhs_v2))
 (HasType __lhs_v0 (Base __lhs_v3))
 (= (TCPair __lhs_v4 __lhs_v5) (ExtractedExpr __lhs_v0))
 (> 10 (Expr-size __lhs_v0))
 (ExprIsPure __lhs_v0)
 (ContextOf __lhs_v0 (InIf __lhs_v6 __lhs_v7 __lhs_v8))) ((AutoTouch_cell_0 __lhs_v0 __lhs_v1 __lhs_v2 __lhs_v3 __lhs_v4 __lhs_v5 __lhs_v6 __lhs_v7 __lhs_v8)) :ruleset AutoTouch_produce)
(ruleset AutoApply)
(rule ((= if_e (If pred orig_ins thn els))
 (HasArgType thn (TupleT tylist))
