(datatype E (A) (B E))
(relation Seen (E))
(relation Done ())
(A)
(ruleset make)
(rule ((= x (A))) ((B x) (subsume (B x)) (Done)) :ruleset make)
(run make 1)
(ruleset see)
(rule ((= x (B y))) ((Seen x)) :ruleset see)
(run see 1)
(print-size Seen)
(print-size Done)
(subsume (B (A)))
(relation SeenAfter (E))
(ruleset see-after)
(rule ((= x (B y))) ((SeenAfter x)) :ruleset see-after)
(run see-after 1)
(print-size SeenAfter)
