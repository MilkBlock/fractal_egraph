; Tier-1 analyzes witnessed tier-0 rule combinations, not pending execution plans.
; Apply effects are historical facts. SupportsUse tests alternative input support.
(datatype Val (V String String))
(datatype Args (ANil) (ACons Val Args))
(datatype Effect (HasFact String Args) (Equal Val Val))
(datatype Effects (ENil) (ECons Effect Effects))
(datatype Ctx (Entry i64) (Join Ctx Ctx) (Apply Ctx String String Effects Effects))
(relation Given (Ctx Effect))
(relation Provides (Ctx Effect))
(relation EqAt (Ctx Val Val))
(relation ArgsEqual (Ctx Args Args))
(relation Satisfies (Ctx Effect))
(relation AllSatisfied (Ctx Effects))
(relation Emit (Ctx Effects))
(relation SupportsUse (Ctx Ctx))
(relation ProposedRemoval (Ctx Ctx Ctx))
(relation Independent (Ctx Ctx))
(relation RedundantForUse (Ctx Ctx Ctx))
(ruleset tier1)
; Structural base cases; no Known/Ready state attached to Ctx.
(rule ((= c (Entry id))) ((ArgsEqual c (ANil) (ANil)) (AllSatisfied c (ENil))) :ruleset tier1)
(rule ((= c (Join a b))) ((ArgsEqual c (ANil) (ANil)) (AllSatisfied c (ENil))) :ruleset tier1)
(rule ((= c (Apply p r binding req prod))) ((ArgsEqual c (ANil) (ANil)) (AllSatisfied c (ENil)) (Emit c prod)) :ruleset tier1)
(rule ((Given c e)) ((Provides c e)) :ruleset tier1)
(rule ((= c (Join a b)) (Provides a e)) ((Provides c e)) :ruleset tier1)
(rule ((= c (Join a b)) (Provides b e)) ((Provides c e)) :ruleset tier1)
(rule ((= app (Apply p r binding req prod)) (Provides p e)) ((Provides app e)) :ruleset tier1)
(rule ((Emit c (ECons e tail))) ((Provides c e) (Emit c tail)) :ruleset tier1)
; Equality stays scoped to the combination context.
(rule ((Provides c (Equal (V sort a) (V sort b)))) ((EqAt c (V sort a) (V sort b))) :ruleset tier1)
(rule ((EqAt c a b)) ((EqAt c b a)) :ruleset tier1)
(rule ((EqAt c a b) (EqAt c b d)) ((EqAt c a d)) :ruleset tier1)
(rule ((= xs (ACons x xt)) (= ys (ACons x yt)) (ArgsEqual c xt yt)) ((ArgsEqual c xs ys)) :ruleset tier1)
(rule ((= xs (ACons x xt)) (= ys (ACons y yt)) (EqAt c x y) (ArgsEqual c xt yt)) ((ArgsEqual c xs ys)) :ruleset tier1)
(rule ((= e (HasFact name wanted)) (Provides c (HasFact name actual)) (ArgsEqual c actual wanted)) ((Satisfies c e)) :ruleset tier1)
(rule ((= e (Equal a b)) (EqAt c a b)) ((Satisfies c e)) :ruleset tier1)
(rule ((= es (ECons (Equal a a) tail)) (AllSatisfied c tail)) ((AllSatisfied c es)) :ruleset tier1)
(rule ((= es (ECons e tail)) (Satisfies c e) (AllSatisfied c tail)) ((AllSatisfied c es)) :ruleset tier1)
; These classify support, not whether the recorded application happened.
(rule ((= app (Apply p r binding req prod)) (AllSatisfied c req)) ((SupportsUse c app)) :ruleset tier1)
; replacement is an existing context, NOT a fabricated historical Apply.
(rule ((SupportsUse replacement old) (ProposedRemoval old replacement removed) (Independent replacement removed)) ((RedundantForUse old replacement removed)) :ruleset tier1)
