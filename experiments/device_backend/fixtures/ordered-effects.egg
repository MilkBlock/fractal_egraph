(datatype T (N i64) (Combine T T))
(function Latest (T) i64 :merge new)
(function Best (T) T :merge (Combine old new))
(relation Witness (T i64 i64))
(ruleset r)
(let x (N 0))
(set (Best x) x)
(Witness x 0 1)
(Witness x 1 2)
(Witness x 2 1)
; The tag is irrelevant to the RHS, but A;B;A cannot be reduced to A;B under
; merge-new. Custom merge is also deliberately outside the commutation proof.
(rule ((Witness y tag v)) ((set (Latest y) v) (set (Best y) y)) :ruleset r)
(run r 1)
