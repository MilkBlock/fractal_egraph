(datatype Assumption (InFunc String) (Ctx i64))
(datatype BaseType (StateT)) (datatype Type (Base BaseType))
(datatype Expr (V i64) (Arg Type Assumption) (Get Expr i64)
 (If Expr Expr Expr Expr) (TupleRemoveAt Expr i64) (DropAt Assumption i64 Expr))
(sort ___HasTypeSort) (constructor HasType (Expr Type) ___HasTypeSort)
(sort ___ToSubsumeIfSort) (constructor ToSubsumeIf (Expr Expr Expr Expr) ___ToSubsumeIfSort)
(ruleset non-weakly-linear) (ruleset state-edge-passthrough)
(rule ((= outputs (If pred inputs then_ else_))
       (= (Get then_ i) (Get (Arg arg_ty then_ctx) j))
       (= (Get else_ i) (Get (Arg arg_ty else_ctx) j))
       (HasType (Get then_ i) (Base (StateT ))))
      ((union (Get outputs i) (Get inputs j)))
        :ruleset non-weakly-linear )
(If (V 100) (V 101) (V 102) (V 103))
(union (Get (V 102) 0) (Get (Arg (Base (StateT)) (Ctx 0)) 1))
(union (Get (V 103) 0) (Get (Arg (Base (StateT)) (Ctx 1)) 1))
(HasType (Get (V 102) 0) (Base (StateT)))
(If (V 104) (V 105) (V 106) (V 107))
(union (Get (V 106) 1) (Get (Arg (Base (StateT)) (Ctx 2)) 2))
(union (Get (V 107) 1) (Get (Arg (Base (StateT)) (Ctx 3)) 2))
(HasType (Get (V 106) 1) (Base (StateT)))
(If (V 108) (V 109) (V 110) (V 111))
(union (Get (V 110) 2) (Get (Arg (Base (StateT)) (Ctx 4)) 3))
(union (Get (V 111) 2) (Get (Arg (Base (StateT)) (Ctx 5)) 3))
(HasType (Get (V 110) 2) (Base (StateT)))
(If (V 112) (V 113) (V 114) (V 115))
(union (Get (V 114) 3) (Get (Arg (Base (StateT)) (Ctx 6)) 4))
(union (Get (V 115) 3) (Get (Arg (Base (StateT)) (Ctx 7)) 4))
(HasType (Get (V 114) 3) (Base (StateT)))
(run non-weakly-linear 2)
(check (= (Get (If (V 100) (V 101) (V 102) (V 103)) 0) (Get (V 101) 1)))
(check (= (Get (If (V 104) (V 105) (V 106) (V 107)) 1) (Get (V 105) 2)))
(check (= (Get (If (V 108) (V 109) (V 110) (V 111)) 2) (Get (V 109) 3)))
(check (= (Get (If (V 112) (V 113) (V 114) (V 115)) 3) (Get (V 113) 4)))
