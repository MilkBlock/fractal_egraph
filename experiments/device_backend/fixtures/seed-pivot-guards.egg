(datatype T (N i64) (W T) (V T))
(relation Tick ())
(ruleset r)
(ruleset tick)
(ruleset add)
(N 0)
; A changed, fully-bound atom must still admit OLD seed rows. The position of
; that atom also changes the old/new constraint on the first branching atom.
(rule ((= x (N n)) (Tick)) ((W x)) :ruleset r)
(rule ((Tick) (= x (N n))) ((V x)) :ruleset r)
(rule () ((Tick)) :ruleset tick)
(rule () ((N 1)) :ruleset add)
(run r 1)
(run tick 1)
(run r 1)
(run add 1)
(run r 1)
(check (W (N 0)))
(check (V (N 0)))
(check (W (N 1)))
(check (V (N 1)))
