(datatype Node (Seed i64) (Blocked i64) (Link Node))
(datatype Proof (P Node) (Q Node) (R Node))
(function Pick (Node) Node :merge new)
(ruleset A)
(ruleset B)
(ruleset C)
(rule ((= x (Seed n))) ((P x)) :ruleset A)
(rule ((= y (Link x)) (P x)) ((P y)) :ruleset A)
(rule ((= y (Link x)) (R x)) ((P y)) :ruleset A)
(rule ((= y (Link x)) (P x)) ((Q y)) :ruleset B)
(rule ((= y (Pick x)) (P x)) ((Q y)) :ruleset B)
(rule ((= y (Link x)) (Q x)) ((R y)) :ruleset C)
(let a (Seed 1))
(let b (Link a))
(let c (Link b))
(let d (Link c))
(let unseeded (Blocked 20))
(union unseeded (Link unseeded))
(set (Pick a) (Blocked 7))
(run-schedule (saturate (seq A B C)))
