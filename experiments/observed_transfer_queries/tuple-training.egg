(datatype Expr (V i64) (Single Expr) (Concat Expr Expr) (Get Expr i64))
(sort ___AddGetsSort) (constructor Add-Gets (Expr Expr i64) ___AddGetsSort)
(sort ___AddAllGetsSort) (constructor Add-All-Gets (Expr Expr i64 i64) ___AddAllGetsSort)
(sort ___NotJustConcatSort) (constructor Not-Just-Concat (Expr) ___NotJustConcatSort)
(function tuple-length (Expr) i64 :no-merge :unextractable)
(ruleset always-run)
(rule ((Get x i))
      ((Add-Gets x x 0))
        :ruleset always-run )
(rule ((Add-Gets orig (Concat left right) n)
       (= len (tuple-length left)))
      ((Add-Gets orig left n)
       (Add-Gets orig right (+ n len)))
        :ruleset always-run )
(rule ((Add-Gets orig (Single e) n))
      ((union (Get orig n) e))
        :ruleset always-run )
(rule ((Add-Gets orig something n)
       (Not-Just-Concat something))
      ((Add-All-Gets orig something n 0))
        :ruleset always-run )
(rule ((Add-All-Gets orig something offset pos)
       (< pos (tuple-length something)))
      ((union (Get orig (+ offset pos)) (Get something pos))
       (Add-All-Gets orig something offset (+ pos 1)))
        :ruleset always-run )
(set (tuple-length (Single (V 0))) 1)
(set (tuple-length (Single (V 1))) 1)
(set (tuple-length (V 3)) 6)
(Not-Just-Concat (V 3))
(Get (Concat (Single (V 0)) (Single (V 1))) 0)
(Add-Gets (V 90) (V 3) 2)
(run always-run 12)
(check (= (Get (V 90) 7) (Get (V 3) 5)))
