; cell-choice/v1 {"function":"Winner","score":"Rank","order":"max","tie_break":"structural"}
(datatype E (N i64) (A E))
(function Rank (E) i64 :merge (max old new))
(function Winner () E :merge new)
(relation Candidate (E))
(ruleset choose)
(rule ((Candidate x)) ((set (Winner) x)) :ruleset choose)
(let leaf (N 0)) (let deep (A leaf))
(set (Rank leaf) 7) (set (Rank deep) 7)
(Candidate deep) (Candidate leaf)
(run choose 1)
(check (= (Winner) leaf))
