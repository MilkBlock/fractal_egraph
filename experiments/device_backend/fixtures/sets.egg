(sort E)
(constructor N (i64) E)
(sort S (Set E))
(constructor Box (S) E)
(constructor Combine (E E) E)
(function Size (E) i64 :merge (min old new))
(ruleset size)
(ruleset join)
(ruleset alias)
(let a (N 1))
(let b (N 2))
(let c (N 3))
(let x (Box (set-insert (set-insert (set-empty) a) b)))
(let y (Box (set-insert (set-insert (set-empty) b) c)))
(rule ((= q (Box s))) ((set (Size q) (set-length s))) :ruleset size)
(rule ((= l (Box s)) (= r (Box t))) ((Box (set-union s t)) (Box (set-intersect s t))) :ruleset join)
(rule ((= q (N 1)) (= r (N 2))) ((union q r)) :ruleset alias)
(run join 1)
(run size 1)
(check (= (Size x) 2))
(run alias 1)
(run size 1)
(check (= (Size x) 1))
(run-schedule (saturate join))
(run size 1)
