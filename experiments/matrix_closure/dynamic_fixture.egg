(datatype Node (Leaf i64) (Base i64) (Blocked i64) (Forward Node) (Pair Node Node))
(datatype Proof (Ready Node))
(function Selected (Node) Node :merge new)
(ruleset closure)
(rule ((= x (Leaf n))) ((Ready x)) :ruleset closure)
(rule ((= x (Base n))) ((Ready x)) :ruleset closure)
(rule ((= x (Forward a)) (Ready a)) ((Ready x)) :ruleset closure)
(rule ((= x (Pair a b)) (Ready a) (Ready b)) ((Ready x)) :ruleset closure)
(rule ((= x (Pair a a))) ((Ready x)) :ruleset closure)
(rule ((= y (Selected x)) (Ready x)) ((Ready y)) :ruleset closure)
(let a (Leaf 1))
(union a (Base 1))
(let key (Leaf 0))
(let blocked (Blocked 2))
(let retired (Leaf 99))
(let chooser-old (Blocked 20))
(set (Selected key) chooser-old)
(let blocked-pair (Pair blocked (Blocked 3)))
(run-schedule (saturate closure))
