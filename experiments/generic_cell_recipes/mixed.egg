(datatype X (N i64) (A X) (B X))
(sort Bag (Set X))
(constructor Pack (Bag) X)
(relation Seen (X))
(function Score (X) i64 :merge (min old new))
(ruleset alpha)
(ruleset beta)
(rule ((= x (N n)) (> n 0))
      ((A x) (set (Score x) (+ n 2)) (Seen x)) :ruleset alpha)
(rule ((= x (A y)))
      ((B x) (Pack (set-insert (set-empty) y))) :ruleset beta)
(N 3)
(run-schedule (saturate (run alpha) (run beta)))
