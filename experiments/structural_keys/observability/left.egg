; Same winning result as right.egg, different comparison-node history.
(datatype Term (Leaf i64))
(datatype TC (TCPair Term i64) (Smaller TC TC))
(relation SeenLeft (Term))
(ruleset choose)
(rule ((= s (Smaller (TCPair a ca) (TCPair b cb))) (< ca cb))
      ((union s (TCPair a ca))) :ruleset choose)
(rule ((= s (Smaller (TCPair a ca) (TCPair b cb))) (> ca cb))
      ((union s (TCPair b cb))) :ruleset choose)
(ruleset observe)
(rule ((Smaller (TCPair x cx) y)) ((SeenLeft x)) :ruleset observe)
(let a (TCPair (Leaf 1) 2))
(let b (TCPair (Leaf 2) 5))
(let result (Smaller a b))
(run-schedule (saturate choose))
