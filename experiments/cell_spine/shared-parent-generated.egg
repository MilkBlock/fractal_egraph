(datatype Term (Leaf String) (A Term Term) (AA Term Term) (Gate Term Term) (Joined Term Term))
(ruleset demo)
(rewrite (A x y) (AA x y) :ruleset demo)
(rule ((AA x y)
       (AA y z)
       (Gate x z))
      ((Joined x z))
        :ruleset demo )
(constructor RipenInput (i64) Term)
(ruleset Spine-Run)
(ruleset Spine-Export)
(sort Spine-Term)
(constructor Spine-A (Spine-Term Spine-Term) Spine-Term)
(constructor Spine-AA (Spine-Term Spine-Term) Spine-Term)
(constructor Spine-Gate (Spine-Term Spine-Term) Spine-Term)
(constructor Spine-Joined (Spine-Term Spine-Term) Spine-Term)
(constructor Spine-Leaf (String) Spine-Term)
(constructor Spine-RipenInput (i64) Spine-Term)
(function Spine-Reified-Term (Spine-Term) Term :merge old)
(rule ((= s (Spine-A x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1))) ((set (Spine-Reified-Term s) (A y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-A x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1)) (= previous (Spine-Reified-Term s))) ((union previous (A y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1))) ((set (Spine-Reified-Term s) (AA y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-AA x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1)) (= previous (Spine-Reified-Term s))) ((union previous (AA y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-Gate x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1))) ((set (Spine-Reified-Term s) (Gate y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-Gate x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1)) (= previous (Spine-Reified-Term s))) ((union previous (Gate y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-Joined x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1))) ((set (Spine-Reified-Term s) (Joined y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-Joined x0 x1)) (= y0 (Spine-Reified-Term x0)) (= y1 (Spine-Reified-Term x1)) (= previous (Spine-Reified-Term s))) ((union previous (Joined y0 y1))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0))) ((set (Spine-Reified-Term s) (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-Leaf x0)) (= previous (Spine-Reified-Term s))) ((union previous (Leaf x0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0))) ((set (Spine-Reified-Term s) (RipenInput x0))) :ruleset Spine-Export)
(rule ((= s (Spine-RipenInput x0)) (= previous (Spine-Reified-Term s))) ((union previous (RipenInput x0))) :ruleset Spine-Export)
(relation Spine-Summary-0 (Spine-Term Spine-Term Spine-Term))
(relation Spine-Summary-1 (Spine-Term Spine-Term Spine-Term Spine-Term Spine-Term Spine-Term))
; exact Cell 0: observed path 0 -> selected path 1
(rule ((= match_0 (Spine-A p0 p1))) ((Spine-A p0 p1) (Spine-Summary-0 (Spine-A p0 p1) p0 p1)) :ruleset Spine-Run :name "impl_0_1")
; exact Cell 1: observed path 2 -> selected path 2
(rule ((Spine-Summary-0 parent_0_root_0 p0 p1) (Spine-Summary-0 parent_1_root_0 p1 p2) (= match_2 (Spine-Gate p0 p2))) ((Spine-Gate p0 p2) (Spine-Summary-1 parent_0_root_0 parent_1_root_0 (Spine-Gate p0 p2) p0 p1 p2)) :ruleset Spine-Run :name "impl_2_1")
(rule ((Spine-Summary-0 export_root_0 p0 p1) (= export_input_0 (Spine-Reified-Term p0)) (= export_input_1 (Spine-Reified-Term p1))) ((let export_class_2 (A export_input_0 export_input_1)) (union export_class_2 (AA export_input_0 export_input_1)) (set (Spine-Reified-Term export_root_0) export_class_2)) :ruleset Spine-Export)
(rule ((Spine-Summary-1 export_root_0 export_root_1 export_root_2 p0 p1 p2) (= export_input_0 (Spine-Reified-Term p0)) (= export_input_1 (Spine-Reified-Term p1)) (= export_input_2 (Spine-Reified-Term p2))) ((let export_class_2 (A export_input_0 export_input_1)) (let export_class_4 (A export_input_1 export_input_2)) (union export_class_2 (AA export_input_0 export_input_1)) (union export_class_4 (AA export_input_1 export_input_2)) (let export_class_5 (Gate export_input_0 export_input_2)) (let export_class_6 (Joined export_input_0 export_input_2)) (set (Spine-Reified-Term export_root_0) export_class_2) (set (Spine-Reified-Term export_root_1) export_class_4) (set (Spine-Reified-Term export_root_2) export_class_5)) :ruleset Spine-Export)

; Automatic constructor-level ingress; no scan of a materialized original graph.
(Spine-A (Spine-Leaf "a") (Spine-Leaf "b"))
(Spine-A (Spine-Leaf "b") (Spine-Leaf "c"))
(Spine-Gate (Spine-Leaf "a") (Spine-Leaf "c"))
(run-schedule (saturate Spine-Run))
(run-schedule (saturate Spine-Export))
(check (Joined (Leaf "a") (Leaf "c")))
