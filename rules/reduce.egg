; Exact scalar endpoint algebra (characteristic zero); not floating-point algebra.
; ECount denotes a nonnegative integer parameter. ESymbol has no such assumption.
(sort EndpointExpr)
(sort Accumulation)
(constructor EInt (i64) EndpointExpr :cost 1)
(constructor ESymbol (String) EndpointExpr :cost 1)
(constructor ECount (String) EndpointExpr :cost 1)
(constructor ECall (String EndpointExpr) EndpointExpr :cost 1)
(constructor EAdd (EndpointExpr EndpointExpr) EndpointExpr :cost 1)
(constructor ESub (EndpointExpr EndpointExpr) EndpointExpr :cost 1)
(constructor EMul (EndpointExpr EndpointExpr) EndpointExpr :cost 1)
(constructor EDiv (EndpointExpr EndpointExpr) EndpointExpr :cost 2)
(constructor EPow (EndpointExpr EndpointExpr) EndpointExpr :cost 2)
; These summaries assert the per-step update, including its index dependence.
(constructor AddConstant (EndpointExpr) Accumulation :cost 1)
(constructor AddArithmetic (EndpointExpr EndpointExpr) Accumulation :cost 1)
(constructor MultiplyConstant (EndpointExpr) Accumulation :cost 1)
(constructor OpaqueFold (String) Accumulation :cost 1)
; Reduce(fold, count, terminal) is explicitly retained in the egraph.
(constructor Reduce (Accumulation EndpointExpr EndpointExpr) EndpointExpr :cost 100)
(relation NaturalCount (EndpointExpr))
(ruleset endpoint-reduce)
(rule ((= k (ECount name))) ((NaturalCount k)) :ruleset endpoint-reduce)
(rule ((= k (EInt n)) (>= n 0)) ((NaturalCount k)) :ruleset endpoint-reduce)
(rewrite (Reduce fold (EInt 0) terminal) terminal :ruleset endpoint-reduce)
(rewrite (Reduce (AddConstant c) k terminal)
 (EAdd terminal (EMul k c)) :when ((NaturalCount k)) :ruleset endpoint-reduce)
; Contributions are first + i*step for i=0,...,k-1.
(rewrite (Reduce (AddArithmetic first step) k terminal)
 (EAdd terminal
  (EAdd (EMul k first)
   (EDiv (EMul (EMul k (ESub k (EInt 1))) step) (EInt 2))))
 :when ((NaturalCount k)) :ruleset endpoint-reduce)
(rewrite (Reduce (MultiplyConstant c) k terminal)
 (EMul terminal (EPow c k)) :when ((NaturalCount k)) :ruleset endpoint-reduce)
(rewrite (EAdd x (EInt 0)) x :ruleset endpoint-reduce)
(rewrite (EAdd (EInt 0) x) x :ruleset endpoint-reduce)
(rewrite (ESub x (EInt 0)) x :ruleset endpoint-reduce)
(rewrite (EMul x (EInt 1)) x :ruleset endpoint-reduce)
(rewrite (EMul (EInt 1) x) x :ruleset endpoint-reduce)
(rewrite (EMul x (EInt 0)) (EInt 0) :ruleset endpoint-reduce)
(rewrite (EMul (EInt 0) x) (EInt 0) :ruleset endpoint-reduce)
(rewrite (EPow x (EInt 0)) (EInt 1) :ruleset endpoint-reduce)
(rewrite (EPow x (EInt 1)) x :ruleset endpoint-reduce)

(include "rules/binding_reduce.egg")
