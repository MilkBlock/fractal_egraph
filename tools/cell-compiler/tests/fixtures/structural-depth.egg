(datatype E (Seed i64) (Inner E) (Link E) (Head E) (Tail E) (Seen E))
(ruleset first) (ruleset second) (ruleset third) (ruleset consume)
(rule ((= x (Seed i))) ((Inner x) (Link x)) :ruleset first)
(rule ((= y (Link x))) ((Head x)) :ruleset second)
(rule ((= h (Head x))) ((Tail x)) :ruleset third)
(rule ((= t (Tail x))) ((Inner x)) :ruleset consume)
(rule ((= t (Tail x)) (= i (Inner x))) ((Seen i)) :ruleset consume)
(Seed 1) (Seed 2)
(run-schedule (seq (run first) (run second) (run third) (run consume)))
(check (= s (Seen (Inner (Seed 1)))))
