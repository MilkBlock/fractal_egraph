; @egg-viz-json {"schema": "egg-viz/v1", "kind": "dsl_type", "id": "Math", "variants": {"Diff": {"fields": ["variable", "expression"], "typst": "{expression}'({variable})", "precedence": 90}, "Integral": {"fields": ["integrand", "variable"], "typst": "integral {integrand} quad d {variable}", "precedence": 90}, "Add": {"fields": ["left", "right"], "typst": "{left} + {right}", "precedence": 50}, "Sub": {"fields": ["left", "right"], "typst": "{left} - {right}", "precedence": 50}, "Mul": {"fields": ["left", "right"], "typst": "{left} * {right}", "precedence": 60}, "Div": {"fields": ["left", "right"], "typst": "frac({left}, {right})", "precedence": 60}, "Pow": {"fields": ["base", "exponent"], "typst": "{base}^{exponent}", "precedence": 80}, "Ln": {"fields": ["value"], "typst": "ln {value}", "precedence": 90}, "Sqrt": {"fields": ["value"], "typst": "sqrt({value})", "precedence": 90}, "Sin": {"fields": ["value"], "typst": "sin({value})", "precedence": 90}, "Cos": {"fields": ["value"], "typst": "cos({value})", "precedence": 90}, "Const": {"fields": ["value"], "typst": "{value}", "precedence": 100}, "Var": {"fields": ["name"], "typst": "{name}", "precedence": 100}}}
(datatype Math
    (Diff Math Math)
    (Integral Math Math)

    (Add Math Math)
    (Sub Math Math)
    (Mul Math Math)
    (Div Math Math)
    (Pow Math Math)
    (Ln Math)
    (Sqrt Math)

    (Sin Math)
    (Cos Math)

    (Const i64)
    (Var String))
(rewrite (Integral (Mul a b) x)
(Sub (Mul a (Integral b x))
    (Integral (Mul (Diff x a) (Integral b x)) x)))
;; A lane of the `math` example, trimmed to what the lane needs: the integration by
;; parts rewrite re-applies to the term it produced, and every state after the first
;; reads only from the previous one. `(run 4)` is enough; the full example runs to
;; saturation and streams hundreds of MB, which the page cannot list.

(Integral (Mul (Var "x") (Cos (Var "x"))) (Var "x"))
(Integral (Ln (Var "x")) (Var "x"))
(Add (Mul (Var "y") (Add (Var "x") (Var "y"))) (Sub (Add (Var "x") (Const 2)) (Add (Var "x") (Var "x"))))
(run 4)
