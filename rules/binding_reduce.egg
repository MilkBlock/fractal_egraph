; A pure, multi-output binding DAG. Effects are represented, never executed.
; Parameters are local to a DAG; environments substitute them without unioning them.
(datatype BindingValues (BNil) (BCons EndpointExpr BindingValues))
(constructor EParam (i64) EndpointExpr)
(constructor ERecur (i64 BindingValues) EndpointExpr)
(constructor EApply (String BindingValues) EndpointExpr)
(datatype*
 (BindingExpr
 (BParam i64) (BInt i64)
 (BAdd BindingExpr BindingExpr) (BSub BindingExpr BindingExpr)
 (BMul BindingExpr BindingExpr) (BDiv BindingExpr BindingExpr)
 (BPow BindingExpr BindingExpr)
 (BApply String BindingExprs) (BRecur i64 BindingExprs))
(BindingExprs (BXNil) (BXCons BindingExpr BindingExprs)))
(datatype BindingDag (BDag BindingExprs BindingExprs) (BLet BindingExpr BindingDag))
(sort BindingResult)
(constructor BResult (BindingValues BindingValues) BindingResult :cost 1)
(constructor ReduceDag (BindingDag BindingValues) BindingResult :cost 100)
(constructor Substitute (BindingExpr BindingValues) EndpointExpr :cost 100)
(constructor SubstituteValues (BindingExprs BindingValues) BindingValues :cost 100)
(constructor ParameterAt (i64 BindingValues) EndpointExpr :cost 100)
(rewrite (ParameterAt 0 (BCons x xs)) x :ruleset endpoint-reduce)
(rewrite (ParameterAt i (BCons x xs)) (ParameterAt (- i 1) xs)
 :when ((> i 0)) :ruleset endpoint-reduce)
(rewrite (ReduceDag (BDag outputs effects) env)
 (BResult (SubstituteValues outputs env) (SubstituteValues effects env))
 :ruleset endpoint-reduce)
(rewrite (SubstituteValues (BXNil) env) (BNil) :ruleset endpoint-reduce)
(rewrite (SubstituteValues (BXCons x xs) env)
 (BCons (Substitute x env) (SubstituteValues xs env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BParam i) env) (ParameterAt i env) :ruleset endpoint-reduce)
(rewrite (Substitute (BInt n) env) (EInt n) :ruleset endpoint-reduce)
(rewrite (Substitute (BApply f xs) env) (EApply f (SubstituteValues xs env)) :ruleset endpoint-reduce)
; A recursion boundary stays symbolic. No unobserved recursive calls are minted.
(rewrite (Substitute (BRecur site xs) env) (ERecur site (SubstituteValues xs env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BAdd a b) env) (EAdd (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BSub a b) env) (ESub (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BMul a b) env) (EMul (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BDiv a b) env) (EDiv (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)
(rewrite (Substitute (BPow a b) env) (EPow (Substitute a env) (Substitute b env)) :ruleset endpoint-reduce)

; Extend a persistent environment: repeated uses refer to one computed value.
(rewrite (ReduceDag (BLet value rest) env)
 (ReduceDag rest (BCons (Substitute value env) env)) :ruleset endpoint-reduce)
