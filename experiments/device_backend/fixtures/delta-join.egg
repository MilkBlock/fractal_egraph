(relation P (i64 i64))
(relation Q (i64 i64))
(function C (i64 i64) i64 :merge (+ old new))
(function D (i64 i64) i64 :merge (+ old new))
(ruleset join)
(ruleset seed)
(P 1 2)
(P 2 2)
(Q 2 3)
(rule ((P x y) (Q y z)) ((set (C x z) 1)) :ruleset join)
(rule ((P x y) (P y z)) ((set (D x z) 1)) :ruleset join)
(rule () ((P 4 2) (Q 2 5)) :ruleset seed)
(run join 1)
(run seed 1)
(run join 1)
(run join 1)
(check (= (C 1 3) 1))
(check (= (C 1 5) 1))
(check (= (C 4 3) 1))
(check (= (C 4 5) 1))
(check (= (D 2 2) 1))
