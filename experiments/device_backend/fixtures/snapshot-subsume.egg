(datatype T (N i64) (W T))
(relation Tail (T))
(ruleset r)
(ruleset once)
(N 0) (N 1) (N 2)
; Run 1: W(0) is predicted visible; W(1) is predicted hidden. Both tails stop.
; Run 2: both rows are in the committed snapshot, so subsume and Tail proceed.
(rule ((= x (N 0))) ((W x) (subsume (W x)) (Tail x)) :ruleset r :naive)
(rule ((= x (N 1))) ((subsume (W x)) (Tail x)) :ruleset r :naive)
(rule ((= x (N 2))) ((subsume (W x)) (panic "masked RHS tail executed")) :ruleset once)
(run r 1)
(run r 1)
(run r 1)
(run once 1)
(check (Tail (N 0)))
(check (Tail (N 1)))
