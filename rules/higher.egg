; Finite macro views of existing tier-1 combinations. Effects remain in Extension.
; R is an Extension: source rule + stable relative-binding update + source effects.
; ctx retains coarse injection and warmup; neither is counted in the repetition.
; The first step and each extension must be a witnessed unary SmoothComb.
; Finite repetition is evidence, not proof of an arbitrary-count invariant.
; Depth is exact uniform observed expansion; sparse extents keep partial ports.
(sort ExpansionExtent)
(sort ExpansionNodes)
(sort ExpansionEdges)
(constructor Depth (i64) ExpansionExtent)
(constructor SparseExtent (ExpansionNodes) ExpansionExtent)
(constructor NoExpansionNodes () ExpansionNodes)
(constructor ExpansionNode (i64 ExpansionEdges ExpansionNodes) ExpansionNodes)
(constructor NoExpansionEdges () ExpansionEdges)
(constructor ExpandTo (i64 i64 ExpansionEdges) ExpansionEdges)
(constructor OpenPort (i64 ExpansionEdges) ExpansionEdges)
(constructor ReturnFrontier (i64 ExpansionEdges) ExpansionEdges)
(constructor BoundaryPort (i64 ExpansionEdges) ExpansionEdges)
(constructor FractalComb (ExpansionExtent Extension Comb RelativeBinding) Comb)
(relation UnaryStep (Comb Comb Extension RelativeBinding))
(relation PowerPrefix (Comb Comb Extension RelativeBinding i64))
(relation Represents (Comb Comb))
(relation CombName (Comb String))
(relation ExtensionName (Extension String))
(ruleset higher)
(rule ((UnaryStep ctx out r binding) (= out (SmoothComb (MoreParents ctx (NoParents)) rule binding)))
      ((PowerPrefix ctx out r binding 1)) :ruleset higher :name "power-start")
(rule ((PowerPrefix ctx mid r binding k) (UnaryStep mid out r next_binding) (= out (SmoothComb (MoreParents mid (NoParents)) rule next_binding)))
      ((PowerPrefix ctx out r binding (+ k 1))) :ruleset higher :name "power-extend")
(rule ((PowerPrefix ctx out r binding k) (>= k 2))
      ((Represents (FractalComb (Depth k) r ctx binding) out)) :ruleset higher :name "power-view")
; No unrestricted unfolding or effect-equivalence unions: all prefixes must exist.

; A caller must supply a valid accumulator summary and final terminal.
; This relation does not infer a polynomial summary for arbitrary R23 effects.
(relation ReductionInput (Comb Accumulation EndpointExpr))
(relation EndpointView (Comb EndpointExpr))
(rule ((ReductionInput (FractalComb (Depth k) r ctx binding) fold terminal) (= r (Extend name routes schema)) (>= k 0))
 ((EndpointView (FractalComb (Depth k) r ctx binding) (Reduce fold (EInt k) terminal)))
 :ruleset higher :name "higher-endpoint-reduce")

; RecursivePattern folds need a branch-aware summary; do not treat depth as total applications.

; Branch-aware caller-supplied interface; extent is not an application count.
; A callee may have multiple witnessed contracts; no universal unfolding is asserted.
(relation ObservedCalleeLayer (String Comb BindingDag))
(relation LayerReductionInput (Comb BindingDag BindingValues))
(relation LayerEndpointView (Comb BindingResult))
(rule ((LayerReductionInput f dag env)
       (= f (FractalComb extent r ctx binding)))
 ((LayerEndpointView f (ReduceDag dag env)))
 :ruleset higher :name "fractal-dag-reduce")

; Explicit endpoint contracts supplied by Bake/user proofs. No array is inferred
; merely from an observed apply count, and no original effects are removed.
(relation ArrayReductionSummary (Comb Reduction Array))
(relation ArrayFoldSummary (Comb FoldFunction EndpointExpr Array))
(rule ((ArrayReductionSummary f r a) (= f (FractalComb extent op ctx binding))
       (ArrayDomain a (FiniteDomain n)))
 ((EndpointView f (ReduceArray r a))) :ruleset higher)
(rule ((ArrayFoldSummary f step initial a) (= f (FractalComb extent op ctx binding))
       (ArrayDomain a (FiniteDomain n)))
 ((EndpointView f (FoldArray step initial a))) :ruleset higher)
