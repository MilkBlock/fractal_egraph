; Structural views, never effect-equivalence unions or invented applications.
(relation OriginalComb (Comb))
(relation CombMeaning (Comb Comb))
(relation ParentMeaning (ParentCombs ParentCombs))
(relation SelectedView (Instance Comb))
(relation VerifiedView (Instance Comb))
(relation ObservedStep (Instance Instance Extension RelativeBinding))
(relation FractalWalk (Instance Comb i64 Instance))
(relation FractalOccurrence (Instance Comb Instance i64))
(relation FractalOutput (Instance Comb i64 i64 Val))
(relation FractalEffect (Instance Comb i64 Effect))
(relation FractalRequirement (Instance Comb i64 Effects))
(relation FractalProvides (Instance Comb Effect))
(relation FractalParent (Instance i64 Instance Comb))
(ruleset fractal-views)
(rule ((OriginalComb c)) ((CombMeaning c c)) :ruleset fractal-views)
(rule ((= p (NoParents))) ((ParentMeaning p p)) :ruleset fractal-views)
(rule ((= v (MoreParents a at)) (= o (MoreParents b bt)) (CombMeaning a b) (ParentMeaning at bt)) ((ParentMeaning v o)) :ruleset fractal-views)
(rule ((= v (SmoothRuleComposition vp r b)) (= o (SmoothRuleComposition op r b)) (ParentMeaning vp op)) ((CombMeaning v o)) :ruleset fractal-views)
(rule ((= v (CoarseRuleComposition vp r b)) (= o (CoarseRuleComposition op r b)) (ParentMeaning vp op)) ((CombMeaning v o)) :ruleset fractal-views)
(rule ((= f (FractalComb (Depth k) r vc b)) (CombMeaning vc oc) (PowerPrefix oc out r b k) (>= k 2)) ((CombMeaning f out)) :ruleset fractal-views)
(rule ((SelectedView i v) (= i (Occurrence id o)) (CombMeaning v o)) ((VerifiedView i v)) :ruleset fractal-views)
; Demand only selected segments. Walk actual instance edges, not shared templates.
(rule ((VerifiedView i f) (= f (FractalComb (Depth k) r c b)) (>= k 2)) ((FractalWalk i f k i)) :ruleset fractal-views)
(rule ((FractalWalk end f j current) (= f (FractalComb (Depth k) r c b)) (> j 0)
       (ObservedStep prev current r step_binding) (= prev (Occurrence pid pc)) (= current (Occurrence cid cc))
       (UnaryStep pc cc r step_binding) (= cc (SmoothRuleComposition (MoreParents pc (NoParents)) rule step_binding)))
      ((FractalWalk end f (- j 1) prev)) :ruleset fractal-views)
(rule ((FractalWalk end f 0 start) (= start (Occurrence id original)) (= f (FractalComb (Depth k) r ctx b)) (CombMeaning ctx original))
      ((FractalOccurrence end f start k)) :ruleset fractal-views)
(rule ((FractalOccurrence end f start k) (FractalWalk end f j member) (> j 0) (OutputAt member port value))
      ((FractalOutput end f j port value)) :ruleset fractal-views)
(rule ((FractalOccurrence end f start k) (FractalWalk end f j member) (> j 0) (Produced member effect))
      ((FractalEffect end f j effect)) :ruleset fractal-views)
(rule ((FractalOccurrence end f start k) (FractalWalk end f j member) (> j 0) (Requires member effects))
      ((FractalRequirement end f j effects)) :ruleset fractal-views)
(rule ((FractalOccurrence end f start k) (Provides end effect)) ((FractalProvides end f effect)) :ruleset fractal-views)
(rule ((ParentAt child port parent) (FractalOccurrence parent f start k)) ((FractalParent child port parent f)) :ruleset fractal-views)
; A consumer may use an interior member, not only the segment endpoint.
(relation FractalInputAddress (Instance i64 Instance Comb i64))
(rule ((ParentAt child slot member) (FractalOccurrence end f start k) (FractalWalk end f j member) (> j 0))
      ((FractalInputAddress child slot end f j)) :ruleset fractal-views)
