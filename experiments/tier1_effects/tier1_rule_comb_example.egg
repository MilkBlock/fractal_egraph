(include "research/legacy_tier1.egg")
; A shared R10 -> R15 template. R15 receives x,s from R10, root d externally.
(let $r10 (CoarseRuleComposition (MoreParents (Empty) (NoParents)) (Rule "R10") (PCons (External 0 "Math") (PCons (External 1 "Math") (PCons (External 2 "Math") (PNil))))))
(let $parents (MoreParents $r10 (NoParents)))
(let $rho (PCons (Local (ParentPort 0 0 "Math"))
            (PCons (Local (ParentPort 0 1 "Math"))
              (PCons (External 0 "Math") (PNil)))))
(let $comb (CoarseRuleComposition $parents (Rule "R15") $rho))
; Reconstructing the same template hashconses despite different occurrences.
(let $same (CoarseRuleComposition (MoreParents (CoarseRuleComposition (MoreParents (Empty) (NoParents)) (Rule "R10") (PCons (External 0 "Math") (PCons (External 1 "Math") (PCons (External 2 "Math") (PNil))))) (NoParents)) (Rule "R15") $rho))
(check (= $comb $same))
(let $r10a (Occurrence 10 $r10))
(let $r10b (Occurrence 20 $r10))
(let $a (Occurrence 11 $comb))
(let $b (Occurrence 21 $same))
(ExternalAt $r10a 0 (V "Math" "x"))
(ExternalAt $r10a 1 (V "Math" "2"))
(ExternalAt $r10a 2 (V "Math" "3"))
(ExternalAt $r10b 0 (V "Math" "y"))
(ExternalAt $r10b 1 (V "Math" "4"))
(ExternalAt $r10b 2 (V "Math" "5"))
(ParentAt $a 0 $r10a)
(ParentAt $b 0 $r10b)
(OutputAt $r10a 0 (V "Math" "x"))
(OutputAt $r10a 1 (V "Math" "2+3"))
(OutputAt $r10b 0 (V "Math" "y"))
(OutputAt $r10b 1 (V "Math" "4+5"))
(ExternalAt $a 0 (V "Math" "dx"))
(ExternalAt $b 0 (V "Math" "dy"))

; Instance a: actual fact/equality support stays on the occurrence.
(let $a_mul (HasFact "Mul" (ACons (V "Math" "x") (ACons (V "Math" "2+3") (ACons (V "Math" "product-x") (ANil))))))
(let $a_diff (HasFact "Diff" (ACons (V "Math" "x") (ACons (V "Math" "sum-x") (ACons (V "Math" "dx") (ANil))))))
(let $a_wanted (HasFact "Diff" (ACons (V "Math" "x") (ACons (V "Math" "product-x") (ACons (V "Math" "dx") (ANil))))))
(Produced $r10a $a_mul)
(Produced $r10a (Equal (V "Math" "sum-x") (V "Math" "product-x")))
(ExternalFact $a $a_diff)
(Requires $a (ECons $a_mul (ECons $a_wanted (ENil))))

; Instance b: actual fact/equality support stays on the occurrence.
(let $b_mul (HasFact "Mul" (ACons (V "Math" "y") (ACons (V "Math" "4+5") (ACons (V "Math" "product-y") (ANil))))))
(let $b_diff (HasFact "Diff" (ACons (V "Math" "y") (ACons (V "Math" "sum-y") (ACons (V "Math" "dy") (ANil))))))
(let $b_wanted (HasFact "Diff" (ACons (V "Math" "y") (ACons (V "Math" "product-y") (ACons (V "Math" "dy") (ANil))))))
(Produced $r10b $b_mul)
(Produced $r10b (Equal (V "Math" "sum-y") (V "Math" "product-y")))
(ExternalFact $b $b_diff)
(Requires $b (ECons $b_mul (ECons $b_wanted (ENil))))

(run-schedule (saturate (run tier1)))
(check (Binding $a (ACons (V "Math" "x") (ACons (V "Math" "2+3") (ACons (V "Math" "dx") (ANil))))))
(check (Binding $b (ACons (V "Math" "y") (ACons (V "Math" "4+5") (ACons (V "Math" "dy") (ANil))))))
(check (SupportsUse $a $a))
(check (SupportsUse $b $b))
; Template sharing cannot pool the evidence from these two occurrences.
(fail (check (Provides $a $b_diff)))
(fail (check (Provides $b $a_diff)))
(fail (check (EqAt $b (V "Math" "sum-x") (V "Math" "product-x"))))
