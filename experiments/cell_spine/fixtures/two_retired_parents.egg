(datatype Term (Leaf String) (A Term) (AA Term) (P Term) (PP Term) (Gate Term Term) (Large Term) (Joined Term Term))
(ruleset demo)
(rewrite (A x) (AA x) :ruleset demo)
(rewrite (P x) (PP x) :ruleset demo)
(rule ((AA x) (PP x)) ((Large x)) :ruleset demo)
(rule ((AA x) (AA y) (Gate x y)) ((Joined x y)) :ruleset demo)
(A (Leaf "x")) (A (Leaf "y"))
(P (Leaf "x")) (P (Leaf "y"))
(Gate (Leaf "x") (Leaf "y"))
(run-schedule (saturate demo))
(check (Joined (Leaf "x") (Leaf "y")))
