; Standard commutativity + associativity, with four distinct leaves.
(datatype Term (Leaf String) (Add Term Term))
(ruleset algebra)
(rewrite (Add a b) (Add b a) :ruleset algebra)
(rewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset algebra)
(let left (Add (Leaf "a") (Leaf "b")))
(let right (Add (Leaf "c") (Leaf "d")))
(let root (Add left right))
(run-schedule (saturate algebra))
(check (= root (Add (Leaf "a") (Add (Leaf "b") (Add (Leaf "c") (Leaf "d"))))))
