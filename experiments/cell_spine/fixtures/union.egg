(datatype Node (V i64) (Left Node) (Right Node) (Pair Node Node))
(ruleset one)
(rewrite (Left x) (Right x) :ruleset one)
(rewrite (Right x) (Left x) :ruleset one)
(rewrite (Pair (Left x) (Right x)) (Pair x x) :ruleset one)
(let a (V 1))
(let b (V 2))
(let root (Pair (Left a) (Right b)))
(union a b)
(run-schedule (saturate one))
(check (= root (Pair a a)))
