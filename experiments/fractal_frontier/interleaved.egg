(datatype Token (V i64))
(relation At (i64))
(relation Next (i64 i64))
(relation Permit (i64))
(relation Gate (i64 Token))
(relation Have (Token))
(relation Tick (i64))
(ruleset grow)
(ruleset coarse)
(ruleset unlock)
(ruleset noise)
(rule ((At n) (Next n m) (Permit n) (Gate n g) (Have g)) ((At m)) :ruleset grow :name "advance")
(rule ((At 2)) ((Permit 2)) :ruleset coarse :name "inject-permit")
(rule ((At 4)) ((union (V 4) (V 99))) :ruleset unlock :name "inject-equality")
(rule ((Tick n) (Next n m)) ((Tick m)) :ruleset noise :name "unrelated")
(At 0) (Tick 0)
(Next 0 1) (Next 1 2) (Next 2 3) (Next 3 4)
(Next 4 5) (Next 5 6) (Next 6 7) (Next 7 8)
(Permit 0) (Permit 1) (Permit 3) (Permit 4) (Permit 5) (Permit 6) (Permit 7)
(Gate 0 (V 99)) (Gate 1 (V 99)) (Gate 2 (V 99)) (Gate 3 (V 99))
(Gate 4 (V 4)) (Gate 5 (V 99)) (Gate 6 (V 99)) (Gate 7 (V 99))
(Have (V 99))
